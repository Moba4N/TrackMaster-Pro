<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>TrackMaster.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Lang.en.json" LogicalName="TrackMaster.Core.Lang.en.json" WithCulture="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- Gleisdaten: eigene Datei unter GPL, wird nur gelesen (siehe gleisdaten/LIESMICH.txt) -->
    <Content Include="..\..\gleisdaten\*.*" Link="Gleisdaten\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
