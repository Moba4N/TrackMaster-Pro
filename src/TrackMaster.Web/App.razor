    // ---------- Einfache Dialoge ----------

    private RenderFragment MessageBody(string text) => @<p class="message">@text</p>;

    private RenderFragment Hint(string text) => @<div class="tip-box">@text</div>;

    private void AskText(string title, string label, string value, Action<string> apply)
    {
        _d.Clear();
        _d["text"] = value;
        var d = Show(title, @<div class="form">
            <label class="field-label" for="dlg-text">@label</label>
            <input id="dlg-text" class="input" @bind='_d["text"]' @bind:event="oninput" @onkeydown="@(e => { if (e.Key == "Enter") ConfirmText(apply); })" />
        </div>, keepFields: true);
        d.Buttons.Add(new(Lang.T("Abbrechen"), () => true));
        d.Buttons.Add(new(Lang.T("Übernehmen"), () => ConfirmText(apply, close: false), true));
        _ = FocusLater("dlg-text");
    }

    private bool ConfirmText(Action<string> apply, bool close = true)
    {
        var text = D("text").Trim();
        if (text.Length == 0) return false;
        apply(text);
        if (close) CloseDialog();
        return true;
    }

    private async Task FocusLater(string id)
    {
        await Task.Delay(30);
        Interop.Js.Focus(id);
    }

    private void AskAngle(string title, string hint, double value, string action, Action<double> apply)
    {
        _d.Clear();
        _d["angle"] = N(value, 1);
        var d = Show(title, @<div class="form">
            @Hint(hint)
            <label class="field-label" for="dlg-angle">@Lang.T("Winkel (°, positiv = im Uhrzeigersinn)")</label>
            <input id="dlg-angle" class="input" inputmode="decimal" @bind='_d["angle"]' @bind:event="oninput" />
            <div class="button-row equal">
                @foreach (var a in new[] { -90, -45, -15, 15, 45, 90 })
                {
                    var angle = a;
                    <button class="btn" @onclick="@(() => _d["angle"] = N(angle, 1))">@($"{(angle > 0 ? "+" : "")}{angle}°")</button>
                }
            </div>
        </div>, keepFields: true);
        d.Buttons.Add(new(Lang.T("Abbrechen"), () => true));
        d.Buttons.Add(new(action, () =>
        {
            var errors = new List<string>();
            Read("angle", Lang.T("Winkel"), -360, 360, errors, out var v);
            if (!Fail(errors)) return false;
            apply(v);
            return true;
        }, true));
    }

    // ---------- Neuer Plan ----------

    private static readonly string[] BoardTurns = [Lang.T("Grundstellung"), Lang.T("90° gedreht"), Lang.T("180° gedreht"), Lang.T("270° gedreht")];

    private void AskNewPlan()
    {
        _d.Clear();
        var start = BoardSetup.Default(_session.Plan.GaugeId);
        _d["gauge"] = _session.Plan.GaugeId;
        _d["shape"] = BoardShape.Rechteck.ToString();
        _d["turn"] = "0";
        _d["legL"] = _d["legR"] = "";
        _d["start"] = "direct";
        _d["template"] = BenchTemplate.All[0].Id;
        SuggestBoard();
        var d = Show(Lang.T("Neuer Plan"), NewPlanBody, keepFields: true);
        d.Buttons.Add(new(Lang.T("Abbrechen"), () => true));
        d.Buttons.Add(new(Lang.T("Anlegen"), CreatePlan, true));
    }

    private BoardShape NewShape => Enum.TryParse<BoardShape>(D("shape"), out var s) ? s : BoardShape.Rechteck;

    private void SuggestBoard()
    {
        var s = BoardSetup.Default(D("gauge"), NewShape);
        _d["w"] = N(s.Width);
        _d["h"] = N(s.Height);
        _d["depth"] = N(s.Depth);
    }

    private RenderFragment NewPlanBody => @<div class="form">
        @{
            var shape = NewShape;
            double bw = Fmt.Parse(D("w")) ?? 0, bh = Fmt.Parse(D("h")) ?? 0, bd = Fmt.Parse(D("depth")) ?? 0, l1 = Fmt.Parse(D("legL")) ?? 0, l2 = Fmt.Parse(D("legR")) ?? 0;
            var t = int.TryParse(D("turn"), out var tt) ? tt : 0;
            var valid = bw >= 50 && bh >= 50;
        }
        @Hint(Lang.T("Der aktuelle Plan wird verworfen; Rückgängig holt ihn zurück. Form und Maße lassen sich später in den Eigenschaften des Plans ändern."))
        <div class="cols">
            <div>
                <label class="field-label">@Lang.T("Spur")</label>
                <select class="input" value="@D("gauge")" @onchange="@(e => { _d["gauge"] = e.Value?.ToString() ?? D("gauge"); SuggestBoard(); })">
                    @foreach (var g in Catalog.Gauges)
                    {
                        <option value="@g.Id">@Lang.F($"Spur {g.Id} ({g.Scale})")</option>
                    }
                </select>
            </div>
            <div>
                <label class="field-label">@Lang.T("Form der Anlagenplatte")</label>
                <select class="input" value="@D("shape")" @onchange="@(e => { _d["shape"] = e.Value?.ToString() ?? D("shape"); SuggestBoard(); })">
                    @foreach (var s in BoardGeometry.All)
                    {
                        <option value="@s.ToString()">@BoardGeometry.Name(s)</option>
                    }
                </select>
            </div>
        </div>
        <div class="board-preview">
            @if (valid)
            {
                @((MarkupString)Pictures.Board(BoardGeometry.Outlines(shape, bw, bh, bd, t, l1, l2), 320, 150))
            }
        </div>
        @if (shape == BoardShape.Module)
        {
            @Hint(Lang.T("Modulanlage: Breite und Tiefe gelten für das erste Modul. Weitere Module hängst du unter Gelände › Module… an, dort lassen sich auch gespeicherte Pläne als Modul ansetzen."))
        }
        <div class="cols">
            <div><label class="field-label">@(shape == BoardShape.Module ? Lang.T("Modulbreite (mm)") : Lang.T("Breite außen (mm)"))</label><input class="input" inputmode="decimal" @bind='_d["w"]' @bind:event="oninput" /></div>
            <div><label class="field-label">@(shape == BoardShape.Module ? Lang.T("Modultiefe (mm)") : Lang.T("Tiefe außen (mm)"))</label><input class="input" inputmode="decimal" @bind='_d["h"]' @bind:event="oninput" /></div>
        </div>
        @if (BoardGeometry.HasLegs(shape))
        {
            <div class="cols">
                <div><label class="field-label">@Lang.T("Schenkeltiefe (mm)")</label><input class="input" inputmode="decimal" @bind='_d["depth"]' @bind:event="oninput" /></div>
                <div>
                    <label class="field-label">@Lang.T("Ausrichtung")</label>
                    <select class="input" @bind='_d["turn"]'>
                        @for (var i = 0; i < BoardTurns.Length; i++)
                        {
                            <option value="@i">@BoardTurns[i]</option>
                        }
                    </select>
                </div>
            </div>
        }
        @if (shape == BoardShape.U)
        {
            <div class="cols">
                <div><label class="field-label">@Lang.T("Linker Schenkel lang (mm)")</label><input class="input" inputmode="decimal" placeholder="@Lang.T("ganz")" @bind='_d["legL"]' @bind:event="oninput" /></div>
                <div><label class="field-label">@Lang.T("Rechter Schenkel lang (mm)")</label><input class="input" inputmode="decimal" placeholder="@Lang.T("ganz")" @bind='_d["legR"]' @bind:event="oninput" /></div>
            </div>
        }
        <label class="field-label">@Lang.T("Bauweise")</label>
        <select class="input" value="@D("start")" @onchange="@(e => _d["start"] = e.Value?.ToString() ?? "direct")">
            <option value="direct">@Lang.T("Direkt auf Ebene 1 planen")</option>
            <option value="template">@Lang.T("Rahmenbau mit Vorlage")</option>
            <option value="manual">@Lang.T("Rahmenbau selbst zeichnen")</option>
        </select>
        @if (D("start") == "template")
        {
            <select class="input" value="@D("template")" @onchange="@(e => _d["template"] = e.Value?.ToString() ?? "")">
                @foreach (var bt in BenchTemplate.All)
                {
                    <option value="@bt.Id">@bt.Name</option>
                }
            </select>
            @Hint((BenchTemplate.Find(D("template")) ?? BenchTemplate.All[0]).Description + " " + Lang.T("Alle Maße lassen sich später unter Gelände › Unterbau… ändern."))
        }
        else if (D("start") == "manual")
        {
            @Hint(Lang.T("Rahmen ohne Vorgabe: Zargen, Querriegel, Diagonalen und Streben ziehst du selbst mit Gelände › Leiste ziehen (das Werkzeug ist danach gleich aktiv), danach legt Gelände › Platte auflegen die Deckplatte nach diesen Maßen auf. Gelände › Unterbau… zeigt Zuschnitt und Materialliste."))
        }
        @if (valid)
        {
            var area = BoardGeometry.Rects(shape, bw, bh, bd, t, l1, l2).Sum(r => (r.X1 - r.X0) * (r.Y1 - r.Y0)) / 1e6;
            <div class="secondary">
                @(BoardGeometry.HasLegs(shape)
                    ? Lang.F($"Außenmaße {Fmt.Num(bw, 0)} × {Fmt.Num(bh, 0)} mm · Schenkel {Fmt.Num(BoardGeometry.Depth(shape, bw, bh, bd, t), 0)} mm · Fläche {Fmt.Num(area, 2)} m²")
                    : Lang.F($"{Fmt.Num(bw, 0)} × {Fmt.Num(bh, 0)} mm · Fläche {Fmt.Num(area, 2)} m²"))
            </div>
        }
    </div>;

    private bool CreatePlan()
    {
        var errors = new List<string>();
        Read("w", Lang.T("Breite"), 50, 50000, errors, out var bw);
        Read("h", Lang.T("Tiefe"), 50, 50000, errors, out var bh);
        var shape = NewShape;
        var bd = 600.0;
        if (BoardGeometry.HasLegs(shape)) Read("depth", Lang.T("Schenkeltiefe"), 50, 50000, errors, out bd);
        double l1 = 0, l2 = 0;
        if (shape == BoardShape.U)
        {
            if (D("legL").Trim().Length > 0) Read("legL", Lang.T("Linker Schenkel"), 50, 50000, errors, out l1);
            if (D("legR").Trim().Length > 0) Read("legR", Lang.T("Rechter Schenkel"), 50, 50000, errors, out l2);
        }
        if (!Fail(errors)) return false;
        var t = int.TryParse(D("turn"), out var tt) ? tt : 0;
        var full = t % 2 == 0 ? bh : bw;
        var gauge = Catalog.GetGauge(D("gauge"));
        var bench = D("start") switch
        {
            "template" => (BenchTemplate.Find(D("template")) ?? BenchTemplate.All[0]).Spec(gauge),
            "manual" => BenchTemplate.Manual(gauge),
            _ => null,
        };
        _session.NewPlan(new BoardSetup(D("gauge"), shape, bw, bh, bd, t, l1 >= full ? 0 : l1, l2 >= full ? 0 : l2, bench));
        if (bench is { Manual: true }) _session.Tool = CanvasTool.Beam;
        _view.Fit();
        return true;
    }

