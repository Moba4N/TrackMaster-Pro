    private sealed class HelixForm
    {
        public required Gauge Gauge { get; init; }
        public required IReadOnlyList<TrackPieceDef> Curves { get; init; }
        public required List<TrackPieceDef> Straights { get; init; }
        public required bool FromEnd { get; init; }
        public HelixShape Shape { get; set; } = HelixShape.Rund;
        public bool Two { get; set; }
        public List<TrackPieceDef> Inners { get; set; } = [];
        public List<TrackPieceDef?> Outers { get; set; } = [];
        public int Inner { get; set; }
        public int Outer { get; set; }
        public int Straight { get; set; }
        public bool RightHand { get; set; }
        public HelixConstruction Construction { get; set; }
    }

    private HelixForm? _helix;

    private void AskHelix(Gauge gauge, IReadOnlyList<TrackPieceDef> curves, IReadOnlyList<TrackPieceDef> straights, bool fromEnd, Action<HelixSpec> build)
    {
        _d.Clear();
        var list = straights.OrderBy(x => x.Length).ToList();
        _helix = new HelixForm { Gauge = gauge, Curves = curves, Straights = list, FromEnd = fromEnd };
        _helix.Straight = list.Count == 0 ? 0 : list.IndexOf(list.MinBy(x => Math.Abs(x.Length - gauge.TrackWidth * 11))!);
        _d["count"] = "2";
        _d["spacing"] = N(Helix.DefaultSpacing(gauge));
        _d["turns"] = N(2, 2);
        _d["rise"] = N(gauge.ClearanceHeight + 10);
        _d["edge"] = N(Helix.DefaultEdge(gauge, HelixConstruction.Gewindestangen));
        FillHelixCurves();
        var d = Show(Lang.T("Gleiswendel"), HelixBody, wide: true, keepFields: true);
        d.Buttons.Add(new(Lang.T("Abbrechen"), () => true));
        d.Buttons.Add(new(Lang.T("Bauen"), () =>
        {
            var errors = new List<string>();
            var spec = HelixSpecFromForm(errors);
            if (spec is not null && spec.Rise < gauge.ClearanceHeight)
                errors.Add(Lang.F($"Mit {Fmt.Num(spec.Rise, 0)} mm passt kein Zug unter die nächste Windung (mindestens {Fmt.Num(gauge.ClearanceHeight, 0)} mm)."));
            if (!Fail(errors) || spec is null) return false;
            CloseDialog();
            build(spec);
            return false;
        }, true));
    }

    private TrackPieceDef? HelixInner => _helix is { Inners.Count: > 0 } h ? h.Inners[Math.Clamp(h.Inner, 0, h.Inners.Count - 1)] : null;

    private void FillHelixCurves()
    {
        var h = _helix!;
        var keep = HelixInner?.Key;
        h.Inners = h.Curves.Where(x => Helix.Fits(x, h.Shape)).OrderBy(x => x.Radius).ToList();
        var k = h.Inners.FindIndex(x => x.Key == keep);
        h.Inner = k >= 0 ? k : Math.Max(0, Math.Min(1, h.Inners.Count - 1));
        FillHelixOuter();
    }

    private void FillHelixOuter()
    {
        var h = _helix!;
        h.Outers = [null];
        if (HelixInner is { } inner)
            h.Outers.AddRange(h.Curves.Where(x => x.Radius > inner.Radius && Helix.Fits(x, h.Shape)).OrderBy(x => x.Radius));
        var best = HelixInner is { } i ? Helix.OuterCurve(h.Curves, i, Fmt.Parse(D("spacing")) ?? Helix.DefaultSpacing(h.Gauge), h.Shape) : null;
        h.Outer = best is null ? 0 : Math.Max(0, h.Outers.IndexOf(best));
    }

    private HelixSpec? HelixSpecFromForm(List<string> errors)
    {
        var h = _helix!;
        if (HelixInner is not { } inner) { errors.Add(Lang.T("Dieses Gleissystem hat kein passendes Bogengleis.")); return null; }
        Read("turns", Lang.T("Windungen"), 0.25, 20, errors, out var t);
        Read("rise", Lang.T("Höhe je Windung"), 10, 1000, errors, out var r);
        double n = 0, sp = 0;
        TrackPieceDef? st = null;
        if (h.Shape == HelixShape.Oval)
        {
            if (h.Straights.Count == 0) errors.Add(Lang.T("Dieses Gleissystem hat kein gerades Gleis."));
            else st = h.Straights[Math.Clamp(h.Straight, 0, h.Straights.Count - 1)];
            Read("count", Lang.T("Geraden je Längsseite"), 1, 50, errors, out n);
        }
        var oc = h.Two && h.Outers.Count > 0 ? h.Outers[Math.Clamp(h.Outer, 0, h.Outers.Count - 1)] : null;
        if (h.Two && oc is null) Read("spacing", Lang.T("Gleisabstand"), h.Gauge.TrackWidth * PlanCheck.MinSpacingFactor, h.Gauge.TrackWidth * 20, errors, out sp);
        Read("edge", Lang.T("Randaufmaß"), Helix.MinEdge(h.Gauge, h.Construction), h.Gauge.TrackWidth * 10, errors, out var edge);
        if (errors.Count > 0) return null;
        return new HelixSpec(inner.Key, t, r, h.RightHand, h.Shape, st?.Key, (int)Math.Round(n), h.Two ? 2 : 1, oc is not null ? oc.Radius - inner.Radius : sp, oc?.Key,
            h.Construction, edge);
    }

    private static int Index(ChangeEventArgs e) => int.TryParse(e.Value?.ToString(), out var i) ? i : 0;

    private RenderFragment HelixBody => @<div class="form">
        @{
            var h = _helix!;
            var spec = HelixSpecFromForm([]);
        }
        @Hint((h.FromEnd
            ? Lang.T("Die Wendel beginnt am aktiven Gleisende und steigt gleichmäßig an.")
            : Lang.T("Die Wendel entsteht in der Mitte der Ansicht. Tipp: Vorher ein Gleisende anklicken, dann schließt sie dort an.")) + Lang.T(" Nach dem Bauen folgt die Holzliste."))
        <div class="cols">
            <div>
                <label class="field-label">@Lang.T("Form")</label>
                <select class="input" value="@((int)h.Shape)" @onchange="@(e => { h.Shape = Index(e) == 1 ? HelixShape.Oval : HelixShape.Rund; FillHelixCurves(); })">
                    <option value="0">@Lang.T("Rund")</option>
                    <option value="1">@Lang.T("Oval")</option>
                </select>
            </div>
            <div>
                <label class="field-label">@Lang.T("Gleise")</label>
                <select class="input" value="@(h.Two ? 1 : 0)" @onchange="e => h.Two = Index(e) == 1">
                    <option value="0">@Lang.T("eingleisig")</option>
                    <option value="1">@Lang.T("zweigleisig")</option>
                </select>
            </div>
        </div>
        <label class="field-label">@Lang.T("Bogengleis (innen)")</label>
        <select class="input" value="@h.Inner" @onchange="@(e => { h.Inner = Index(e); FillHelixOuter(); })">
            @for (var i = 0; i < h.Inners.Count; i++)
            {
                var x = h.Inners[i];
                <option value="@i">@($"{x.Number} – R {Fmt.Num(x.Radius)} mm, {Fmt.Num(x.Angle)}°")</option>
            }
        </select>
        @if (h.Shape == HelixShape.Oval)
        {
            <div class="cols">
                <div>
                    <label class="field-label">@Lang.T("Gerade an den Längsseiten")</label>
                    <select class="input" value="@h.Straight" @onchange="e => h.Straight = Index(e)">
                        @for (var i = 0; i < h.Straights.Count; i++)
                        {
                            var x = h.Straights[i];
                            <option value="@i">@($"{x.Number} – {Fmt.Num(x.Length)} mm")</option>
                        }
                    </select>
                </div>
                <div><label class="field-label">@Lang.T("Anzahl je Seite")</label><input class="input" inputmode="numeric" @bind='_d["count"]' @bind:event="oninput" /></div>
            </div>
        }
        @if (h.Two)
        {
            <label class="field-label">@Lang.T("Außengleis")</label>
            <select class="input" value="@h.Outer" @onchange="e => h.Outer = Index(e)">
                @for (var i = 0; i < h.Outers.Count; i++)
                {
                    var x = h.Outers[i];
                    <option value="@i">@(x is null ? Lang.T("Flexgleis mit frei gewähltem Abstand") : Lang.F($"{x.Number} – R {Fmt.Num(x.Radius)} mm (Abstand {Fmt.Num(x.Radius - HelixInner!.Radius)} mm)"))</option>
                }
            </select>
            @if (h.Outer <= 0)
            {
                <label class="field-label">@Lang.T("Gleisabstand bei Flexgleis (mm)")</label>
                <input class="input" inputmode="decimal" @bind='_d["spacing"]' @bind:event="oninput" />
            }
        }
        <div class="cols">
            <div><label class="field-label">@Lang.T("Windungen")</label><input class="input" inputmode="decimal" @bind='_d["turns"]' @bind:event="oninput" /></div>
            <div><label class="field-label">@Lang.T("Höhe je Windung (mm)")</label><input class="input" inputmode="decimal" @bind='_d["rise"]' @bind:event="oninput" /></div>
        </div>
        <label class="field-label">@Lang.T("Richtung")</label>
        <select class="input" value="@(h.RightHand ? 1 : 0)" @onchange="e => h.RightHand = Index(e) == 1">
            <option value="0">@Lang.T("links herum (gegen den Uhrzeigersinn)")</option>
            <option value="1">@Lang.T("rechts herum (im Uhrzeigersinn)")</option>
        </select>
        <div class="section">@Lang.T("Bauweise und Trasse")</div>
        <div class="cols">
            <div>
                <label class="field-label">@Lang.T("Bauweise")</label>
                <select class="input" value="@((int)h.Construction)" @onchange="@(e => { h.Construction = Index(e) == 1 ? HelixConstruction.Spanten : HelixConstruction.Gewindestangen; _d["edge"] = N(Helix.DefaultEdge(h.Gauge, h.Construction)); })">
                    <option value="0">@Lang.T("Gewindestangen")</option>
                    <option value="1">@Lang.T("Spantenbau (geschlitzte Spanten)")</option>
                </select>
            </div>
            <div><label class="field-label">@Lang.T("Randaufmaß je Seite (mm)")</label><input class="input" inputmode="decimal" @bind='_d["edge"]' @bind:event="oninput" /></div>
        </div>
        @if (spec is not null)
        {
            var m = Helix.Material(spec, h.Gauge);
            var free = h.Construction == HelixConstruction.Spanten ? m.Edge - Helix.SlotDepth(h.Gauge) : m.Edge - Helix.RodInset;
            <div class="secondary">@Lang.F($"Trassenbreite {Fmt.Num(m.TrackWidth, 0)} mm = {(spec.Tracks == 2 ? Lang.F($"Gleisabstand {Fmt.Num(spec.OuterRadius - spec.Curve.Radius, 0)} mm + ") : "")}Gleisbett {Fmt.Num(m.TrackBedWidth, 0)} mm + 2 × {Fmt.Num(m.Edge, 0)} mm Rand. Freiraum neben dem Gleisbett {Fmt.Num(free, 0)} mm (empfohlen ab {Fmt.Num(Helix.Clearance(h.Gauge), 0)} mm).")</div>
            <div class="secondary">@Lang.F($"Steigung {Fmt.Num(Helix.GradePercent(spec), 1)} % · Gesamthöhe {Fmt.Num(spec.TotalHeight, 0)} mm · Platzbedarf {Fmt.Num(2 * m.OuterBoardRadius + spec.StraightLength, 0)} × {Fmt.Num(2 * m.OuterBoardRadius, 0)} mm")</div>
        }
    </div>;

    private void ShowHelixMaterial(HelixMaterial m, Action saveCsv)
    {
        var d = Show(Lang.T("Holzliste Gleiswendel"), @<div class="list">
            @foreach (var p in m.Parts)
            {
                <div class="list-item static">
                    <div class="strong">@($"{p.Count} × {p.Name}")</div>
                    @if (p.Size.Length > 0) { <div>@p.Size</div> }
                    @if (p.Note.Length > 0) { <div class="secondary">@p.Note</div> }
                </div>
            }
            @foreach (var n in m.Notes)
            {
                <div class="@(n.StartsWith(Lang.T("Achtung")) ? "danger" : "secondary")">• @n</div>
            }
            @if (m.Ribs is { Count: > 0 } ribs)
            {
                <div class="section">@Lang.T("Aufmaße der Spanten")</div>
                <div class="secondary small">@Lang.F($"Je Stelle ein Spant innen und einer außen, {Fmt.Num(ribs[0].Width, 0)} mm breit, {Fmt.Num(ribs[0].Thickness, 0)} mm stark. Schlitze {Fmt.Num(ribs[0].SlotHeight, 0)} mm hoch und {Fmt.Num(ribs[0].SlotDepth, 0)} mm tief; Maße ab Spantfuß (Unterkante Trasse am Wendelanfang).")</div>
                <table class="table ribs">
                    <tr><th>@Lang.T("Nr.")</th><th>@Lang.T("Lage")</th><th>@Lang.T("Höhe")</th><th>@Lang.T("Schlitz-Unterkanten (mm)")</th></tr>
                    @foreach (var r in ribs)
                    {
                        <tr><td>@r.Number</td><td>@r.Place</td><td>@Fmt.Num(r.Height, 0)</td><td>@r.SlotText</td></tr>
                    }
                </table>
            }
        </div>, wide: true);
        if (m.Cut is { } cut) d.Buttons.Add(new(Lang.T("Zuschnitt als SVG…"), () => { AskHelixCut(cut); return false; }));
        d.Buttons.Add(new(Lang.T("Als CSV speichern"), () => { saveCsv(); return false; }));
        d.Buttons.Add(new(Lang.T("Schließen"), () => true, true));
    }

    /// <summary>Maße der Trassenteile vor dem Export als SVG anpassen.</summary>
    private void AskHelixCut(HelixCut cut)
    {
        _d["ri"] = N(cut.InnerRadius, 1); _d["ro"] = N(cut.OuterRadius, 1);
        _d["per"] = N(cut.SegmentsPerCircle); _d["segs"] = N(cut.Segments);
        _d["boards"] = N(cut.Boards); _d["bl"] = N(cut.BoardLength, 1); _d["bw"] = N(cut.BoardWidth, 1);
        _d["laschen"] = N(cut.Laschen); _d["ll"] = N(cut.LascheLength, 1); _d["lw"] = N(cut.LascheWidth, 1);
        var d = Show(Lang.T("Zuschnitt als SVG"), @<div class="form">
            @Hint(Lang.T("Jedes Teil wird als eigene SVG-Datei in Originalgröße (1:1) gespeichert, zusammen in einer ZIP-Datei. Gestrichelt ist die Gleismitte eingezeichnet. Maße in mm, ohne Sägezugabe."))
            <div class="section">@Lang.T("Trassensegmente")</div>
            <div class="cols">
                <div><label class="field-label">@Lang.T("Innenradius")</label><input class="input" inputmode="decimal" @bind='_d["ri"]' @bind:event="oninput" /></div>
                <div><label class="field-label">@Lang.T("Außenradius")</label><input class="input" inputmode="decimal" @bind='_d["ro"]' @bind:event="oninput" /></div>
                <div><label class="field-label">@Lang.T("Segmente je Kreis")</label><input class="input" inputmode="numeric" @bind='_d["per"]' @bind:event="oninput" /></div>
                <div><label class="field-label">@Lang.T("Anzahl")</label><input class="input" inputmode="numeric" @bind='_d["segs"]' @bind:event="oninput" /></div>
            </div>
            <div class="section">@Lang.T("Gerade Bretter (Oval)")</div>
            <div class="cols">
                <div><label class="field-label">@Lang.T("Länge")</label><input class="input" inputmode="decimal" @bind='_d["bl"]' @bind:event="oninput" /></div>
                <div><label class="field-label">@Lang.T("Breite")</label><input class="input" inputmode="decimal" @bind='_d["bw"]' @bind:event="oninput" /></div>
                <div><label class="field-label">@Lang.T("Anzahl")</label><input class="input" inputmode="numeric" @bind='_d["boards"]' @bind:event="oninput" /></div>
            </div>
            <div class="section">@Lang.T("Stoßlaschen")</div>
            <div class="cols">
                <div><label class="field-label">@Lang.T("Länge")</label><input class="input" inputmode="decimal" @bind='_d["ll"]' @bind:event="oninput" /></div>
                <div><label class="field-label">@Lang.T("Breite")</label><input class="input" inputmode="decimal" @bind='_d["lw"]' @bind:event="oninput" /></div>
                <div><label class="field-label">@Lang.T("Anzahl")</label><input class="input" inputmode="numeric" @bind='_d["laschen"]' @bind:event="oninput" /></div>
            </div>
        </div>, wide: true, keepFields: true);
        d.Buttons.Add(new(Lang.T("Abbrechen"), () => true));
        d.Buttons.Add(new(Lang.T("SVG speichern"), () =>
        {
            var errors = new List<string>();
            Read("ri", Lang.T("Innenradius"), 0, 5000, errors, out var ri);
            Read("ro", Lang.T("Außenradius"), 10, 6000, errors, out var ro);
            Read("per", Lang.T("Segmente je Kreis"), 2, 36, errors, out var per);
            Read("segs", Lang.T("Anzahl Segmente"), 0, 500, errors, out var segs);
            Read("bl", Lang.T("Länge der Bretter"), 0, 5000, errors, out var bl);
            Read("bw", Lang.T("Breite der Bretter"), 0, 2000, errors, out var bw);
            Read("boards", Lang.T("Anzahl Bretter"), 0, 200, errors, out var boards);
            Read("ll", Lang.T("Länge der Laschen"), 0, 2000, errors, out var ll);
            Read("lw", Lang.T("Breite der Laschen"), 0, 2000, errors, out var lw);
            Read("laschen", Lang.T("Anzahl Laschen"), 0, 500, errors, out var laschen);
            if (errors.Count > 0) return Fail(errors);
            var edited = cut with
            {
                InnerRadius = ri, OuterRadius = ro, SegmentsPerCircle = (int)Math.Round(per), Segments = (int)Math.Round(segs),
                BoardLength = bl, BoardWidth = bw, Boards = (int)Math.Round(boards), LascheLength = ll, LascheWidth = lw, Laschen = (int)Math.Round(laschen),
            };
            if (!Fail(edited.Problems())) return false;
            ExportSvgFiles(edited.ToSvgFiles(SafeName), Lang.F($"{SafeName} – Zuschnitt Gleiswendel"));
            return true;
        }, true));
    }

    // ---------- Spantenbau ----------

    private void AskFrame()
    {
        var plan = _session.Plan;
        var def = FrameBuild.Defaults(plan.Gauge);
        _d.Clear();
        _d["dir"] = "0"; _d["spacing"] = N(def.Spacing); _d["width"] = N(def.TrasseWidth); _d["thick"] = N(def.Thickness); _d["base"] = N(def.BaseHeight);
        var d = Show(Lang.T("Spantenbau"), @<div class="form">
            @Hint(Lang.T("Offene Rahmenbauweise: Spanten stehen in festem Abstand auf dem Rahmen, die Trassen liegen oben drauf. Höhe und Neigung jeder Auflage kommen aus den Gleishöhen. Liegt eine Trasse unter einer anderen, bekommt der Spant einen Ausschnitt mit Durchfahrtshöhe – so tragen dieselben Spanten mehrere Ebenen."))
            <div class="cols">
                <div>
                    <label class="field-label">@Lang.T("Lage der Spanten")</label>
                    <select class="input" @bind='_d["dir"]'>
                        <option value="0">@Lang.T("quer (parallel zur Tiefe)")</option>
                        <option value="1">@Lang.T("längs (parallel zur Breite)")</option>
                    </select>
                </div>
                <div><label class="field-label">@Lang.T("Abstand höchstens (mm)")</label><input class="input" inputmode="decimal" @bind='_d["spacing"]' @bind:event="oninput" /></div>
                <div><label class="field-label">@Lang.T("Trassenbreite (mm)")</label><input class="input" inputmode="decimal" @bind='_d["width"]' @bind:event="oninput" /></div>
                <div><label class="field-label">@Lang.T("Trassenstärke (mm)")</label><input class="input" inputmode="decimal" @bind='_d["thick"]' @bind:event="oninput" /></div>
                <div><label class="field-label">@Lang.T("Schienenoberkante bei Höhe 0 über Rahmen (mm)")</label><input class="input" inputmode="decimal" @bind='_d["base"]' @bind:event="oninput" /></div>
            </div>
        </div>, wide: true, keepFields: true);
        d.Buttons.Add(new(Lang.T("Abbrechen"), () => true));
        d.Buttons.Add(new(Lang.T("Berechnen"), () =>
        {
            var errors = new List<string>();
            Read("spacing", Lang.T("Abstand"), 50, 2000, errors, out var spacing);
            Read("width", Lang.T("Trassenbreite"), 10, 1000, errors, out var width);
            Read("thick", Lang.T("Trassenstärke"), 3, 50, errors, out var thick);
            Read("base", Lang.T("Schienenoberkante bei Höhe 0"), 10, 2000, errors, out var bas);
            if (!Fail(errors)) return false;
            var spec = new FrameSpec(D("dir") == "1" ? FrameDirection.Laengs : FrameDirection.Quer, spacing, width, thick, bas);
            var result = FrameBuild.Build(plan, spec);
            CloseDialog();
            ShowFrame(result);
            return false;
        }, true));
    }

    private void ShowFrame(FramePlan f)
    {
        var axis = f.Spec.Direction == FrameDirection.Quer ? "x" : "y";
        var d = Show(Lang.T("Spantenbau"), @<div class="list">
            @foreach (var n in f.Notes)
            {
                <div class="@(n.StartsWith(Lang.T("Achtung")) ? "danger" : "secondary")">• @n</div>
            }
            @if (f.Ribs.Count > 0)
            {
                <table class="table ribs">
                    <tr><th>@Lang.T("Nr.")</th><th>@Lang.T("Lage")</th><th>@Lang.T("Länge")</th><th>@Lang.T("Höhe")</th><th>@Lang.T("Auflagen und Ausschnitte (mm ab Spantanfang)")</th></tr>
                    @foreach (var r in f.Ribs)
                    {
                        <tr>
                            <td>@r.Number</td><td>@($"{axis} = {Fmt.Num(r.Position, 0)}")</td><td>@Fmt.Num(r.Length, 0)</td><td>@Fmt.Num(r.Height, 0)</td>
                            <td>
                                @foreach (var s in r.Supports) { <div>@Lang.F($"{Fmt.Num(s.From - r.Start, 0)}–{Fmt.Num(s.To - r.Start, 0)}: Höhe {(Math.Abs(s.HeightFrom - s.HeightTo) < 0.5 ? Fmt.Num(s.Mid, 0) : $"{Fmt.Num(s.HeightFrom, 0)} → {Fmt.Num(s.HeightTo, 0)}")}")</div> }
                                @foreach (var c in r.Cutouts) { <div class="secondary">@Lang.F($"Ausschnitt {Fmt.Num(c.From - r.Start, 0)}–{Fmt.Num(c.To - r.Start, 0)}: {Fmt.Num(Math.Min(c.BottomFrom, c.BottomTo), 0)} bis {Fmt.Num(c.Top, 0)}")</div> }
                            </td>
                        </tr>
                    }
                </table>
            }
        </div>, wide: true);
        if (f.Ribs.Count > 0)
        {
            d.Buttons.Add(new(Lang.T("Als SVG speichern"), () => { ExportSvgFiles(f.ToSvgFiles(SafeName), Lang.F($"{SafeName} – Spanten")); return false; }));
            d.Buttons.Add(new(Lang.T("Als CSV speichern"), () => { Export(f.ToCsv(), "text/csv", Lang.F($"{SafeName} – Spanten.csv")); return false; }));
        }
        d.Buttons.Add(new(Lang.T("Schließen"), () => true, true));
    }

    // ---------- Trasse aus Auswahl ----------

    private void AskRampCut()
    {
        var plan = _session.Plan;
        var ids = _session.Selection.ToHashSet();
        var def = RampTrasse.Defaults(plan.Gauge);
        _d.Clear();
        _d["width"] = N(def.Width); _d["thick"] = N(def.Thickness); _d["max"] = N(def.MaxPartLength); _d["lasche"] = N(def.LascheLength);
        var d = Show(Lang.T("Trasse aus Auswahl"), @<div class="form">
            @Hint(Lang.F($"Die Trasse folgt der Gleismitte der {ids.Count} markierten Gleise und wird in gleich lange Teile geteilt. Jedes Teil und jede Stoßlasche wird als eigene SVG-Datei in Originalgröße gespeichert; die Gleisstöße sind mit ihrer Höhe eingezeichnet."))
            <div class="cols">
                <div><label class="field-label">@Lang.T("Trassenbreite (mm)")</label><input class="input" inputmode="decimal" @bind='_d["width"]' @bind:event="oninput" /></div>
                <div><label class="field-label">@Lang.T("Trassenstärke (mm)")</label><input class="input" inputmode="decimal" @bind='_d["thick"]' @bind:event="oninput" /></div>
                <div><label class="field-label">@Lang.T("Größte Teillänge (mm)")</label><input class="input" inputmode="decimal" @bind='_d["max"]' @bind:event="oninput" /></div>
                <div><label class="field-label">@Lang.T("Laschenlänge (mm, 0 = keine)")</label><input class="input" inputmode="decimal" @bind='_d["lasche"]' @bind:event="oninput" /></div>
            </div>
        </div>, wide: true, keepFields: true);
        d.Buttons.Add(new(Lang.T("Abbrechen"), () => true));
        d.Buttons.Add(new(Lang.T("Berechnen"), () =>
        {
            var errors = new List<string>();
            Read("width", Lang.T("Trassenbreite"), 10, 1000, errors, out var width);
            Read("thick", Lang.T("Trassenstärke"), 1, 50, errors, out var thick);
            Read("max", Lang.T("Größte Teillänge"), 100, Helix.SheetLength, errors, out var max);
            Read("lasche", Lang.T("Laschenlänge"), 0, 1000, errors, out var lasche);
            if (!Fail(errors)) return false;
            var (cut, error) = RampTrasse.Build(plan, ids, new RampSpec(width, thick, max, lasche));
            if (cut is null) return Fail([error ?? ""]);
            CloseDialog();
            ShowRampCut(cut);
            return false;
        }, true));
    }

    private void ShowRampCut(RampCut cut)
    {
        var d = Show(Lang.T("Trasse aus Auswahl"), @<div class="list">
            @foreach (var line in cut.ToText().Split(Environment.NewLine))
            {
                <div class="@(line.StartsWith(Lang.T("Achtung")) ? "danger" : "")">@line</div>
            }
        </div>, wide: true);
        d.Buttons.Add(new(Lang.T("SVG-Dateien speichern"), () => { ExportSvgFiles(cut.ToSvgFiles(SafeName), Lang.F($"{SafeName} – Trasse")); return false; }));
        d.Buttons.Add(new(Lang.T("Schließen"), () => true, true));
    }

