    // ---------- Planvorschlag ----------

    /// <summary>Zuletzt eingegebene Stückzahlen, damit sie beim nächsten Öffnen wieder dastehen.</summary>
    private readonly Dictionary<string, string> _suggestCounts = [];
    private IReadOnlyList<PlanSuggestion>? _suggestions;

    private void AskSuggest()
    {
        _d.Clear();
        _suggestions = null;
        foreach (var (def, stock) in _session.SuggestPieces())
            _d["n|" + def.Key] = _suggestCounts.TryGetValue(def.Key, out var v) ? v : stock > 0 ? stock.ToString() : "";
        _d["replace"] = "1";
        var d = Show(Lang.T("Planvorschlag"), SuggestBody, wide: true, keepFields: true);
        d.Buttons.Add(new(Lang.T("Schließen"), () => true));
        d.Buttons.Add(new(Lang.T("Vorschläge berechnen"), () =>
        {
            var counts = new Dictionary<string, int>();
            var errors = new List<string>();
            foreach (var (def, _) in _session.SuggestPieces())
            {
                var t = D("n|" + def.Key).Trim();
                _suggestCounts[def.Key] = t;
                if (t.Length == 0) continue;
                if (int.TryParse(t, out var n) && n >= 0 && n <= 999) { if (n > 0) counts[def.Key] = n; }
                else errors.Add(Lang.F($"{def.Number}: Anzahl bitte als ganze Zahl eingeben."));
            }
            if (counts.Count == 0) errors.Add(Lang.T("Bitte bei mindestens einem Gleis eine Anzahl eintragen."));
            if (!Fail(errors)) return false;
            _ = ComputeSuggestions(counts);
            return false;
        }, true));
    }

    private bool _suggestBusy;

    /// <summary>Rechnet nach einem kurzen Aufschub, damit „Berechne …“ erst zu sehen ist.</summary>
    private async Task ComputeSuggestions(Dictionary<string, int> counts)
    {
        _suggestBusy = true;
        _suggestions = null;
        StateHasChanged();
        await Task.Delay(30);
        try { _suggestions = PlanSuggest.Build(_session.Plan, counts); }
        catch (Exception e) { Report(e); }
        finally { _suggestBusy = false; }
        if (_dialog is { } dlg) dlg.Error = null;
        StateHasChanged();
    }

    private void ApplySuggestion(PlanSuggestion s)
    {
        _session.ApplySuggestion(s, D("replace") == "1");
        CloseAllDialogs();
        _view.Fit();
    }

    /// <summary>Kleines Vorschaubild eines Vorschlags auf der Platte.</summary>
    private MarkupString SuggestPreview(PlanSuggestion s)
    {
        var plan = _session.Plan;
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        string F(double v) => Math.Round(v, 1).ToString(inv);
        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg class=\"suggest-preview\" viewBox=\"-20 -20 {F(plan.BoardWidth + 40)} {F(plan.BoardHeight + 40)}\" preserveAspectRatio=\"xMidYMid meet\" aria-hidden=\"true\">");
        foreach (var r in BoardGeometry.Rects(plan))
            sb.Append($"<rect x=\"{F(r.X0)}\" y=\"{F(r.Y0)}\" width=\"{F(r.X1 - r.X0)}\" height=\"{F(r.Y1 - r.Y0)}\" class=\"board\"/>");
        var width = Math.Max(plan.Gauge.TrackWidth * 1.6, Math.Max(plan.BoardWidth, plan.BoardHeight) / 140);
        foreach (var p in s.Pieces)
        {
            var cls = p.Def.Kind switch { PieceKind.Switch or PieceKind.Crossing => "sw", PieceKind.Buffer => "buf", _ => "" };
            foreach (var l in p.WorldLegs())
            {
                var pts = string.Join(" ", Enumerable.Range(0, l.IsArc ? 9 : 2).Select(i => l.At(i / (l.IsArc ? 8.0 : 1.0))).Select(q => F(q.X) + "," + F(q.Y)));
                sb.Append($"<polyline points=\"{pts}\" class=\"{cls}\" stroke-width=\"{F(width)}\"/>");
            }
        }
        sb.Append("</svg>");
        return new MarkupString(sb.ToString());
    }

    private RenderFragment SuggestBody => @<div class="form">
        @{
            var pieces = _session.SuggestPieces();
            var plan = _session.Plan;
        }
        @Hint(Lang.F($"Trag ein, wie viele Gleise von jeder Sorte du hast – leer oder 0 heißt keins. Das Programm baut daraus kleine Anlagen, die auf die Platte ({Fmt.Num(plan.BoardWidth, 0)} × {Fmt.Num(plan.BoardHeight, 0)} mm) passen, geschlossen sind und die Planprüfung bestehen. Gleissystem: {_session.CurrentSystem.Name} (in der Gleisbibliothek umschalten)."))
        @if (pieces.Count == 0)
        {
            <div>@Lang.T("Dieses Gleissystem hat keine Gleise, aus denen sich ein Vorschlag bauen lässt.")</div>
        }
        else
        {
            <div class="suggest-stock">
                <table class="table bom">
                    <tr><th>@Lang.T("Anzahl")</th><th>@Lang.T("Artikel")</th></tr>
                    @foreach (var (def, _) in pieces)
                    {
                        var key = def.Key;
                        <tr>
                            <td><input class="input tiny" inputmode="numeric" placeholder="0" @bind='_d["n|" + key]' @bind:event="oninput" /></td>
                            <td><div>@($"{def.Number} · {def.Name}")</div><div class="secondary">@def.Spec</div></td>
                        </tr>
                    }
                </table>
            </div>
        }
        @if (plan.Pieces.Count > 0)
        {
            <label class="check"><input type="checkbox" checked="@(D("replace") == "1")" @onchange="@(e => _d["replace"] = e.Value is true ? "1" : "")" /> @Lang.T("Vorhandene Gleise dabei ersetzen")</label>
        }
        @if (_suggestBusy)
        {
            <div class="secondary">@Lang.T("Berechne Vorschläge …")</div>
        }
        @if (_suggestions is { } list)
        {
            @if (list.Count == 0)
            {
                <div class="error-box">@Lang.T("Damit lässt sich auf dieser Platte keine geschlossene Anlage bauen. Für ein Oval braucht es Bögen für einen ganzen Kreis eines Radius, und die Platte muss mindestens den doppelten Radius tief sein.")</div>
            }
            else
            {
                <div class="suggest-list">
                    @foreach (var s in list)
                    {
                        var item = s;
                        <div class="suggest-item">
                            @SuggestPreview(item)
                            <div class="suggest-text">
                                <div class="strong">@item.Name</div>
                                <div class="secondary">@item.Description</div>
                                <div class="secondary">@Lang.F($"{item.Used} Gleise · {Fmt.Num(item.Width / 1000, 2)} × {Fmt.Num(item.Height / 1000, 2)} m")</div>
                            </div>
                            <button class="btn accent" @onclick="@(() => ApplySuggestion(item))">@Lang.T("Übernehmen")</button>
                        </div>
                    }
                </div>
            }
        }
    </div>;

    private void ShowProfile()
    {
        if (_session.Profile() is not { } profile) return;
        const int w = 640, h = 260;
        var chart = profile.Chart(w, h);
        var c = new Graphics.Canvas(w, h);
        using var p = new Graphics.Paint { AntiAlias = true };
        p.SetStyle(Graphics.Paint.Style.Stroke);
        p.StrokeWidth = 1;
        p.Color = Graphics.Color.Argb(0x30, 0x80, 0x80, 0x80);
        foreach (var (y, _) in chart.HeightTicks) c.DrawLine((float)chart.Left, (float)y, (float)chart.Right, (float)y, p);
        p.Color = Ui.TextSecondary;
        c.DrawLine((float)chart.Left, (float)chart.Top, (float)chart.Left, (float)chart.Bottom, p);
        c.DrawLine((float)chart.Left, (float)chart.Bottom, (float)chart.Right, (float)chart.Bottom, p);
        var line = new Graphics.Path();
        var fill = new Graphics.Path();
        fill.MoveTo((float)chart.Line[0].X, (float)chart.Bottom);
        for (var i = 0; i < chart.Line.Count; i++)
        {
            var (x, y) = chart.Line[i];
            if (i == 0) line.MoveTo((float)x, (float)y); else line.LineTo((float)x, (float)y);
            fill.LineTo((float)x, (float)y);
        }
        fill.LineTo((float)chart.Line[^1].X, (float)chart.Bottom);
        fill.Close();
        p.SetStyle(Graphics.Paint.Style.Fill);
        p.Color = Graphics.Color.Argb(0x30, Ui.Accent.R, Ui.Accent.G, Ui.Accent.B);
        c.DrawPath(fill, p);
        p.SetStyle(Graphics.Paint.Style.Stroke);
        p.Color = Ui.Accent;
        p.StrokeWidth = 2.5f;
        p.StrokeJoin = Graphics.Paint.Join.Round;
        c.DrawPath(line, p);
        p.SetStyle(Graphics.Paint.Style.Fill);
        foreach (var (x, y) in chart.Line) c.DrawCircle((float)x, (float)y, 3, p);
        using var t = new Graphics.Paint { AntiAlias = true, TextSize = 11, Color = Ui.TextSecondary, TextAlign = Graphics.Paint.Align.Right };
        foreach (var (y, text) in chart.HeightTicks) c.DrawText(text, (float)chart.Left - 6, (float)y + 4, t);
        t.TextAlign = Graphics.Paint.Align.Center;
        foreach (var (x, text) in chart.DistanceTicks) c.DrawText(text, (float)x, (float)chart.Bottom + 16, t);
        foreach (var g in chart.Grades)
        {
            t.Color = g.Steep ? Ui.Danger : Ui.Text;
            c.DrawText(g.Text, (float)g.X, (float)g.Y, t);
        }
        var svg = Graphics.SvgWriter.Image(c, "profile-chart");
        var d = Show(Lang.T("Höhenprofil"), @<div class="form">
            <div class="secondary">@profile.Summary()</div>
            <div class="chart">@((MarkupString)svg)</div>
            <div class="secondary small">@Lang.T("Höhe der Schienenoberkante in mm über der Platte, entlang der gewählten Gleise. Rote Werte liegen über der empfohlenen Steigung.")</div>
        </div>, wide: true);
        d.Buttons.Add(new(Lang.T("Schließen"), () => true, true));
    }

    private void AskDetectorType(Action<DetectorType> pick)
    {
        var d = Show(Lang.T("Rückmelder setzen"), @<div class="list">
            @Hint(Lang.T("Art wählen, dann auf die Gleise klicken. Die Kontakte werden fortlaufend nummeriert (16 je Rückmeldemodul, z. B. s88)."))
            @foreach (var t in Enum.GetValues<DetectorType>())
            {
                var type = t;
                <button class="list-item @(t == _session.DetectorType ? "on" : "")" @onclick="@(() => { CloseDialog(); pick(type); })">
                    <span class="texts">
                        <span class="strong">@Detector.TypeName(t)</span>
                        <span class="secondary">@(t switch
                        {
                            DetectorType.Strom => Lang.T("Meldet ein besetztes Gleis über den Stromverbrauch (Zweileiter: eine Schiene getrennt)."),
                            DetectorType.Kontakt => Lang.T("Meldet, wenn ein Zug über das Schaltgleis fährt (Märklin: Kontaktgleis bzw. Schaltgleis)."),
                            _ => Lang.T("Reedkontakt im Gleis, ausgelöst durch einen Magneten unter dem Fahrzeug."),
                        })</span>
                    </span>
                </button>
            }
        </div>);
        d.Buttons.Add(new(Lang.T("Abbrechen"), () => true));
    }

    // ---------- Elektrik: Stromart, Kabel, Anschlüsse ----------

    private void AskCurrent()
    {
        var d = Show(Lang.T("Betrieb und Stromart"), @<div class="list">
            <div class="section">@Lang.T("Betrieb")</div>
            @foreach (var m in Enum.GetValues<PowerMode>())
            {
                var mode = m;
                <button class="list-item @(_session.Plan.Operation == m ? "on" : "")" @onclick="@(() => { _session.SetOperation(mode); Refresh(); })">
                    <span class="texts">
                        <span class="strong">@PowerSupply.ModeName(m)</span>
                        <span class="secondary">@(m == PowerMode.Digital
                            ? Lang.T("Digitalzentrale (z. B. Märklin CS3, ESU ECoS, Roco Z21) und bei Bedarf Booster speisen das Gleis; Loks mit Decoder.")
                            : Lang.T("Ein oder mehrere Fahrtrafos bzw. Fahrregler speisen je einen Stromkreis."))</span>
                    </span>
                </button>
            }
            <div class="section">@Lang.T("Stromart")</div>
            @Hint(Lang.F($"Erkannt aus dem Gleis: {(Electrics.IsThreeRail(_session.Plan) ? Lang.T("Mittelleiter → Wechselstrom") : Lang.T("Zweileiter → Gleichstrom"))}."))
            @foreach (var k in Enum.GetValues<CurrentKind>())
            {
                var kind = k;
                <button class="list-item @(_session.Plan.Current == k ? "on" : "")" @onclick="@(() => { CloseDialog(); _session.SetCurrent(kind); _view.Rebuild(); })">
                    <span class="texts">
                        <span class="strong">@Electrics.CurrentName(k)</span>
                        <span class="secondary">@(k switch
                        {
                            CurrentKind.Gleichstrom => Lang.T("Zweileiter-Gleis (z. B. Märklin Z, Fleischmann, Roco, Trix, Piko). Je Einspeisung Plus und Minus an die beiden Schienen; die Polung muss im ganzen Abschnitt gleich sein, Kehrschleifen brauchen eine Umpolung."),
                            CurrentKind.Wechselstrom => Lang.T("Mittelleiter-Gleis (Märklin H0, auch Märklin-Digital). Fahrstrom über den Mittelleiter (rot), Masse über die Schienen (braun); Kehrschleifen ohne Sonderschaltung."),
                            _ => Lang.T("Richtet sich nach dem verlegten Gleis: Mittelleiter → Wechselstrom, sonst Gleichstrom."),
                        })</span>
                    </span>
                </button>
            }
        </div>);
        d.Buttons.Add(new(Lang.T("Abbrechen"), () => true));
    }

    private void AskPowerType(Action<PowerSourceType> pick)
    {
        var d = Show(Lang.T("Trafo / Zentrale setzen"), @<div class="list">
            @Hint(Lang.F($"Betrieb: {PowerSupply.ModeName(_session.Plan.Operation)}. Art wählen, dann an die Stelle im Plan klicken – auch neben die Platte, wo das Gerät später steht."))
            @foreach (var t in PowerSupply.TypesFor(_session.Plan.Operation))
            {
                var type = t;
                <button class="list-item @(_session.PowerType == t ? "on" : "")" @onclick="@(() => { CloseDialog(); pick(type); })">
                    <span class="texts">
                        <span class="strong"><span class="wire-swatch" style="background:@PowerSupply.Color(t)"></span> @PowerSupply.TypeName(t)</span>
                        <span class="secondary">@PowerSupply.Description(t)</span>
                    </span>
                </button>
            }
            <button class="link small" @onclick="@(() => { CloseDialog(); AskCurrent(); })">@Lang.T("Betrieb ändern (analog / digital)…")</button>
        </div>);
        d.Buttons.Add(new(Lang.T("Abbrechen"), () => true));
    }

    private void AskDistributorColor(Action<string> pick)
    {
        var d = Show(Lang.T("Verteiler setzen"), @<div class="list">
            @Hint(Lang.T("Farbe wählen, dann an die Stelle im Plan klicken. Üblich: braun für Masse, rot für Bahnstrom, gelb für Weichen und Signale, blau und schwarz für Licht und Zubehör."))
            @foreach (var c in PowerSupply.DistributorColors)
            {
                var hex = c.Hex;
                <button class="list-item @(string.Equals(_session.DistributorColor, hex, StringComparison.OrdinalIgnoreCase) ? "on" : "")" @onclick="@(() => { CloseDialog(); pick(hex); })">
                    <span class="texts"><span class="strong"><span class="wire-swatch" style="background:@hex"></span> @Lang.F($"Verteiler {Lang.T(c.Name)}")</span></span>
                </button>
            }
        </div>);
        d.Buttons.Add(new(Lang.T("Abbrechen"), () => true));
    }

    private void AskWireUse(Action<WireUse> pick)
    {
        var current = Electrics.Current(_session.Plan);
        var d = Show(Lang.T("Kabel verlegen"), @<div class="list">
            @Hint(Lang.T("Wofür ist das Kabel? Danach richtet sich die vorgeschlagene Aderfarbe. Dann Punkte im Plan anklicken; Doppelklick oder „Fertig“ beendet das Kabel."))
            @foreach (var u in Enum.GetValues<WireUse>())
            {
                var use = u;
                var color = WireLayout.DefaultColor(u, current);
                <button class="list-item @(_session.WireUse == u ? "on" : "")" @onclick="@(() => { CloseDialog(); pick(use); })">
                    <span class="texts">
                        <span class="strong"><span class="wire-swatch" style="background:@color"></span> @WireLayout.UseName(u)</span>
                        <span class="secondary">@Lang.F($"{WireLayout.ColorName(color)}, {WireLayout.SectionText(WireLayout.DefaultSection(u, _session.Plan.Gauge))}")</span>
                    </span>
                </button>
            }
        </div>);
        d.Buttons.Add(new(Lang.T("Abbrechen"), () => true));
    }
}
