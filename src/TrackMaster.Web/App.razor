    /// <summary>Preise und Bestand aus den Feldern übernehmen (nur wenn sich etwas geändert hat).</summary>
    private bool ApplyCosts(bool closing)
    {
        var rows = BillOfMaterials.Costs(_session.Plan);
        var changes = new List<(string Key, double? Price, int Stock)>();
        var errors = new List<string>();
        foreach (var r in rows)
        {
            var pt = D("p|" + r.Key).Trim();
            double? price = pt.Length == 0 ? null : BillOfMaterials.ParseMoney(pt);
            if (pt.Length > 0 && price is null) errors.Add(Lang.F($"{r.Name}: Preis bitte als Zahl eingeben."));
            var st = D("s|" + r.Key).Trim();
            var stock = st.Length == 0 ? 0 : int.TryParse(st, out var n) && n >= 0 ? n : -1;
            if (stock < 0) { errors.Add(Lang.F($"{r.Name}: Bestand bitte als ganze Zahl eingeben.")); stock = r.Stock; }
            if (price != r.Price || stock != r.Stock) changes.Add((r.Key, price, stock));
        }
        if (!Fail(errors)) return false;
        if (changes.Count > 0)
        {
            // Unveränderte Zeilen behalten ihre Werte
            var all = rows.Select(r => changes.FirstOrDefault(c => c.Key == r.Key) is { Key: not null } c ? c : (r.Key, r.Price, r.Stock)).ToList();
            _session.SetCosts(all);
        }
        return true;
    }

    private async Task ImportPriceList()
    {
        var result = await Js.PickFile(".csv,.txt,text/csv,text/plain");
        if (string.IsNullOrEmpty(result)) return;
        var cut = result.IndexOf('\0');
        var text = cut >= 0 ? result[(cut + 1)..] : result;
        if (_session.ImportPrices(text) > 0)
        {
            CloseDialog();
            ShowBillOfMaterials();
        }
        StateHasChanged();
    }

    private RenderFragment BomBody => @<div class="list">
        @{
            var plan = _session.Plan;
            var rows = BillOfMaterials.Costs(plan);
            var stats = plan.Statistics();
            var withPrice = rows.Where(r => BillOfMaterials.ParseMoney(D("p|" + r.Key)) is not null).ToList();
            double Price(CostRow r) => BillOfMaterials.ParseMoney(D("p|" + r.Key)) ?? 0;
            int Stock(CostRow r) => int.TryParse(D("s|" + r.Key), out var n) && n > 0 ? n : 0;
            var all = rows.Sum(r => Price(r) * r.Count);
            var buy = rows.Sum(r => Price(r) * Math.Max(0, r.Count - Stock(r)));
        }
        <div class="secondary">@Lang.F($"{plan.Name} · Spur {plan.GaugeId} · {stats.Pieces} Teile · {Fmt.Num(stats.TrackLengthMm / 1000, 2)} m Gleis")</div>
        @if (rows.Count == 0)
        {
            <div>@Lang.T("Der Plan enthält noch keine Gleise.")</div>
        }
        else
        {
            @Hint(Lang.T("Preise und eigenen Bestand eintragen: Die Liste zeigt dann, was noch zu kaufen ist und was es kostet. Die Werte werden mit dem Plan gespeichert."))
            <table class="table bom">
                <tr><th>@Lang.T("Anzahl")</th><th>@Lang.T("Artikel")</th><th>@Lang.T("Bestand")</th><th>@Lang.T("Zu kaufen")</th><th>@Lang.T("Preis")</th><th>@Lang.T("Summe")</th></tr>
                @foreach (var r in rows)
                {
                    var key = r.Key;
                    var toBuy = Math.Max(0, r.Count - Stock(r));
                    <tr>
                        <td class="count">@($"{r.Count}×")</td>
                        <td><div>@(r.Article.Length > 0 ? $"{r.Article} · {r.Name}" : r.Name)</div><div class="secondary">@($"{r.Detail} · {r.System}")</div></td>
                        <td><input class="input tiny" inputmode="numeric" placeholder="0" @bind='_d["s|" + key]' @bind:event="oninput" /></td>
                        <td class="count @(toBuy > 0 ? "" : "ok")">@toBuy</td>
                        <td><input class="input tiny" inputmode="decimal" placeholder="–" @bind='_d["p|" + key]' @bind:event="oninput" /></td>
                        <td class="money">@(BillOfMaterials.ParseMoney(D("p|" + key)) is { } p ? BillOfMaterials.Money(p * toBuy) : "")</td>
                    </tr>
                }
            </table>
            @if (withPrice.Count > 0)
            {
                <dl class="rows totals">
                    <dt>@Lang.T("Noch zu kaufen")</dt><dd class="strong">@BillOfMaterials.Money(buy)</dd>
                    <dt>@Lang.T("Alles neu gekauft")</dt><dd>@BillOfMaterials.Money(all)</dd>
                    @if (withPrice.Count < rows.Count)
                    {
                        <dt>@Lang.T("Ohne Preis")</dt><dd>@Lang.F($"{rows.Count - withPrice.Count} Artikel")</dd>
                    }
                </dl>
            }
        }
    </div>;

