    /// <summary>Modell einer Kategorie wählen; danach setzt ein Klick in den Plan das Modell.</summary>
    private void AskModel(string title, IReadOnlyList<ModelDefinition> models)
    {
        var current = _session.Tool == CanvasTool.Model ? _session.ModelId : null;
        var d = Show(title, @<div class="list">
            @if (models.Count == 0)
            {
                <div class="secondary">@Lang.T("(noch keine)")</div>
            }
            @foreach (var m in models)
            {
                var id = m.Id;
                <button class="list-item model-choice @(id == current ? "on" : "")" @onclick="@(() => { CloseDialog(); SetModelTool(id); })">
                    <span class="model-pic">@((MarkupString)Pictures.Model(m))</span>
                    <span class="texts">
                        <span class="strong">@m.Name</span>
                        <span class="secondary">@m.Description</span>
                    </span>
                </button>
            }
        </div>);
        d.Buttons.Add(new(Lang.T("Abbrechen"), () => true));
    }

