    private void ShowModelLibrary()
    {
        var used = _session.Plan.Scenery.Where(s => s.IsModel).Select(s => s.Model!).ToHashSet();
        var own = ModelLibrary.Own.OrderBy(m => m.Category).ThenBy(m => m.Name).ToList();
        var planOnly = _session.PlanModelsNotInLibrary();
        RenderFragment Row(ModelDefinition m, bool inLibrary) => @<div class="list-item me-lib-item">
            <span class="model-pic">@((MarkupString)Pictures.Model(m))</span>
            <span class="texts">
                <span class="strong">@m.Name</span>
                <span class="secondary">@(string.IsNullOrWhiteSpace(m.Category) ? ModelLibrary.OwnCategory : m.Category)@(inLibrary ? (used.Contains(m.Id) ? " · " + Lang.T("im Plan verwendet") : "") : " · " + Lang.T("nur im Plan"))</span>
                <span class="button-row">
