    private string ItemName(SwitchingItem item)
        => item.PieceId is { } pid ? _session.Plan.Find(pid)?.Name ?? "" : _session.Plan.Signals.FirstOrDefault(s => s.Id == item.SignalId)?.Name ?? "";

    private void SetItemName(SwitchingItem item, string? text)
    {
        var t = (text ?? "").Trim();
        if (t == ItemName(item)) return;
        _session.Edit(() =>
        {
            if (item.PieceId is { } pid && _session.Plan.Find(pid) is { } p) p.Name = t;
            else if (_session.Plan.Signals.FirstOrDefault(s => s.Id == item.SignalId) is { } s) s.Name = t;
        });
    }

    private void SetAddress(SwitchingItem item, string? text)
    {
        var t = (text ?? "").Trim();
        int? value = t.Length == 0 ? null : int.TryParse(t, out var v) && v is > 0 and <= 2048 ? v : -1;
        if (value == -1) { ShowToast(Lang.T("Adressen von 1 bis 2048.")); return; }
        if (value == item.Address) return;
        _session.Edit(() =>
        {
            if (item.PieceId is { } pid && _session.Plan.Find(pid) is { } p) p.Address = value;
            else if (_session.Plan.Signals.FirstOrDefault(s => s.Id == item.SignalId) is { } s) s.Address = value;
        });
    }

