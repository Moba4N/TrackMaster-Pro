@using TrackMaster.Licensing
@using Signal = TrackMaster.Core.Signal

@{
    var plan = _session.Plan;
    var stats = plan.Statistics(_session.Connections);
    var selected = _session.Selection.Count;
    var tab = _ribbon.FirstOrDefault(t => t.Name == _tab) ?? _ribbon[0];
}
<div class="shell @(_libraryOpen ? "lib-open" : "") @(_propsOpen ? "props-open" : "")" style="@RootStyle">
    <header class="titlebar">
        @if (_homeUrl.Length > 0)
        {
            <a class="home-link" href="@_homeUrl" target="_top" title="@Lang.T("Zurück zur Startseite der Webseite")">@((MarkupString)Icons.Svg("Home", 18))<span class="hide-narrow">@Lang.T("Startseite")</span></a>
        }
        <button class="icon-btn only-narrow" title="@Lang.T("Gleisbibliothek")" aria-label="@Lang.T("Gleisbibliothek")" @onclick="@(() => { _libraryOpen = !_libraryOpen; _propsOpen = false; })">@((MarkupString)Icons.Svg("Library", 20))</button>
        <img class="app-logo" src="img/logo-small.png" alt="TrackMaster Pro" title="@Lang.T("Über das Programm")" @onclick="@(() => Run("about"))" />
        <div class="titles">
            <span class="app-name">TrackMaster Pro</span>
            <span class="doc-title" title="@(_session.Dirty ? Lang.F($"{plan.Name} – ungespeicherte Änderungen") : plan.Name)">@plan.Name@(_session.Dirty ? " •" : "")</span>
        </div>
        <button class="icon-btn" title="@Lang.T("Rückgängig (Strg+Z)")" disabled="@(!_session.History.CanUndo)" @onclick="@(() => Run("undo"))">@((MarkupString)Icons.Svg("Undo", 20))</button>
        <button class="icon-btn" title="@Lang.T("Wiederholen (Strg+Y)")" disabled="@(!_session.History.CanRedo)" @onclick="@(() => Run("redo"))">@((MarkupString)Icons.Svg("Redo", 20))</button>
        <button class="icon-btn" title="@Lang.T("Verlauf: bis zu 20 Schritte zurück oder vor")" disabled="@(!_session.History.CanUndo && !_session.History.CanRedo)" @onclick="@(() => Run("history"))">@((MarkupString)Icons.Svg("History", 20))</button>
        <button class="edition @(_license.IsPro ? "pro" : "")" title="@_license.Summary" @onclick="@(() => Run("license"))">@_license.EditionName</button>
        <button class="icon-btn only-narrow" title="@Lang.T("Eigenschaften")" aria-label="@Lang.T("Eigenschaften")" @onclick="@(() => { _propsOpen = !_propsOpen; _libraryOpen = false; })">@((MarkupString)Icons.Svg("Properties", 20))</button>
    </header>

    <nav class="ribbon-tabs" role="tablist">
        @foreach (var t in _ribbon)
        {
            var name = t.Name;
            <button role="tab" class="ribbon-tab @(name == _tab ? "on" : "") @(name == Lang.T("Datei") ? "file" : "")" aria-selected="@(name == _tab)" @onclick="() => _tab = name">@name</button>
        }
    </nav>
    <div class="ribbon" role="toolbar">
        @foreach (var g in tab.Groups)
        {
            <div class="ribbon-group">
                <div class="ribbon-items">
                    @foreach (var item in g.Items)
                    {
                        var id = item.Command;
                        var on = Toggles.Contains(id) && IsOn(id);
                        var locked = IsProOnly(id);
                        <button class="rb @(item.Large ? "large" : "small") @(on ? "on" : "")" disabled="@(!CanRun(id))" aria-pressed="@(Toggles.Contains(id) ? on.ToString().ToLowerInvariant() : null)"
                                title="@ItemTip(item, locked)" @onclick="() => Run(id)">
                            <span class="rb-icon">@((MarkupString)Icons.Svg(item.Icon, item.Large ? 28 : 18))@if (locked)
                                {
                                    <span class="lock">@((MarkupString)Icons.Svg("Lock", 11))</span>
                                }</span>
                            <span class="rb-label">@item.Label</span>
                        </button>
                    }
                </div>
                <div class="ribbon-group-name">@g.Name</div>
            </div>
        }
        @if (_tab == Lang.T("Start"))
        {
            @* Spurweite rechts im Register Start (früher oben in der Gleisbibliothek) *@
            <div class="ribbon-group gauge-group">
                <div class="ribbon-gauges">
                    @foreach (var g in Catalog.Gauges)
                    {
                        var gid = g.Id;
                        <button class="chip gauge @(gid == _session.Plan.GaugeId ? "on" : "")" title="@Lang.F($"Spur {g.Id} · {g.Scale} · {Fmt.Num(g.TrackWidth)} mm")"
                                @onclick="() => _session.SetGauge(gid)">@g.Id</button>
                    }
                </div>
                <div class="ribbon-group-name">@Lang.F($"Spurweite · {_session.Plan.Gauge.Scale} · {Fmt.Num(_session.Plan.Gauge.TrackWidth)} mm")</div>
            </div>
        }
    </div>

    <main class="work">
        <aside class="pane library-pane" aria-label="@Lang.T("Gleisbibliothek")">
            <LibraryPanel @ref="_library" Session="_session" Center="Center" AppearanceVersion="_appearanceVersion"
                          OnFlex="s => { _libraryOpen = false; AskFlex(s); }" OnPicked="() => _libraryOpen = false" OnClose="() => { _libraryOpen = false; StateHasChanged(); }" />
        </aside>
        <section class="stage">
            <div class="canvas-host">
                <canvas id="plan-canvas" tabindex="0" aria-label="@Lang.T("Gleisplan")"></canvas>
            </div>
            @if (_ctx is { } cm)
            {
                var hasSel = _session.Selection.Count > 0;
                <div class="ctx-backdrop" @onclick="@(() => _ctx = null)" @oncontextmenu="@(() => _ctx = null)" @oncontextmenu:preventDefault></div>
                <div class="ctx-menu" role="menu" style="@FormattableString.Invariant($"left:{Math.Max(4, Math.Min(cm.X, _view.Width - 230)):F0}px;top:{Math.Max(4, Math.Min(cm.Y, _view.Height - (_session.ConnectionPiece is null ? 330 : 550))):F0}px")" @oncontextmenu:preventDefault>
                    @if (IsModulePlan())
                    {
                        <button role="menuitem" @onclick="@(() => CtxRun("cutJoints"))">@((MarkupString)Icons.Svg("Isolate", 16))<span>@(hasSel ? Lang.T("An Modulkante trennen") : Lang.T("Alle Gleise an Modulkanten trennen"))</span></button>
                    }
                    @if (_view.ContextConnector is { } joint)
                    {
                        <button role="menuitem" @onclick="@(() => { _ctx = null; AskJointHeight(joint); })">@((MarkupString)Icons.Svg("Slope", 16))<span>@Lang.F($"Höhe am Verbindungspunkt ({Fmt.Num(joint.Z, 0)} mm)…")</span></button>
                    }
                    @if (hasSel)
                    {
                        <button role="menuitem" @onclick="@(() => CtxRun("props"))">@((MarkupString)Icons.Svg("Properties", 16))<span>@Lang.T("Eigenschaften")</span></button>
                        @if (_session.ConnectionPiece is { } cp)
                        {
                            var connectedEnds = _session.PieceEnds(cp.Id).Where(e => e.Connected).ToList();
                            var allIsolated = connectedEnds.Count > 0 && connectedEnds.All(e => e.Isolated);
                            <div class="ctx-sep" role="separator"></div>
                            @if (connectedEnds.Count > 0)
                            {
                                <button role="menuitem" @onclick="@(() => CtxRun("connIsolate"))">@((MarkupString)Icons.Svg("Isolate", 16))<span>@(allIsolated ? Lang.T("Trennstellen entfernen") : Lang.T("Trennstellen an allen Enden"))</span></button>
                            }
                            <button role="menuitem" @onclick="@(() => CtxRun("connDetector"))">@((MarkupString)Icons.Svg("Detector", 16))<span>@(_session.DetectorOn(cp.Id) is null ? Lang.T("Rückmelder setzen") : Lang.T("Rückmelder entfernen"))</span></button>
                            <div class="ctx-sep" role="separator"></div>
                        }
                        <button role="menuitem" @onclick="@(() => CtxRun("rotR"))">@((MarkupString)Icons.Svg("RotateRight", 16))<span>@Lang.T("Drehen")</span></button>
                        <button role="menuitem" @onclick="@(() => CtxRun("flip"))">@((MarkupString)Icons.Svg("Mirror", 16))<span>@Lang.T("Spiegeln")</span></button>
                        <button role="menuitem" @onclick="@(() => CtxRun("duplicate"))">@((MarkupString)Icons.Svg("Copy", 16))<span>@Lang.T("Duplizieren")</span></button>
                        <button role="menuitem" @onclick="@(() => CtxRun("delete"))">@((MarkupString)Icons.Svg("Delete", 16))<span>@Lang.T("Löschen")</span></button>
                    }
                    else
                    {
                        @if (_session.SelectedObject is { } so && _session.Plan.Scenery.FirstOrDefault(x => x.Id == so) is { IsPower: true } psrc && PowerSupply.FeedsTrack(PowerSupply.Type(psrc)))
                        {
                            <button role="menuitem" @onclick="@(() => CtxRun("wireFromSource"))">@((MarkupString)Icons.Svg("Wire", 16))<span>@Lang.T("Kabel von hier verlegen (Bahnstrom)")</span></button>
                            @if (PowerSupply.HasGround(PowerSupply.Type(psrc)))
                            {
                                <button role="menuitem" @onclick="@(() => CtxRun("groundFromSource"))">@((MarkupString)Icons.Svg("Wire", 16))<span>@Lang.T("Masse-Kabel von hier verlegen (0)")</span></button>
                            }
                            <div class="ctx-sep" role="separator"></div>
                        }
                        <button role="menuitem" @onclick="@(() => CtxRun("paste"))">@((MarkupString)Icons.Svg("Paste", 16))<span>@Lang.T("Einfügen")</span></button>
                        <button role="menuitem" @onclick="@(() => CtxRun("fit"))">@((MarkupString)Icons.Svg("Fit", 16))<span>@Lang.T("Einpassen")</span></button>
                    }
                    <div class="ctx-sep" role="separator"></div>
                    <button role="menuitem" @onclick="@(() => CtxRun("wires"))">@((MarkupString)Icons.Svg("Wire", 16))<span>@(_session.ShowWires ? Lang.T("Kabel ausblenden") : Lang.T("Kabel einblenden"))</span></button>
                    <button role="menuitem" @onclick="@(() => CtxRun("numberElectrics"))">@((MarkupString)Icons.Svg("Hash", 16))<span>@Lang.T("Elektrik nummerieren")</span></button>
                </div>
            }
            @if (_session.Tool is not (CanvasTool.Select))
            {
                var polygon = _session.Tool is CanvasTool.Terrain or CanvasTool.Water or CanvasTool.Room or CanvasTool.Wire;
                var minPoints = _session.Tool == CanvasTool.Wire ? 2 : 3;
                <div class="toolbar">
                    <span class="tool-text">@ToolText</span>
                    @if (polygon)
                    {
                        <button class="btn" disabled="@(_view.PolygonPoints == 0)" @onclick="() => _view.UndoPolygonPoint()">@Lang.T("Punkt zurück")</button>
                        <button class="btn accent" disabled="@(_view.PolygonPoints < minPoints)" @onclick="() => _view.FinishPolygon()">@Lang.T("Fertig")</button>
                    }
                    <button class="btn" @onclick="() => SetTool(CanvasTool.Select)">@Lang.T("Beenden")</button>
                </div>
            }
            @if (_issueNav is { } nav && _dialog is null && _session.Issues.Count > 0)
            {
                <div class="issue-bar" role="status">
                    <button class="icon-btn" title="@Lang.T("Vorheriger Befund")" @onclick="() => StepIssue(-1)">‹</button>
                    @if (_session.FocusedIssue is { } fi)
                    {
                        var idx = IndexOf(nav.Issues, fi);
                        var cls = fi.Level switch { IssueLevel.Fehler => "danger", IssueLevel.Warnung => "warn", _ => "accent" };
                        <span class="issue-text"><span class="strong small @cls">@($"{fi.Level.Text()} · {fi.Category}") (@(idx + 1)/@nav.Issues.Count)</span> @fi.Text</span>
                    }
                    else
                    {
                        var ne = nav.Issues.Count(i => i.Level == IssueLevel.Fehler);
                        var nw = nav.Issues.Count(i => i.Level == IssueLevel.Warnung);
                        <span class="issue-text"><span class="strong small">@nav.Title</span> @Lang.F($"{ne} Fehler · {nw} Warnungen · {nav.Issues.Count - ne - nw} Hinweise sind im Plan markiert. ✕ oder Esc entfernt die Markierungen.")</span>
                    }
                    <button class="icon-btn" title="@Lang.T("Nächster Befund")" @onclick="() => StepIssue(1)">›</button>
                    <button class="btn small" @onclick="() => ShowIssues(nav.Title, nav.Issues, nav.Footer)">@Lang.T("Liste")</button>
                    <button class="icon-btn" title="@Lang.T("Hervorhebung beenden")" @onclick="CloseIssueNav">✕</button>
                </div>
            }
            @if (plan.Pieces.Count == 0 && plan.Scenery.Count == 0 && _session.Tool == CanvasTool.Select && _dialog is null && !_open3D && !ReferenceEquals(_emptyHintClosedFor, plan))
            {
                <div class="empty-hint" role="note">
                    <button class="icon-btn empty-close" title="@Lang.T("Schließen")" aria-label="@Lang.T("Schließen")" @onclick="@(() => _emptyHintClosedFor = plan)">@((MarkupString)Icons.Svg("Close", 18))</button>
                    <div class="strong">@Lang.T("Der Plan ist noch leer.")</div>
                    <div class="secondary">@Lang.T("Ein Gleis in der Gleisbibliothek anklicken oder auf die Platte ziehen – jedes weitere setzt am freien Ende an.")</div>
                    <div class="button-row inline">
                        <button class="btn only-narrow" @onclick="@(() => { _libraryOpen = true; _propsOpen = false; })">@Lang.T("Gleisbibliothek")</button>
                        <button class="btn" @onclick="@(() => Run("suggest"))">@Lang.T("Planvorschlag…")</button>
                        <button class="btn" @onclick="@(() => Run("sample"))">@Lang.T("Beispielanlage")</button>
                        <button class="btn" @onclick="@(() => Run("help"))">@Lang.T("Bedienung")</button>
                    </div>
                </div>
            }
            @if (_toast is not null)
            {
                <div class="toast" role="status" @onclick="() => _toast = null">@_toast</div>
            }
            <div class="zoom">
                <button class="icon-btn float" title="@Lang.T("Vergrößern (+)")" @onclick="@(() => Run("zoomIn"))">@((MarkupString)Icons.Svg("ZoomIn", 20))</button>
                <button class="icon-btn float" title="@Lang.T("Verkleinern (-)")" @onclick="@(() => Run("zoomOut"))">@((MarkupString)Icons.Svg("ZoomOut", 20))</button>
                <button class="icon-btn float" title="@Lang.T("Ganze Anlage (0)")" @onclick="@(() => Run("fit"))">@((MarkupString)Icons.Svg("Fit", 20))</button>
            </div>
        </section>
        <aside class="pane props-pane" aria-label="@Lang.T("Eigenschaften")">
            <PropertiesPanel Session="_session" Version="_version" Run="Run" OnClose="() => { _propsOpen = false; StateHasChanged(); }" />
        </aside>
        <div class="scrim" @onclick="@(() => { _libraryOpen = false; _propsOpen = false; })"></div>
    </main>

    <div class="levelbar" role="toolbar" aria-label="@Lang.T("Ebenen")">
        <span class="lb-title">@((MarkupString)Icons.Svg("Layers", 14)) @Lang.T("Ebenen")</span>
        @for (var i = 0; i < plan.Levels.Count; i++)
        {
            var k = i;
            var level = plan.Levels[k];
            <span class="lb-chip @(plan.ActiveLevel == k ? "active" : "") @(level.Visible ? "" : "hidden")">
                <input type="checkbox" title="@Lang.T("Ein- oder ausblenden")" aria-label="@Lang.F($"{level.Name} ein- oder ausblenden")" checked="@level.Visible" disabled="@(plan.ActiveLevel == k && level.Visible && plan.Levels.Count(l => l.Visible) == 1)" @onchange="@(e => _session.SetLevelVisible(k, e.Value is true))" />
                <button title="@Lang.F($"{level.Name}, Grundhöhe {Fmt.Num(level.Height, 0)} mm – antippen: neue Gleise kommen auf diese Ebene")" aria-pressed="@(plan.ActiveLevel == k)" @onclick="@(() => _session.SetActiveLevel(k))">@level.Name <span class="secondary">@Fmt.Num(level.Height, 0) mm</span></button>
            </span>
        }
        <button class="lb-add" title="@Lang.T("Ebene hinzufügen")" aria-label="@Lang.T("Ebene hinzufügen")" disabled="@(plan.Levels.Count >= LayoutPlan.MaxLevels)" @onclick="@(() => _session.AddLevel())">+</button>
        <button class="lb-add" title="@Lang.T("Ebenen bearbeiten")" aria-label="@Lang.T("Ebenen bearbeiten")" @onclick="@(() => Run("levels"))">…</button>
        @{ var anyVisible = plan.Levels.Any(l => l.Visible); }
        <button class="lb-add lb-all" title="@(anyVisible ? Lang.T("Alle Ebenen ausblenden") : Lang.T("Alle Ebenen einblenden"))" @onclick="@(() => _session.SetAllLevelsVisible(!anyVisible))">@(anyVisible ? Lang.T("Alle ausblenden") : Lang.T("Alle einblenden"))</button>
    </div>

    <footer class="statusbar">
        <span class="st-item">@Lang.F($"Spur {plan.GaugeId}")</span>
        <span class="st-item">@Lang.F($"{stats.Pieces} Gleise")</span>
        <span class="st-item hide-narrow">@Lang.F($"{stats.Switches} Weichen")</span>
        <span class="st-item">@Fmt.Num(stats.TrackLengthMm / 1000, 2) m</span>
        <span class="st-item @(stats.OpenEnds > 0 ? "warn" : "ok")">@Lang.F($"offene Enden {stats.OpenEnds}")</span>
        @if (selected > 0)
        {
            <span class="st-item">@Lang.F($"{selected} gewählt")</span>
        }
        <span class="st-spacer"></span>
        <span class="st-item hide-narrow" id="status-xy"></span>
        <span class="st-item hide-narrow">@_zoomText</span>
        <button class="st-toggle @(_session.SnapEnabled ? "on" : "")" aria-pressed="@_session.SnapEnabled" title="@Lang.T("Gleise rasten an freien Enden ein")" @onclick="@(() => Run("snap"))">@Lang.T("Einrasten")</button>
        <button class="st-toggle @(_session.ShowGrid ? "on" : "")" aria-pressed="@_session.ShowGrid" title="@Lang.T("Raster anzeigen")" @onclick="@(() => Run("grid"))">@Lang.T("Raster")</button>
    </footer>

    @if (_editModel is { } editModel)
    {
        <ModelEditorPanel @ref="_editor" Model="editModel" Gauge="_session.Plan.Gauge" OnSave="SaveOwnModel" OnClose="CloseModelEditor" />
    }

    @if (_open3D)
    {
        <div class="view3d" role="dialog" aria-label="@Lang.T("3D-Ansicht")">
            <div class="view3d-bar">
                <div class="row">
                    <button class="btn @(!_riding ? "on" : "")" @onclick="Orbit3D">@Lang.T("Rundumsicht")</button>
                    <button class="btn @(_riding ? "on" : "")" @onclick="ToggleRide">@Lang.T("Mitfahren")</button>
                    <button class="btn @(_trainOn ? "on" : "")" @onclick="ToggleTrain">@Lang.T("Zug")</button>
                    @{ var (choices, chosen) = NextChoices(); }
                    @if (choices.Count > 0)
                    {
                        <span class="secondary small">@Lang.T("Richtung:")</span>
                        @foreach (var c in choices)
                        {
                            <button class="btn @(c.Route == chosen ? "on" : "")" title="@Lang.T("An der nächsten Weiche in diese Richtung fahren (Pfeiltasten)")" @onclick="@(() => ChooseDirection(c.Side))">@($"{c.Arrow} {c.Label}")</button>
                        }
                    }
                    <span class="status3d">@_status3D</span>
                    <button class="btn accent" @onclick="Close3D">@Lang.T("Schließen")</button>
                </div>
                <div class="row">
                    <button class="btn @(_scenery3D ? "on" : "")" title="@Lang.T("Gelände, Gewässer, Gebäude und Bäume zeigen")" @onclick="@(() => SetScenery3D(true))">@Lang.T("Mit Gelände")</button>
                    <button class="btn @(!_scenery3D ? "on" : "")" title="@Lang.T("Nur Platte und Gleise zeigen")" @onclick="@(() => SetScenery3D(false))">@Lang.T("Nur Gleisplan")</button>
                    <button class="btn @(_piers3D ? "on" : "")" title="@Lang.T("Stützen unter hochliegenden Gleisen zeigen")" @onclick="TogglePiers3D">@Lang.T("Stützen")</button>
                    <button class="btn @(_tunnels3D ? "on" : "")" title="@Lang.T("Tunnelstrecken zeigen – ausgeschaltet sind Tunnelgleise, Röhren und der Zug darin ausgeblendet")" @onclick="ToggleTunnels3D">@Lang.T("Tunnel")</button>
                    <span class="secondary small" style="margin-left:12px">@Lang.T("Drehen:")</span>
                    <button class="btn" disabled="@_riding" title="@Lang.T("Um die Querachse kippen (X)")" @onclick="@(() => Js.GlTurn(0, 15))">X ↻</button>
                    <button class="btn" disabled="@_riding" title="@Lang.T("Um die Hochachse drehen (Y)")" @onclick="@(() => Js.GlTurn(1, 15))">Y ↻</button>
                    <button class="btn" disabled="@_riding" title="@Lang.T("Um die Blickachse drehen (Z)")" @onclick="@(() => Js.GlTurn(2, 15))">Z ↻</button>
                    <button class="btn" disabled="@_riding" @onclick="@(() => Js.GlTurn(-1, 0))">@Lang.T("Gerade")</button>
                </div>
                <div class="row sliders">
                    <label class="slider"><span>@Lang.T("Tageszeit")</span><input type="range" min="0" max="72" value="@_hourStep" @oninput="SetHour" /><span class="value">@DayLight.TimeText(Hour)</span></label>
                    <label class="slider"><span>@Lang.T("Tempo")</span><input type="range" min="0" max="150" value="@_speedStep" @oninput="SetSpeed" /><span class="value">@($"{Speed:0} km/h")</span></label>
                </div>
            </div>
            <div class="view3d-host"><canvas id="view3d-canvas"></canvas></div>
            <div class="view3d-help">@Lang.T("Ziehen dreht und kippt (auch von unten) · Strg + Ziehen dreht um die Blickachse · rechte Maustaste oder Umschalt + Ziehen verschiebt · Mausrad oder zwei Finger zoomen · Mitfahren startet am gewählten Gleis")</div>
        </div>
    }

    @if (_dialog is { } dialog)
    {
        <div class="modal-back" @onclick="DismissDialog"></div>
        <div class="modal @(dialog.Wide ? "wide" : "")" role="dialog" aria-modal="true" aria-label="@dialog.Title">
            <div class="modal-head">
                <span class="modal-title">@dialog.Title</span>
                <button class="icon-btn" title="@Lang.T("Schließen")" @onclick="DismissDialog">@((MarkupString)Icons.Svg("Close", 18))</button>
            </div>
            <div class="modal-body">
                @dialog.Body
                @if (dialog.Error is { Length: > 0 } error)
                {
                    <div class="error-box">@error</div>
                }
            </div>
            @if (dialog.Buttons.Count > 0)
            {
                <div class="modal-foot">
                    @foreach (var b in dialog.Buttons)
                    {
                        var button = b;
                        <button class="btn @(button.Accent ? "accent" : "")" @onclick="() => Click(button)">@button.Label</button>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    // ---------- Menüband ----------

    private Tab[] BuildRibbon() =>
    [
        new(Lang.T("Datei"),
        [
            new(Lang.T("Plan"), [new(Lang.T("Neu…"), "New", "new", true), new(Lang.T("Öffnen…"), "Open", "open", true, Lang.T("Plan aus einer Datei laden (Strg+O).")),
                new(Lang.T("Speichern"), "Save", "save", true, Lang.T("Plan als Datei herunterladen (Strg+S). In der Basisversion bis 50 Gleise.")),
                new(Lang.T("Speichern unter…"), "SaveAs", "saveAs", false, Lang.T("Dateinamen und – wo der Browser es erlaubt – Speicherort wählen (Strg+Umschalt+S). Danach speichert „Speichern“ in dieselbe Datei.")), new(Lang.T("Beispielanlage"), "Template", "sample", false)]),
            new(Lang.T("Ausgeben"), [new(Lang.T("Drucken…"), "Print", "print", true, Lang.T("Übersicht oder Bauvorlage 1:1 drucken bzw. als PDF speichern (Strg+P).")),
                new(Lang.T("Stückliste…"), "List", "bom", false), new(Lang.T("Stückliste als CSV"), "Csv", "csv", false), new(Lang.T("Plan als SVG (1:1)"), "Image", "svg", false),
