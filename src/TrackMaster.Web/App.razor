                <input class="input" inputmode="decimal" @bind='_d["length"]' @bind:event="oninput" />
            }
            else
            {
                <div class="cols">
                    <div><label class="field-label">Radius (mm)</label><input class="input" inputmode="decimal" @bind='_d["radius"]' @bind:event="oninput" /></div>
                    <div><label class="field-label">@Lang.T("Winkel (°)")</label><input class="input" inputmode="decimal" @bind='_d["angle"]' @bind:event="oninput" /></div>
                </div>
