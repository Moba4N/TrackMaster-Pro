            <div class="segmented">
                <button class="seg @(D("kind") == "straight" ? "on" : "")" @onclick="@(() => _d["kind"] = "straight")">@Lang.T("Gerade")</button>
                <button class="seg @(D("kind") == "curve" ? "on" : "")" @onclick="@(() => _d["kind"] = "curve")">@Lang.T("Bogen")</button>
            </div>
            @if (D("kind") == "straight")
