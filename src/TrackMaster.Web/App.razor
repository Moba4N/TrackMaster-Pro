    private void AskAppearance()
    {
        _d.Clear();
        _d["design"] = _appearance.Design;
        _d["font"] = _appearance.FontChoice.Id;
        var sizeIndex = UiFonts.Sizes.ToList().FindIndex(s => Math.Abs(s.Scale - _appearance.Scale) < 0.01);
        _d["size"] = (sizeIndex < 0 ? 1 : sizeIndex).ToString();
        var d = Show(Lang.T("Darstellung"), @<div class="form">
            @Hint(Lang.T("Das Design bestimmt Akzentfarbe, Zeichenfläche und Gleisdarstellung."))
            <div class="section">@Lang.T("Design")</div>
            <div class="list">
                @foreach (var x in Core.Design.All)
                {
                    var id = x.Id;
                    <button class="list-item design-choice @(D("design") == id ? "on" : "")" @onclick="@(() => _d["design"] = id)">
                        <span class="design-pic">@((MarkupString)Pictures.DesignPreview(x))</span>
                        <span class="texts"><span class="strong">@x.Name</span><span class="secondary">@x.Description</span></span>
                    </button>
                }
            </div>
            <div class="cols">
                <div>
                    <label class="field-label">@Lang.T("Schriftart")</label>
                    <select class="input" @bind='_d["font"]'>
                        @foreach (var f in UiFonts.All)
                        {
                            <option value="@f.Id">@f.Name</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="field-label">@Lang.T("Schriftgröße")</label>
                    <select class="input" @bind='_d["size"]'>
                        @for (var i = 0; i < UiFonts.Sizes.Count; i++)
                        {
                            <option value="@i">@UiFonts.Sizes[i].Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="font-sample" style="font-family:@Settings.CssFont(UiFonts.Find(D("font")));font-size:@((14 * UiFonts.Sizes[Math.Clamp(int.TryParse(D("size"), out var si) ? si : 1, 0, UiFonts.Sizes.Count - 1)].Scale).ToString(System.Globalization.CultureInfo.InvariantCulture))px">@Lang.T("Gleisplan Bahnhof Neustadt · R 437,5 mm · 2,5 %")</div>
        </div>, wide: true, keepFields: true);
        d.Buttons.Add(new(Lang.T("Abbrechen"), () => true));
        d.Buttons.Add(new(Lang.T("Übernehmen"), () =>
        {
            var size = UiFonts.Sizes[Math.Clamp(int.TryParse(D("size"), out var s) ? s : 1, 0, UiFonts.Sizes.Count - 1)].Scale;
            var chosen = new AppearanceSettings(D("design"), D("font"), size);
            if (chosen != _appearance) ApplyAppearance(chosen);
            return true;
        }, true));
    }

    private void AskLanguage()
    {
        var d = Show("Sprache / Language", @<div class="list">
            @foreach (var (lang, name) in new[] { (Language.Deutsch, "Deutsch"), (Language.English, "English") })
            {
                var chosen = lang;
                <button class="list-item @(lang == Lang.Current ? "on" : "")" @onclick="() => SetLanguage(chosen)"><span class="strong">@name</span></button>
            }
            <div class="secondary">Die Seite wird danach neu geladen; der Plan bleibt erhalten. · The page reloads afterwards; your plan is kept.</div>
        </div>);
        d.Buttons.Add(new("OK", () => true, true));
    }

    private void SetLanguage(Language language)
    {
        if (language == Lang.Current) { CloseDialog(); return; }
        Interop.Js.StorageSet(Settings.LanguageKey, language.ToString());
        SaveNow();
        Interop.Js.Reload();
    }

