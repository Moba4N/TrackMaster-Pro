    {
        _d.Clear();
        foreach (var r in BillOfMaterials.Costs(_session.Plan))
        {
            _d["p|" + r.Key] = r.Price is { } p ? Fmt.Num(p, 2).Replace(Lang.IsEnglish ? "," : ".", "") : "";
