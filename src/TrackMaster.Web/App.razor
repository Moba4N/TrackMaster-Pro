        d.Buttons.Add(new(Lang.T("Maße ändern…"), () => { CloseDialog(); AskBenchwork(); return false; }));
        d.Buttons.Add(new(Lang.T("Kopieren"), () => { _ = Interop.Js.CopyText(b.ToText()); ShowToast(Lang.T("In die Zwischenablage kopiert.")); return false; }));
