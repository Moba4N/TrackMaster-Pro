@using TrackMaster.Licensing
@using Signal = TrackMaster.Core.Signal

@{
    var plan = _session.Plan;
    var stats = plan.Statistics(_session.Connections);
    var selected = _session.Selection.Count;
    var tab = _ribbon.FirstOrDefault(t => t.Name == _tab) ?? _ribbon[0];
}
<div class="shell @(_libraryOpen ? "lib-open" : "") @(_propsOpen ? "props-open" : "")" style="@RootStyle">
    <header class="titlebar">
        <button class="icon-btn only-narrow" title="@Lang.T("Gleisbibliothek")" aria-label="@Lang.T("Gleisbibliothek")" @onclick="@(() => { _libraryOpen = !_libraryOpen; _propsOpen = false; })">@((MarkupString)Icons.Svg("Library", 20))</button>
        <img class="app-logo" src="img/logo-small.png" alt="TrackMaster Pro" title="@Lang.T("Über das Programm")" @onclick="@(() => Run("about"))" />
        <div class="titles">
            <span class="app-name">TrackMaster Pro</span>
            <span class="doc-title" title="@plan.Name">@plan.Name@(_session.Dirty ? " •" : "")</span>
        </div>
        <button class="icon-btn" title="@Lang.T("Rückgängig (Strg+Z)")" disabled="@(!_session.History.CanUndo)" @onclick="@(() => Run("undo"))">@((MarkupString)Icons.Svg("Undo", 20))</button>
        <button class="icon-btn" title="@Lang.T("Wiederholen (Strg+Y)")" disabled="@(!_session.History.CanRedo)" @onclick="@(() => Run("redo"))">@((MarkupString)Icons.Svg("Redo", 20))</button>
        <button class="icon-btn" title="@Lang.T("Verlauf: bis zu 20 Schritte zurück oder vor")" disabled="@(!_session.History.CanUndo && !_session.History.CanRedo)" @onclick="@(() => Run("history"))">@((MarkupString)Icons.Svg("History", 20))</button>
        <button class="edition @(_license.IsPro ? "pro" : "")" title="@_license.Summary" @onclick="@(() => Run("license"))">@_license.EditionName</button>
        <button class="icon-btn only-narrow" title="@Lang.T("Eigenschaften")" aria-label="@Lang.T("Eigenschaften")" @onclick="@(() => { _propsOpen = !_propsOpen; _libraryOpen = false; })">@((MarkupString)Icons.Svg("Properties", 20))</button>
    </header>

    <nav class="ribbon-tabs" role="tablist">
        @foreach (var t in _ribbon)
        {
            var name = t.Name;
            <button role="tab" class="ribbon-tab @(name == _tab ? "on" : "") @(name == Lang.T("Datei") ? "file" : "")" aria-selected="@(name == _tab)" @onclick="() => _tab = name">@name</button>
        }
    </nav>
    <div class="ribbon" role="toolbar">
        @foreach (var g in tab.Groups)
        {
            <div class="ribbon-group">
                <div class="ribbon-items">
                    @foreach (var item in g.Items)
                    {
                        var id = item.Command;
                        var on = Toggles.Contains(id) && IsOn(id);
                        var locked = IsProOnly(id);
                        <button class="rb @(item.Large ? "large" : "small") @(on ? "on" : "")" disabled="@(!CanRun(id))" aria-pressed="@(Toggles.Contains(id) ? on.ToString().ToLowerInvariant() : null)"
                                title="@ItemTip(item, locked)" @onclick="() => Run(id)">
                            <span class="rb-icon">@((MarkupString)Icons.Svg(item.Icon, item.Large ? 28 : 18))@if (locked)
                                {
                                    <span class="lock">@((MarkupString)Icons.Svg("Lock", 11))</span>
                                }</span>
                            <span class="rb-label">@item.Label</span>
                        </button>
                    }
                </div>
                <div class="ribbon-group-name">@g.Name</div>
            </div>
        }
    </div>

    <main class="work">
        <aside class="pane library-pane" aria-label="@Lang.T("Gleisbibliothek")">
            <LibraryPanel @ref="_library" Session="_session" Center="Center" AppearanceVersion="_appearanceVersion"
                          OnFlex="s => { _libraryOpen = false; AskFlex(s); }" OnPicked="() => _libraryOpen = false" OnClose="() => { _libraryOpen = false; StateHasChanged(); }" />
        </aside>
        <section class="stage">
            <div class="canvas-host">
                <canvas id="plan-canvas" tabindex="0" aria-label="@Lang.T("Gleisplan")"></canvas>
            </div>
            @if (_session.Tool is not (CanvasTool.Select))
            {
                var polygon = _session.Tool is CanvasTool.Terrain or CanvasTool.Water;
                <div class="toolbar">
                    <span class="tool-text">@ToolText</span>
                    @if (polygon)
                    {
                        <button class="btn" disabled="@(_view.PolygonPoints == 0)" @onclick="() => _view.UndoPolygonPoint()">@Lang.T("Punkt zurück")</button>
                        <button class="btn accent" disabled="@(_view.PolygonPoints < 3)" @onclick="() => _view.FinishPolygon()">@Lang.T("Fertig")</button>
                    }
                    <button class="btn" @onclick="() => SetTool(CanvasTool.Select)">@Lang.T("Beenden")</button>
                </div>
            }
            @if (_toast is not null)
            {
                <div class="toast" role="status" @onclick="() => _toast = null">@_toast</div>
            }
            <div class="zoom">
                <button class="icon-btn float" title="@Lang.T("Vergrößern (+)")" @onclick="@(() => Run("zoomIn"))">@((MarkupString)Icons.Svg("ZoomIn", 20))</button>
                <button class="icon-btn float" title="@Lang.T("Verkleinern (-)")" @onclick="@(() => Run("zoomOut"))">@((MarkupString)Icons.Svg("ZoomOut", 20))</button>
                <button class="icon-btn float" title="@Lang.T("Ganze Anlage (0)")" @onclick="@(() => Run("fit"))">@((MarkupString)Icons.Svg("Fit", 20))</button>
            </div>
        </section>
        <aside class="pane props-pane" aria-label="@Lang.T("Eigenschaften")">
            <PropertiesPanel Session="_session" Version="_version" Run="Run" OnClose="() => { _propsOpen = false; StateHasChanged(); }" />
        </aside>
        <div class="scrim" @onclick="@(() => { _libraryOpen = false; _propsOpen = false; })"></div>
    </main>

    <footer class="statusbar">
        <span class="st-item">@Lang.F($"Spur {plan.GaugeId}")</span>
        <span class="st-item">@Lang.F($"{stats.Pieces} Gleise")</span>
        <span class="st-item hide-narrow">@Lang.F($"{stats.Switches} Weichen")</span>
        <span class="st-item">@Fmt.Num(stats.TrackLengthMm / 1000, 2) m</span>
        <span class="st-item @(stats.OpenEnds > 0 ? "warn" : "ok")">@Lang.F($"offene Enden {stats.OpenEnds}")</span>
        @if (selected > 0)
        {
            <span class="st-item">@Lang.F($"{selected} gewählt")</span>
        }
        <span class="st-spacer"></span>
        <span class="st-item hide-narrow" id="status-xy"></span>
        <span class="st-item hide-narrow">@_zoomText</span>
        <button class="st-toggle @(_session.SnapEnabled ? "on" : "")" title="@Lang.T("Gleise rasten an freien Enden ein")" @onclick="@(() => Run("snap"))">@Lang.T("Einrasten")</button>
        <button class="st-toggle @(_session.ShowGrid ? "on" : "")" title="@Lang.T("Raster anzeigen")" @onclick="@(() => Run("grid"))">@Lang.T("Raster")</button>
    </footer>

    @if (_open3D)
    {
        <div class="view3d" role="dialog" aria-label="@Lang.T("3D-Ansicht")">
            <div class="view3d-bar">
                <div class="row">
                    <button class="btn @(!_riding ? "on" : "")" @onclick="Orbit3D">@Lang.T("Rundumsicht")</button>
                    <button class="btn @(_riding ? "on" : "")" @onclick="ToggleRide">@Lang.T("Mitfahren")</button>
                    <button class="btn @(_trainOn ? "on" : "")" @onclick="ToggleTrain">@Lang.T("Zug")</button>
                    <button class="btn" disabled="@(!(_riding || _trainOn))" title="@Lang.T("Nächste Weiche vor dem Zug umstellen")" @onclick="ToggleNextSwitch">@Lang.T("Weiche")</button>
                    <span class="status3d">@_status3D</span>
                    <button class="btn accent" @onclick="Close3D">@Lang.T("Schließen")</button>
                </div>
                <div class="row">
                    <button class="btn @(_scenery3D ? "on" : "")" title="@Lang.T("Gelände, Gewässer, Gebäude und Bäume zeigen")" @onclick="@(() => SetScenery3D(true))">@Lang.T("Mit Gelände")</button>
                    <button class="btn @(!_scenery3D ? "on" : "")" title="@Lang.T("Nur Platte, Gleise und Pfeiler zeigen")" @onclick="@(() => SetScenery3D(false))">@Lang.T("Nur Gleisplan")</button>
                    <span class="secondary small" style="margin-left:12px">@Lang.T("Drehen:")</span>
                    <button class="btn" disabled="@_riding" title="@Lang.T("Um die Querachse kippen (X)")" @onclick="@(() => Js.GlTurn(0, 15))">X ↻</button>
                    <button class="btn" disabled="@_riding" title="@Lang.T("Um die Hochachse drehen (Y)")" @onclick="@(() => Js.GlTurn(1, 15))">Y ↻</button>
                    <button class="btn" disabled="@_riding" title="@Lang.T("Um die Blickachse drehen (Z)")" @onclick="@(() => Js.GlTurn(2, 15))">Z ↻</button>
                    <button class="btn" disabled="@_riding" @onclick="@(() => Js.GlTurn(-1, 0))">@Lang.T("Gerade")</button>
                </div>
                <div class="row sliders">
                    <label class="slider"><span>@Lang.T("Tageszeit")</span><input type="range" min="0" max="72" value="@_hourStep" @oninput="SetHour" /><span class="value">@DayLight.TimeText(Hour)</span></label>
                    <label class="slider"><span>@Lang.T("Tempo")</span><input type="range" min="0" max="150" value="@_speedStep" @oninput="SetSpeed" /><span class="value">@($"{Speed:0} km/h")</span></label>
                </div>
            </div>
            <div class="view3d-host"><canvas id="view3d-canvas"></canvas></div>
            <div class="view3d-help">@Lang.T("Ziehen dreht und kippt (auch von unten) · Strg + Ziehen dreht um die Blickachse · rechte Maustaste oder Umschalt + Ziehen verschiebt · Mausrad oder zwei Finger zoomen · Mitfahren startet am gewählten Gleis")</div>
        </div>
    }

    @if (_dialog is { } dialog)
    {
        <div class="modal-back" @onclick="CloseDialog"></div>
        <div class="modal @(dialog.Wide ? "wide" : "")" role="dialog" aria-modal="true" aria-label="@dialog.Title">
            <div class="modal-head">
                <span class="modal-title">@dialog.Title</span>
                <button class="icon-btn" title="@Lang.T("Schließen")" @onclick="CloseDialog">@((MarkupString)Icons.Svg("Close", 18))</button>
            </div>
            <div class="modal-body">
                @dialog.Body
                @if (dialog.Error is { Length: > 0 } error)
                {
                    <div class="error-box">@error</div>
                }
            </div>
            @if (dialog.Buttons.Count > 0)
            {
                <div class="modal-foot">
                    @foreach (var b in dialog.Buttons)
                    {
                        var button = b;
                        <button class="btn @(button.Accent ? "accent" : "")" @onclick="() => Click(button)">@button.Label</button>
                    }
                </div>
            }
        </div>
    }
</div>

