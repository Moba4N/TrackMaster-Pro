    // ---------- Ebenen ----------

    private sealed class LevelRow
    {
        public int Index { get; init; } = -1;
        public string Name { get; set; } = "";
        public string H { get; set; } = "";
        public bool Visible { get; set; } = true;
    }

    private List<LevelRow> _levels = [];
    private int _activeLevel;

    private void AskLevels()
    {
        var plan = _session.Plan;
        _levels = plan.Levels.Select((l, i) => new LevelRow { Index = i, Name = l.Name, H = N(l.Height), Visible = l.Visible }).ToList();
        _activeLevel = plan.ActiveLevel;
        var selected = _session.Selection.Count + (_session.SelectedObject is null ? 0 : 1);
        var d = Show(Lang.T("Ebenen"), @<div class="form">
            @Hint(Lang.T("Neue Gleise kommen auf die aktive Ebene und beginnen in ihrer Grundhöhe. Ausgeblendete Ebenen fehlen in Plan und 3D-Ansicht, bleiben aber in Stückliste und Planprüfung. Ändert sich die Grundhöhe, wandern die Gleise der Ebene mit."))
            <table class="table modules">
                <tr><th title="@Lang.T("Aktive Ebene")">@Lang.T("Aktiv")</th><th title="@Lang.T("Sichtbar")">👁</th><th>@Lang.T("Name")</th><th>@Lang.T("Grundhöhe")</th><th></th><th></th></tr>
                @for (var i = 0; i < _levels.Count; i++)
                {
                    var k = i;
                    var row = _levels[k];
                    <tr>
                        <td><input type="radio" name="activeLevel" checked="@(_activeLevel == k)" @onchange="@(() => { _activeLevel = k; row.Visible = true; })" /></td>
                        <td><input type="checkbox" title="@Lang.T("Sichtbar")" @bind="row.Visible" /></td>
                        <td><input class="input" @bind="row.Name" /></td>
                        <td><input class="input" inputmode="decimal" @bind="row.H" /></td>
                        <td><button class="btn" title="@Lang.T("Nur diese Ebene zeigen")" @onclick="@(() => { foreach (var r in _levels) r.Visible = r == row; _activeLevel = k; })">@Lang.T("Nur diese")</button></td>
                        <td><button class="btn" title="@Lang.T("Ebene entfernen – ihre Gleise kommen auf die Ebene darunter")" disabled="@(_levels.Count < 2)" @onclick="@(() => RemoveLevelRow(k))">✕</button></td>
                    </tr>
                }
            </table>
            <div class="button-row">
                <button class="btn" disabled="@(_levels.Count >= LayoutPlan.MaxLevels)" @onclick="AddLevelRow">@Lang.T("Ebene hinzufügen")</button>
                <button class="btn" @onclick="@(() => { foreach (var r in _levels) r.Visible = true; })">@Lang.T("Alle zeigen")</button>
                <button class="btn" disabled="@(selected == 0)" title="@Lang.T("Gewählte Gleise bzw. das gewählte Objekt auf die aktive Ebene legen")" @onclick="MoveSelectionToActiveLevel">@Lang.F($"Gewählte ({selected}) auf aktive Ebene")</button>
            </div>
        </div>, wide: true, keepFields: true);
        d.Buttons.Add(new(Lang.T("Abbrechen"), () => true));
        d.Buttons.Add(new(Lang.T("Übernehmen"), () => ApplyLevelRows(), true));
    }

    private void AddLevelRow()
    {
        if (_levels.Count >= LayoutPlan.MaxLevels) return;
        var top = _levels.Select(r => Fmt.Parse(r.H) ?? 0).DefaultIfEmpty(0).Max();
        _levels.Add(new LevelRow { Name = PlanLevel.DefaultName(_levels.Count), H = N(top + _session.Plan.LevelStep) });
        _activeLevel = _levels.Count - 1;
    }

    private void RemoveLevelRow(int k)
    {
        if (_levels.Count < 2) return;
        _levels.RemoveAt(k);
        if (_activeLevel >= k) _activeLevel = Math.Max(0, _activeLevel - 1);
    }

    private bool ApplyLevelRows()
    {
        var errors = new List<string>();
        var edits = new List<LevelEdit>();
        foreach (var (r, i) in _levels.Select((r, i) => (r, i)))
        {
            if (Fmt.Parse(r.H) is not { } h || h < -1000 || h > 5000) { errors.Add(Lang.F($"Ebene {i + 1}: Grundhöhe zwischen −1000 und 5000 mm.")); continue; }
            edits.Add(new LevelEdit(r.Index, r.Name, h, r.Visible || i == _activeLevel));
        }
        if (!Fail(errors)) return false;
        _session.ApplyLevels(edits, _activeLevel);
        return true;
    }

    private void MoveSelectionToActiveLevel()
    {
        if (!ApplyLevelRows()) return;
        CloseDialog();
        _session.MoveSelectionToLevel(_session.Plan.ActiveLevel);
    }

    // ---------- Schenkel einzeln ----------

    private void AskLegs()
    {
        var plan = _session.Plan;
        if (!BoardGeometry.HasLegs(plan.BoardShape)) { _propsOpen = true; return; }
        var names = BoardGeometry.LegNames(plan.BoardShape);
        var resolved = BoardGeometry.ResolvedLegs(plan);
        _d.Clear();
        for (var i = 0; i < names.Count; i++)
        {
            var own = i < plan.BoardLegs.Count ? plan.BoardLegs[i] : new BoardLeg(0, 0);
            _d[$"ld{i}"] = own.Depth > 0 ? N(resolved[i].Depth) : "";
            var ownLength = plan.BoardShape == BoardShape.U && i < 2 ? (i == 0 ? plan.BoardLegLeft : plan.BoardLegRight) : own.Length;
            _d[$"ll{i}"] = ownLength > 0 && BoardGeometry.LegHasLength(plan.BoardShape, i) ? N(resolved[i].Length) : "";
        }
        var d = Show(Lang.T("Schenkel einzeln"), @<div class="form">
            @Hint(Lang.F($"{BoardGeometry.Name(plan.BoardShape)}: Tiefe und Länge jedes Schenkels in mm. Leere Felder nehmen die gemeinsame Schenkeltiefe ({Fmt.Num(BoardGeometry.Depth(plan.BoardShape, plan.BoardWidth, plan.BoardHeight, plan.BoardDepth, plan.BoardTurn), 0)} mm) bzw. die volle Länge. Mit „Platte ziehen“ lassen sich die runden Griffe auch mit der Maus ziehen."))
            <table class="table modules">
                <tr><th>@Lang.T("Schenkel")</th><th>@Lang.T("Tiefe")</th><th>@Lang.T("Länge")</th></tr>
                @for (var i = 0; i < names.Count; i++)
                {
                    var k = i;
                    <tr>
                        <td>@names[k]</td>
                        <td><input class="input" inputmode="decimal" placeholder="@N(resolved[k].Depth)" @bind='_d[$"ld{k}"]' /></td>
                        <td>
                            @if (BoardGeometry.LegHasLength(plan.BoardShape, k))
                            {
                                <input class="input" inputmode="decimal" placeholder="@N(resolved[k].Length)" @bind='_d[$"ll{k}"]' />
                            }
                            else
                            {
                                <span class="secondary small">@Lang.T("durch Außenmaß")</span>
                            }
                        </td>
                    </tr>
                }
            </table>
        </div>, keepFields: true);
        d.Buttons.Add(new(Lang.T("Alle zurücksetzen"), () => { _session.Edit(() => BoardGeometry.ResetLegs(plan)); return true; }));
        d.Buttons.Add(new(Lang.T("Abbrechen"), () => true));
        d.Buttons.Add(new(Lang.T("Übernehmen"), () =>
        {
            var errors = new List<string>();
            var values = new List<(double Depth, double Length)>();
            for (var i = 0; i < names.Count; i++)
            {
                double dep = 0, len = 0;
                if (D($"ld{i}").Trim().Length > 0) Read($"ld{i}", Lang.F($"{names[i]} Tiefe"), 50, 50000, errors, out dep);
                if (BoardGeometry.LegHasLength(plan.BoardShape, i) && D($"ll{i}").Trim().Length > 0) Read($"ll{i}", Lang.F($"{names[i]} Länge"), 50, 50000, errors, out len);
                values.Add((dep, len));
            }
            if (!Fail(errors)) return false;
            _session.Edit(() =>
            {
                BoardGeometry.ResetLegs(plan);
                for (var i = 0; i < values.Count; i++) BoardGeometry.SetLeg(plan, i, values[i].Depth, values[i].Length);
            });
            _session.Say(BoardGeometry.Describe(plan));
            return true;
        }, true));
    }

    private List<ModuleEdit> ModuleEdits(List<string> errors)
    {
        var edits = new List<ModuleEdit>();
        foreach (var (m, i) in _modules.Select((m, i) => (m, i)))
        {
            double? x = Fmt.Parse(m.X), y = Fmt.Parse(m.Y), w = Fmt.Parse(m.W), dd = Fmt.Parse(m.D);
            var z = m.Z.Trim().Length == 0 ? 0 : Fmt.Parse(m.Z);
            var t = m.T.Trim().Length == 0 ? 0 : Fmt.Parse(m.T);
            if (x is null || y is null || w is null || dd is null || z is null || t is null) { errors.Add(Lang.F($"Modul {i + 1}: bitte Zahlen eingeben.")); continue; }
            if (z < ModuleLayout.MinHeight || z > ModuleLayout.MaxHeight)
            {
                errors.Add(Lang.F($"Modul {i + 1}: Höhe Z zwischen {Fmt.Num(ModuleLayout.MinHeight, 0)} und {Fmt.Num(ModuleLayout.MaxHeight, 0)} mm."));
                continue;
            }
            if (t < 0 || t > ModuleLayout.MaxThickness)
            {
                errors.Add(Lang.F($"Modul {i + 1}: Plattenstärke zwischen 0 und {Fmt.Num(ModuleLayout.MaxThickness, 0)} mm (leer = Standard)."));
                continue;
            }
            if (w < ModuleLayout.MinSize || dd < ModuleLayout.MinSize || w > ModuleLayout.MaxSize || dd > ModuleLayout.MaxSize)
            {
                errors.Add(Lang.F($"Modul {i + 1}: Breite und Tiefe zwischen {Fmt.Num(ModuleLayout.MinSize, 0)} und {Fmt.Num(ModuleLayout.MaxSize, 0)} mm."));
                continue;
            }
            edits.Add(new ModuleEdit(m.Index, m.Name, x.Value, y.Value, w.Value, dd.Value, z.Value, t.Value));
        }
        return edits;
    }

    private void MergeModuleRows()
    {
        var errors = new List<string>();
        var edits = ModuleEdits(errors);
        if (errors.Count > 0) { _session.Say(errors[0]); return; }
        var pick = _modules.Select((m, i) => (m, i)).Where(t => t.m.Pick).Select(t => t.i).ToList();
        var (rows, error) = ModuleLayout.Merge(edits, pick);
        if (rows is null) { _session.Say(error!); return; }
        _modules = rows.Select(Row).ToList();
    }

    private int _splitIndex, _joinMove = 1, _joinTarget, _joinSide;
    private bool _splitAcross = true, _joinLong = true;
    private string _splitAt = "";

    private void SplitModuleRow()
    {
        var errors = new List<string>();
        var edits = ModuleEdits(errors);
        if (errors.Count > 0) { _session.Say(errors[0]); return; }
        if (_splitIndex < 0 || _splitIndex >= edits.Count) return;
        var m = edits[_splitIndex];
        var at = Fmt.Parse(_splitAt) ?? (_splitAcross ? m.Width : m.Depth) / 2;
        var (rows, error) = ModuleLayout.Split(edits, _splitIndex, _splitAcross, at);
        if (rows is null) { _session.Say(error!); return; }
        _modules = rows.Select(Row).ToList();
        _splitAt = "";
    }

    private void JoinModuleRows()
    {
        var errors = new List<string>();
        var edits = ModuleEdits(errors);
        if (errors.Count > 0) { _session.Say(errors[0]); return; }
        var (rows, error) = ModuleLayout.Join(edits, _joinMove, _joinTarget, _joinSide, _joinLong);
        if (rows is null) { _session.Say(error!); return; }
        var picks = _modules.Select(m => m.Pick).ToList();
        _modules = rows.Select(Row).ToList();
        for (var i = 0; i < picks.Count && i < _modules.Count; i++) _modules[i].Pick = picks[i];
    }

