    private void AskScaleBackground()
    {
        var dim = _session.SelectedObject is { } id ? _session.Plan.Scenery.FirstOrDefault(s => s.Id == id && s.Kind == SceneryKind.Dimension) : null;
        if (dim is null || dim.Points.Count != 2)
        {
            Message(Lang.T("Nach Maß skalieren"), Lang.T("So geht’s: Mit dem Werkzeug „Maß“ (Start › Beschriften) eine Linie über eine Strecke im Bild ziehen, deren echte Länge du kennst – z. B. eine Wand oder ein Gleis. Die Maßlinie anklicken und dann hier die echte Länge eingeben."));
            return;
        }
        var measured = Math.Sqrt(Math.Pow(dim.Points[1].X - dim.Points[0].X, 2) + Math.Pow(dim.Points[1].Y - dim.Points[0].Y, 2));
        _d.Clear();
        _d["len"] = N(measured);
        var d = Show(Lang.T("Nach Maß skalieren"), @<div class="form">
            @Hint(Lang.F($"Die gewählte Maßlinie misst im Bild jetzt {Fmt.Num(measured, 0)} mm. Wie lang ist diese Strecke in Wirklichkeit? Das Bild wird passend vergrößert oder verkleinert."))
            <label class="field-label">@Lang.T("Echte Länge (mm)")</label>
            <input class="input" inputmode="decimal" @bind='_d["len"]' @bind:event="oninput" />
        </div>, keepFields: true);
        d.Buttons.Add(new(Lang.T("Abbrechen"), () => true));
        d.Buttons.Add(new(Lang.T("Skalieren"), () =>
        {
            var errors = new List<string>();
            Read("len", Lang.T("Länge"), 1, 1000000, errors, out var len);
            if (!Fail(errors)) return false;
            _session.ScaleBackground(len);
            return true;
        }, true));
    }

