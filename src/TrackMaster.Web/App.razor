    // ---------- Unterbau ----------

    private void AskBenchwork()
    {
        var plan = _session.Plan;
        var s = plan.Benchwork ?? BenchworkSpec.Defaults(plan.Gauge);
        _d.Clear();
        _d["height"] = N(s.Height); _d["top"] = N(s.TopThickness); _d["ft"] = N(s.FrameThickness); _d["fh"] = N(s.FrameHeight); _d["cross"] = N(s.CrossSpacing);
        _d["style"] = ((int)s.LegStyle).ToString(); _d["lw"] = N(s.LegWidth); _d["ld"] = N(s.LegDepth); _d["lspace"] = N(s.LegSpacing);
        _d["braces"] = s.Braces ? "1" : ""; _d["bh"] = N(s.BraceHeight); _d["feet"] = s.Feet ? "1" : ""; _d["foot"] = N(s.FootHeight);
        _d["stock"] = N(s.StockLength); _d["sw"] = N(s.SheetWidth); _d["sd"] = N(s.SheetDepth);
        _d["manual"] = s.Manual ? "1" : "";
        void Fill(BenchworkSpec v)
        {
            _d["height"] = N(v.Height); _d["top"] = N(v.TopThickness); _d["ft"] = N(v.FrameThickness); _d["fh"] = N(v.FrameHeight); _d["cross"] = N(v.CrossSpacing);
            _d["style"] = ((int)v.LegStyle).ToString(); _d["lw"] = N(v.LegWidth); _d["ld"] = N(v.LegDepth); _d["lspace"] = N(v.LegSpacing);
            _d["braces"] = v.Braces ? "1" : ""; _d["bh"] = N(v.BraceHeight); _d["feet"] = v.Feet ? "1" : ""; _d["foot"] = N(v.FootHeight);
            _d["manual"] = v.Manual ? "1" : "";
        }
        RenderFragment Field(string key, string label) => @<div><label class="field-label">@label</label><input class="input" inputmode="decimal" @bind='_d[key]' @bind:event="oninput" /></div>;
        var d = Show(Lang.T("Unterbau"), @<div class="form">
            @Hint(Lang.F($"Holzkonstrukt unter der Platte ({BoardGeometry.Describe(plan)}): Zargen rundum und Querriegel unter jedem Plattenteil, Beine innen in den Ecken und entlang der langen Seiten. Alle Maße in mm. Die 3D-Ansicht zeigt den Unterbau."))
            <div class="cols">
                <div>
                    <label class="field-label">@Lang.T("Vorlage übernehmen")</label>
                    <select class="input" value="" @onchange="@(e => { if (BenchTemplate.Find(e.Value?.ToString()) is { } bt) Fill(bt.Spec(plan.Gauge)); })">
                        <option value="">…</option>
                        @foreach (var bt in BenchTemplate.All)
                        {
                            <option value="@bt.Id">@bt.Name</option>
                        }
                    </select>
                </div>
                <div><label class="field-label"><input type="checkbox" checked="@(D("manual") == "1")" @onchange="@(e => _d["manual"] = e.Value is true ? "1" : "")" /> @Lang.T("Rahmen selbst zeichnen")</label>
                    <div class="secondary">@Lang.T("Nur eigene Leisten und aufgelegte Deckplatten (Gelände › Leiste ziehen, Platte auflegen), kein berechneter Rahmen.")</div></div>
                @Field("height", Lang.T("Höhe Oberkante Platte über Boden"))
                @Field("top", Lang.T("Plattenstärke (0 = offener Rahmen)"))
                @Field("ft", Lang.T("Latte für Rahmen: Stärke"))
                @Field("fh", Lang.T("Latte für Rahmen: Höhe"))
                @Field("cross", Lang.T("Querriegel höchstens alle"))
                <div>
                    <label class="field-label">@Lang.T("Beine")</label>
                    <select class="input" @bind='_d["style"]'>
                        <option value="0">@Lang.T("Kantholz")</option>
                        <option value="1">@Lang.T("L-Bein aus zwei Latten")</option>
                    </select>
                </div>
                @Field("lw", Lang.T("Bein: Breite"))
                @Field("ld", Lang.T("Bein: Tiefe"))
                @Field("lspace", Lang.T("Beine höchstens alle"))
                <div><label class="field-label"><input type="checkbox" checked="@(D("braces") == "1")" @onchange="@(e => _d["braces"] = e.Value is true ? "1" : "")" /> @Lang.T("Fußtraversen in Höhe")</label><input class="input" inputmode="decimal" @bind='_d["bh"]' @bind:event="oninput" /></div>
                <div><label class="field-label"><input type="checkbox" checked="@(D("feet") == "1")" @onchange="@(e => _d["feet"] = e.Value is true ? "1" : "")" /> @Lang.T("Stellfüße, Höhe")</label><input class="input" inputmode="decimal" @bind='_d["foot"]' @bind:event="oninput" /></div>
                @Field("stock", Lang.T("Lattenlänge im Handel"))
                @Field("sw", Lang.T("Plattenformat: Breite"))
                @Field("sd", Lang.T("Plattenformat: Tiefe"))
            </div>
        </div>, wide: true, keepFields: true);
        if (plan.Benchwork is not null) d.Buttons.Add(new(Lang.T("Entfernen"), () => { _session.SetBenchwork(null); return true; }));
        d.Buttons.Add(new(Lang.T("Abbrechen"), () => true));
        d.Buttons.Add(new(Lang.T("Übernehmen"), () =>
        {
            var errors = new List<string>();
            double V(string key) => Fmt.Parse(D(key)) ?? double.NaN;
            var spec = new BenchworkSpec
            {
                Height = V("height"), TopThickness = V("top"), FrameThickness = V("ft"), FrameHeight = V("fh"), CrossSpacing = V("cross"),
                LegStyle = D("style") == "1" ? BenchLegStyle.LBein : BenchLegStyle.Kantholz, LegWidth = V("lw"), LegDepth = V("ld"), LegSpacing = V("lspace"),
                Braces = D("braces") == "1", BraceHeight = V("bh"), Feet = D("feet") == "1", FootHeight = V("foot"),
                StockLength = V("stock"), SheetWidth = V("sw"), SheetDepth = V("sd"), Manual = D("manual") == "1",
            };
            errors.AddRange(Benchwork.Validate(spec));
            if (!Fail(errors)) return false;
            _session.SetBenchwork(spec);
            CloseDialog();
            ShowBenchwork();
            return false;
        }, true));
    }

