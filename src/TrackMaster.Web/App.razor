    private void ShowIssues(string title, IReadOnlyList<PlanIssue> issues, string? footer)
    {
        var d = Show(title, @<div class="list">
            @if (issues.Count == 0)
            {
                <div class="ok strong">@Lang.T("Keine Probleme gefunden.")</div>
            }
            else
            {
                var e = issues.Count(i => i.Level == IssueLevel.Fehler);
                var w = issues.Count(i => i.Level == IssueLevel.Warnung);
                <div class="secondary">@Lang.F($"{e} Fehler · {w} Warnungen · {issues.Count - e - w} Hinweise – ein Klick zeigt die Stelle.")</div>
                @foreach (var issue in issues)
                {
                    var target = issue;
                    var cls = issue.Level switch { IssueLevel.Fehler => "danger", IssueLevel.Warnung => "warn", _ => "accent" };
                    <button class="list-item" @onclick="() => PickIssue(target)">
                        <span class="strong small @cls">@($"{issue.Level.Text()} · {issue.Category}")</span>
                        <span>@issue.Text</span>
                    </button>
                }
            }
            @if (footer is not null)
            {
                @Hint(footer)
            }
        </div>, wide: true);
        d.Buttons.Add(new(Lang.T("Schließen"), () => true, true));
    }

    private void ShowBillOfMaterials()
    {
        var plan = _session.Plan;
        var rows = BillOfMaterials.Build(plan);
        var extras = BillOfMaterials.Accessories(plan);
        var stats = plan.Statistics();
        var d = Show(Lang.T("Stückliste"), @<div class="list">
            <div class="secondary">@Lang.F($"{plan.Name} · Spur {plan.GaugeId} · {stats.Pieces} Teile · {Fmt.Num(stats.TrackLengthMm / 1000, 2)} m Gleis")</div>
            @if (rows.Count == 0)
            {
                <div>@Lang.T("Der Plan enthält noch keine Gleise.")</div>
            }
            <table class="table">
                @foreach (var r in rows)
                {
                    <tr><td class="count">@($"{r.Count}×")</td><td><div>@($"{r.Def.Number} · {r.Def.Name}")</div><div class="secondary">@($"{r.Def.Spec} · {r.Def.SystemName}")</div></td></tr>
                }
            </table>
            @if (extras.Count > 0)
            {
                <div class="section">@Lang.T("Zubehör")</div>
                <table class="table">
                    @foreach (var a in extras)
                    {
                        <tr><td class="count">@($"{a.Count}×")</td><td>@($"{a.Name} – {a.Detail}")</td></tr>
                    }
                </table>
            }
        </div>, wide: true);
        d.Buttons.Add(new(_license.IsPro ? Lang.T("Als CSV speichern") : Lang.T("CSV (Pro)"), () => { Run("csv"); return false; }));
        d.Buttons.Add(new(Lang.T("Schließen"), () => true, true));
    }

    private void ShowAddresses()
    {
        _d.Clear();
        _d["first"] = "1";
        _d["missing"] = "1";
        var d = Show(Lang.T("Decoder und Adressen"), AddressesBody, wide: true, keepFields: true);
        d.Buttons.Add(new(Lang.T("Kabelplan"), () => { ShowWiring(); return false; }));
        d.Buttons.Add(new(Lang.T("Schließen"), () => true, true));
    }

    private RenderFragment AddressesBody => @<div class="form">
        @{
            var items = Electrics.SwitchingItems(_session.Plan);
            var conflicts = Electrics.AddressConflicts(items).SelectMany(x => x.Items).ToHashSet();
        }
        @Hint(Lang.T("Weichen belegen eine Adresse, DKW und Hauptsignale zwei (Hp0/Hp1/Hp2). Ein Weichendecoder hat vier Ausgänge: Adressen 1–4 = Decoder 1, 5–8 = Decoder 2 usw."))
        <div class="button-row">
            <button class="btn" @onclick="AssignAddresses">@Lang.T("Vergeben ab")</button>
            <input class="input narrow" inputmode="numeric" @bind='_d["first"]' />
            <label class="check"><input type="checkbox" checked="@(D("missing") == "1")" @onchange="@(e => _d["missing"] = e.Value is true ? "1" : "")" /> @Lang.T("nur fehlende")</label>
        </div>
        @if (items.Count == 0)
        {
            <div class="secondary">@Lang.T("Der Plan hat noch keine Weichen oder Signale.")</div>
        }
        <div class="list">
            @foreach (var it in items)
            {
                var item = it;
                <div class="list-item static address-row">
                    <span class="texts">
                        <span class="@(conflicts.Contains(it) ? "danger" : "")">@it.Label</span>
                        <span class="secondary small">@Lang.F($"{it.Kind} · Decoder {it.Decoder?.ToString() ?? "–"}, Ausgang {it.Port?.ToString() ?? "–"}")</span>
                    </span>
                    <input class="input narrow" inputmode="numeric" value="@(it.Address?.ToString() ?? "")" @onchange="e => SetAddress(item, e.Value?.ToString())" />
                </div>
            }
        </div>
    </div>;

    private void AssignAddresses()
    {
        var first = Math.Clamp((int)(Fmt.Parse(D("first")) ?? 1), 1, 2048);
        _session.AssignAddresses(first, D("missing") == "1");
    }

    private void SetAddress(SwitchingItem item, string? text)
    {
        var t = (text ?? "").Trim();
        int? value = t.Length == 0 ? null : int.TryParse(t, out var v) && v is > 0 and <= 2048 ? v : -1;
        if (value == -1) { ShowToast(Lang.T("Adressen von 1 bis 2048.")); return; }
        if (value == item.Address) return;
        _session.Edit(() =>
        {
            if (item.PieceId is { } pid && _session.Plan.Find(pid) is { } p) p.Address = value;
            else if (_session.Plan.Signals.FirstOrDefault(s => s.Id == item.SignalId) is { } s) s.Address = value;
        });
    }

    private void ShowText(string title, string text, string saveLabel, Action save)
    {
        var d = Show(title, @<pre class="mono">@text</pre>, wide: true);
        d.Buttons.Add(new(Lang.T("Kopieren"), () => { _ = Interop.Js.CopyText(text); ShowToast(Lang.T("In die Zwischenablage kopiert.")); return false; }));
        d.Buttons.Add(new(saveLabel, () => { save(); return false; }));
        d.Buttons.Add(new(Lang.T("Schließen"), () => true, true));
    }

    // ---------- Drucken ----------

    private void AskPrint()
    {
        _d.Clear();
        _d["mode"] = "overview";
        var tiles = PrintPages.Tiles(_session.Plan).Count;
        var d = Show(Lang.T("Drucken"), @<div class="form">
            <label class="radio"><input type="radio" name="print" checked="@(D("mode") == "overview")" @onchange="@(() => _d["mode"] = "overview")" /> @Lang.T("Übersicht auf einer Seite (A4 quer, verkleinert, mit Stückliste)")</label>
            <label class="radio"><input type="radio" name="print" checked="@(D("mode") == "full")" @onchange="@(() => _d["mode"] = "full")" /> @Lang.F($"Bauvorlage im Maßstab 1:1 auf {tiles} Seiten (A4 hoch)")</label>
            @Hint(Lang.T("Die Bauvorlage hat 10 mm Klebekante, Passmarken alle 100 mm und auf jeder Seite ein Prüfmaß von 100 mm. ") +
                  Lang.T("Im Druckdialog „Tatsächliche Größe“ bzw. 100 % und „Ränder: keine“ einstellen und das Prüfmaß nachmessen. Als Drucker lässt sich auch „Als PDF speichern“ wählen."))
        </div>, keepFields: true);
        d.Buttons.Add(new(Lang.T("Abbrechen"), () => true));
        d.Buttons.Add(new(Lang.T("Drucken"), () =>
        {
            Interop.Js.Print(PrintPages.Html(_session.Plan, _license.IsPro, D("mode") == "full"));
