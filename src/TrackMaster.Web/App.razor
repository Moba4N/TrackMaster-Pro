    // ---------- Einfache Dialoge ----------

    private RenderFragment MessageBody(string text) => @<p class="message">@text</p>;

    private RenderFragment Hint(string text) => @<div class="tip-box">@text</div>;

    private void AskText(string title, string label, string value, Action<string> apply)
    {
        _d.Clear();
        _d["text"] = value;
        var d = Show(title, @<div class="form">
            <label class="field-label" for="dlg-text">@label</label>
            <input id="dlg-text" class="input" @bind='_d["text"]' @bind:event="oninput" @onkeydown="@(e => { if (e.Key == "Enter") ConfirmText(apply); })" />
        </div>, keepFields: true);
        d.Buttons.Add(new(Lang.T("Abbrechen"), () => true));
        d.Buttons.Add(new(Lang.T("Übernehmen"), () => ConfirmText(apply, close: false), true));
        _ = FocusLater("dlg-text");
    }

    private bool ConfirmText(Action<string> apply, bool close = true)
    {
        var text = D("text").Trim();
        if (text.Length == 0) return false;
        apply(text);
        if (close) CloseDialog();
        return true;
    }

    private async Task FocusLater(string id)
    {
        await Task.Delay(30);
        Interop.Js.Focus(id);
    }

    private void AskAngle(string title, string hint, double value, string action, Action<double> apply)
    {
        _d.Clear();
        _d["angle"] = N(value, 1);
        var d = Show(title, @<div class="form">
            @Hint(hint)
            <label class="field-label" for="dlg-angle">@Lang.T("Winkel (°, positiv = im Uhrzeigersinn)")</label>
            <input id="dlg-angle" class="input" inputmode="decimal" @bind='_d["angle"]' @bind:event="oninput" />
            <div class="button-row equal">
                @foreach (var a in new[] { -90, -45, -15, 15, 45, 90 })
                {
                    var angle = a;
                    <button class="btn" @onclick="@(() => _d["angle"] = N(angle, 1))">@($"{(angle > 0 ? "+" : "")}{angle}°")</button>
                }
            </div>
        </div>, keepFields: true);
        d.Buttons.Add(new(Lang.T("Abbrechen"), () => true));
        d.Buttons.Add(new(action, () =>
        {
            var errors = new List<string>();
            Read("angle", Lang.T("Winkel"), -360, 360, errors, out var v);
            if (!Fail(errors)) return false;
            apply(v);
            return true;
        }, true));
    }

    // ---------- Neuer Plan ----------

    private static readonly string[] BoardTurns = [Lang.T("Grundstellung"), Lang.T("90° gedreht"), Lang.T("180° gedreht"), Lang.T("270° gedreht")];

    private void AskNewPlan()
    {
        _d.Clear();
        var start = BoardSetup.Default(_session.Plan.GaugeId);
        _d["gauge"] = _session.Plan.GaugeId;
        _d["shape"] = BoardShape.Rechteck.ToString();
        _d["turn"] = "0";
        _d["legL"] = _d["legR"] = "";
        SuggestBoard();
        var d = Show(Lang.T("Neuer Plan"), NewPlanBody, keepFields: true);
        d.Buttons.Add(new(Lang.T("Abbrechen"), () => true));
        d.Buttons.Add(new(Lang.T("Anlegen"), CreatePlan, true));
    }

    private BoardShape NewShape => Enum.TryParse<BoardShape>(D("shape"), out var s) ? s : BoardShape.Rechteck;

    private void SuggestBoard()
    {
        var s = BoardSetup.Default(D("gauge"), NewShape);
        _d["w"] = N(s.Width);
        _d["h"] = N(s.Height);
        _d["depth"] = N(s.Depth);
    }

    private RenderFragment NewPlanBody => @<div class="form">
        @{
            var shape = NewShape;
            double bw = Fmt.Parse(D("w")) ?? 0, bh = Fmt.Parse(D("h")) ?? 0, bd = Fmt.Parse(D("depth")) ?? 0, l1 = Fmt.Parse(D("legL")) ?? 0, l2 = Fmt.Parse(D("legR")) ?? 0;
            var t = int.TryParse(D("turn"), out var tt) ? tt : 0;
            var valid = bw >= 50 && bh >= 50;
        }
        @Hint(Lang.T("Der aktuelle Plan wird verworfen; Rückgängig holt ihn zurück. Form und Maße lassen sich später in den Eigenschaften des Plans ändern."))
        <div class="cols">
            <div>
                <label class="field-label">@Lang.T("Spur")</label>
                <select class="input" value="@D("gauge")" @onchange="@(e => { _d["gauge"] = e.Value?.ToString() ?? D("gauge"); SuggestBoard(); })">
                    @foreach (var g in Catalog.Gauges)
                    {
                        <option value="@g.Id">@Lang.F($"Spur {g.Id} ({g.Scale})")</option>
                    }
                </select>
            </div>
            <div>
                <label class="field-label">@Lang.T("Form der Anlagenplatte")</label>
                <select class="input" value="@D("shape")" @onchange="@(e => { _d["shape"] = e.Value?.ToString() ?? D("shape"); SuggestBoard(); })">
                    @foreach (var s in BoardGeometry.All)
                    {
                        <option value="@s.ToString()">@BoardGeometry.Name(s)</option>
                    }
                </select>
            </div>
        </div>
        <div class="board-preview">
            @if (valid)
            {
                @((MarkupString)Pictures.Board(BoardGeometry.Outlines(shape, bw, bh, bd, t, l1, l2), 320, 150))
            }
        </div>
        @if (shape == BoardShape.Module)
        {
            @Hint(Lang.T("Modulanlage: Breite und Tiefe gelten für das erste Modul. Weitere Module hängst du unter Gelände › Module… an, dort lassen sich auch gespeicherte Pläne als Modul ansetzen."))
        }
        <div class="cols">
            <div><label class="field-label">@(shape == BoardShape.Module ? Lang.T("Modulbreite (mm)") : Lang.T("Breite außen (mm)"))</label><input class="input" inputmode="decimal" @bind='_d["w"]' @bind:event="oninput" /></div>
            <div><label class="field-label">@(shape == BoardShape.Module ? Lang.T("Modultiefe (mm)") : Lang.T("Tiefe außen (mm)"))</label><input class="input" inputmode="decimal" @bind='_d["h"]' @bind:event="oninput" /></div>
        </div>
        @if (BoardGeometry.HasLegs(shape))
        {
            <div class="cols">
                <div><label class="field-label">@Lang.T("Schenkeltiefe (mm)")</label><input class="input" inputmode="decimal" @bind='_d["depth"]' @bind:event="oninput" /></div>
                <div>
                    <label class="field-label">@Lang.T("Ausrichtung")</label>
                    <select class="input" @bind='_d["turn"]'>
                        @for (var i = 0; i < BoardTurns.Length; i++)
                        {
                            <option value="@i">@BoardTurns[i]</option>
                        }
                    </select>
                </div>
            </div>
        }
        @if (shape == BoardShape.U)
        {
            <div class="cols">
                <div><label class="field-label">@Lang.T("Linker Schenkel lang (mm)")</label><input class="input" inputmode="decimal" placeholder="@Lang.T("ganz")" @bind='_d["legL"]' @bind:event="oninput" /></div>
                <div><label class="field-label">@Lang.T("Rechter Schenkel lang (mm)")</label><input class="input" inputmode="decimal" placeholder="@Lang.T("ganz")" @bind='_d["legR"]' @bind:event="oninput" /></div>
            </div>
        }
        @if (valid)
        {
            var area = BoardGeometry.Rects(shape, bw, bh, bd, t, l1, l2).Sum(r => (r.X1 - r.X0) * (r.Y1 - r.Y0)) / 1e6;
            <div class="secondary">
                @(BoardGeometry.HasLegs(shape)
                    ? Lang.F($"Außenmaße {Fmt.Num(bw, 0)} × {Fmt.Num(bh, 0)} mm · Schenkel {Fmt.Num(BoardGeometry.Depth(shape, bw, bh, bd, t), 0)} mm · Fläche {Fmt.Num(area, 2)} m²")
                    : Lang.F($"{Fmt.Num(bw, 0)} × {Fmt.Num(bh, 0)} mm · Fläche {Fmt.Num(area, 2)} m²"))
            </div>
        }
    </div>;

    private bool CreatePlan()
    {
        var errors = new List<string>();
        Read("w", Lang.T("Breite"), 50, 50000, errors, out var bw);
        Read("h", Lang.T("Tiefe"), 50, 50000, errors, out var bh);
        var shape = NewShape;
        var bd = 600.0;
        if (BoardGeometry.HasLegs(shape)) Read("depth", Lang.T("Schenkeltiefe"), 50, 50000, errors, out bd);
        double l1 = 0, l2 = 0;
        if (shape == BoardShape.U)
        {
            if (D("legL").Trim().Length > 0) Read("legL", Lang.T("Linker Schenkel"), 50, 50000, errors, out l1);
            if (D("legR").Trim().Length > 0) Read("legR", Lang.T("Rechter Schenkel"), 50, 50000, errors, out l2);
        }
        if (!Fail(errors)) return false;
        var t = int.TryParse(D("turn"), out var tt) ? tt : 0;
        var full = t % 2 == 0 ? bh : bw;
        _session.NewPlan(new BoardSetup(D("gauge"), shape, bw, bh, bd, t, l1 >= full ? 0 : l1, l2 >= full ? 0 : l2));
        _view.Fit();
        return true;
    }

    // ---------- Module ----------

    private sealed class ModuleRow
    {
        public int Index { get; init; } = -1;
        public string Name { get; set; } = "";
        public string X { get; set; } = "";
        public string Y { get; set; } = "";
        public string W { get; set; } = "";
        public string D { get; set; } = "";
        public bool Pick { get; set; }
    }

    private List<ModuleRow> _modules = [];

    private static ModuleRow Row(ModuleEdit m) => new() { Index = m.Index, Name = m.Name, X = N(m.X), Y = N(m.Y), W = N(m.Width), D = N(m.Depth) };

    private void AskModules()
    {
        var plan = _session.Plan;
        _modules = ModuleLayout.Current(plan).Select(Row).ToList();
        var d = Show(Lang.T("Module"), @<div class="form">
            @Hint(plan.BoardShape == BoardShape.Module
                ? Lang.T("Lage (X, Y = linke obere Ecke) und Größe jedes Moduls in mm. Ein verschobenes Modul nimmt seine Gleise und sein Gelände mit; Kanten rasten auf 30 mm an Nachbarmodulen ein. Gleise über Modulgrenzen meldet die Planprüfung.")
                : Lang.F($"Die Platte ({BoardGeometry.Name(plan.BoardShape)}) wird beim Übernehmen in Module zerlegt, je Rechteck eines. Danach lassen sich Module anhängen und verschieben."))
            <table class="table modules">
                <tr><th title="@Lang.T("Zum Zusammenführen wählen")">✓</th><th>@Lang.T("Name")</th><th>X</th><th>Y</th><th>@Lang.T("Breite")</th><th>@Lang.T("Tiefe")</th><th></th></tr>
                @foreach (var m in _modules)
                {
                    var row = m;
                    <tr>
                        <td><input type="checkbox" title="@Lang.T("Zum Zusammenführen wählen")" @bind="row.Pick" /></td>
                        <td><input class="input" @bind="row.Name" /></td>
                        <td><input class="input" inputmode="decimal" @bind="row.X" /></td>
                        <td><input class="input" inputmode="decimal" @bind="row.Y" /></td>
                        <td><input class="input" inputmode="decimal" @bind="row.W" /></td>
                        <td><input class="input" inputmode="decimal" @bind="row.D" /></td>
                        <td><button class="btn" title="@Lang.T("Modul entfernen")" disabled="@(_modules.Count < 2)" @onclick="@(() => _modules.Remove(row))">✕</button></td>
                    </tr>
                }
            </table>
            <div class="button-row">
                <button class="btn" @onclick="AddModuleRow">@Lang.T("Modul anhängen")</button>
                <button class="btn" disabled="@(_modules.Count(m => m.Pick) < 2)" @onclick="MergeModuleRows">@Lang.T("Gewählte zusammenführen")</button>
                <button class="btn" @onclick="@(async () => { CloseDialog(); await AppendModuleFile(); })">@Lang.T("Plan als Modul ansetzen…")</button>
            </div>
        </div>, wide: true, keepFields: true);
        d.Buttons.Add(new(Lang.T("Abbrechen"), () => true));
        d.Buttons.Add(new(Lang.T("Übernehmen"), () =>
        {
            var errors = new List<string>();
            var edits = ModuleEdits(errors);
            if (!Fail(errors)) return false;
            _session.ApplyModules(edits);
            _view.Fit();
            return true;
        }, true));
    }

    // ---------- Schenkel einzeln ----------

    private void AskLegs()
    {
        var plan = _session.Plan;
        if (!BoardGeometry.HasLegs(plan.BoardShape)) { _propsOpen = true; return; }
        var names = BoardGeometry.LegNames(plan.BoardShape);
        var resolved = BoardGeometry.ResolvedLegs(plan);
        _d.Clear();
        for (var i = 0; i < names.Count; i++)
        {
            var own = i < plan.BoardLegs.Count ? plan.BoardLegs[i] : new BoardLeg(0, 0);
            _d[$"ld{i}"] = own.Depth > 0 ? N(resolved[i].Depth) : "";
            var ownLength = plan.BoardShape == BoardShape.U && i < 2 ? (i == 0 ? plan.BoardLegLeft : plan.BoardLegRight) : own.Length;
            _d[$"ll{i}"] = ownLength > 0 && BoardGeometry.LegHasLength(plan.BoardShape, i) ? N(resolved[i].Length) : "";
        }
        var d = Show(Lang.T("Schenkel einzeln"), @<div class="form">
            @Hint(Lang.F($"{BoardGeometry.Name(plan.BoardShape)}: Tiefe und Länge jedes Schenkels in mm. Leere Felder nehmen die gemeinsame Schenkeltiefe ({Fmt.Num(BoardGeometry.Depth(plan.BoardShape, plan.BoardWidth, plan.BoardHeight, plan.BoardDepth, plan.BoardTurn), 0)} mm) bzw. die volle Länge. Mit „Platte ziehen“ lassen sich die runden Griffe auch mit der Maus ziehen."))
            <table class="table modules">
                <tr><th>@Lang.T("Schenkel")</th><th>@Lang.T("Tiefe")</th><th>@Lang.T("Länge")</th></tr>
                @for (var i = 0; i < names.Count; i++)
                {
                    var k = i;
                    <tr>
                        <td>@names[k]</td>
                        <td><input class="input" inputmode="decimal" placeholder="@N(resolved[k].Depth)" @bind='_d[$"ld{k}"]' /></td>
                        <td>
                            @if (BoardGeometry.LegHasLength(plan.BoardShape, k))
                            {
                                <input class="input" inputmode="decimal" placeholder="@N(resolved[k].Length)" @bind='_d[$"ll{k}"]' />
                            }
                            else
                            {
                                <span class="secondary small">@Lang.T("durch Außenmaß")</span>
                            }
                        </td>
                    </tr>
                }
            </table>
        </div>, keepFields: true);
        d.Buttons.Add(new(Lang.T("Alle zurücksetzen"), () => { _session.Edit(() => BoardGeometry.ResetLegs(plan)); return true; }));
        d.Buttons.Add(new(Lang.T("Abbrechen"), () => true));
        d.Buttons.Add(new(Lang.T("Übernehmen"), () =>
        {
            var errors = new List<string>();
            var values = new List<(double Depth, double Length)>();
            for (var i = 0; i < names.Count; i++)
            {
                double dep = 0, len = 0;
                if (D($"ld{i}").Trim().Length > 0) Read($"ld{i}", Lang.F($"{names[i]} Tiefe"), 50, 50000, errors, out dep);
                if (BoardGeometry.LegHasLength(plan.BoardShape, i) && D($"ll{i}").Trim().Length > 0) Read($"ll{i}", Lang.F($"{names[i]} Länge"), 50, 50000, errors, out len);
                values.Add((dep, len));
            }
            if (!Fail(errors)) return false;
            _session.Edit(() =>
            {
                BoardGeometry.ResetLegs(plan);
                for (var i = 0; i < values.Count; i++) BoardGeometry.SetLeg(plan, i, values[i].Depth, values[i].Length);
            });
            _session.Say(BoardGeometry.Describe(plan));
            return true;
        }, true));
    }

    private List<ModuleEdit> ModuleEdits(List<string> errors)
    {
        var edits = new List<ModuleEdit>();
        foreach (var (m, i) in _modules.Select((m, i) => (m, i)))
        {
            double? x = Fmt.Parse(m.X), y = Fmt.Parse(m.Y), w = Fmt.Parse(m.W), dd = Fmt.Parse(m.D);
            if (x is null || y is null || w is null || dd is null) { errors.Add(Lang.F($"Modul {i + 1}: bitte Zahlen eingeben.")); continue; }
            if (w < ModuleLayout.MinSize || dd < ModuleLayout.MinSize || w > ModuleLayout.MaxSize || dd > ModuleLayout.MaxSize)
            {
                errors.Add(Lang.F($"Modul {i + 1}: Breite und Tiefe zwischen {Fmt.Num(ModuleLayout.MinSize, 0)} und {Fmt.Num(ModuleLayout.MaxSize, 0)} mm."));
                continue;
            }
            edits.Add(new ModuleEdit(m.Index, m.Name, x.Value, y.Value, w.Value, dd.Value));
        }
        return edits;
    }

    private void MergeModuleRows()
    {
        var errors = new List<string>();
        var edits = ModuleEdits(errors);
        if (errors.Count > 0) { _session.Say(errors[0]); return; }
        var pick = _modules.Select((m, i) => (m, i)).Where(t => t.m.Pick).Select(t => t.i).ToList();
        var (rows, error) = ModuleLayout.Merge(edits, pick);
        if (rows is null) { _session.Say(error!); return; }
        _modules = rows.Select(Row).ToList();
    }

    private void AddModuleRow()
    {
        var temp = new LayoutPlan();
        foreach (var m in _modules)
            if (Fmt.Parse(m.X) is { } x && Fmt.Parse(m.Y) is { } y && Fmt.Parse(m.W) is { } w && Fmt.Parse(m.D) is { } dd)
                temp.Modules.Add(new BoardModule { X = x, Y = y, Width = w, Depth = dd });
        var next = ModuleLayout.NextModule(temp);
        _modules.Add(new ModuleRow { Name = Lang.F($"Modul {_modules.Count + 1}"), X = N(next.X), Y = N(next.Y), W = N(next.Width), D = N(next.Depth) });
    }

