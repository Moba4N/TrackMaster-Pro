            <table class="table bench">
                <tr><th>@Lang.T("Anzahl")</th><th>@Lang.T("Länge")</th><th>@Lang.T("Teil")</th><th>@Lang.T("Querschnitt")</th></tr>
                @foreach (var c in b.Cuts)
