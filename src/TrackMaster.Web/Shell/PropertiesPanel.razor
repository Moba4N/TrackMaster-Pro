@using TrackMaster.Core

@* Eigenschaften des gewählten Gleises, Objekts oder (ohne Auswahl) des Plans. Eine geänderte Eingabe gilt sofort (wie unter Windows). *@
<div class="pane-head">
    <span class="pane-title">@Lang.T("Eigenschaften")</span>
    <span class="pane-meta">@Kind</span>
    @if (OnClose is not null)
    {
        <button class="icon-btn pane-close" title="@Lang.T("Schließen")" @onclick="OnClose">@((MarkupString)Icons.Svg("Close", 18))</button>
    }
</div>
<div class="pane-body props">
    @if (_error is { Length: > 0 })
    {
        <div class="error-box">@_error</div>
    }
    @switch (_target)
    {
        case SceneryItem s:
            @SceneryForm(s)
            break;
        case Feeder f:
            @FeederForm(f)
            break;
        case Isolation i:
            @IsolationForm(i)
            break;
        case Signal g:
            @SignalForm(g)
            break;
        case Detector det:
            @DetectorForm(det)
            break;
        case PlacedPiece p:
            @PieceForm(p)
            break;
        case IReadOnlyList<PlacedPiece> many:
            @MultiForm(many)
            break;
        default:
            @PlanForm()
            break;
    }
</div>

@code {
    [Parameter, EditorRequired] public PlanSession Session { get; set; } = null!;
    /// <summary>Zählt bei jeder Planänderung hoch; dann werden die Felder neu gefüllt.</summary>
    [Parameter] public int Version { get; set; }
    [Parameter, EditorRequired] public Action<string> Run { get; set; } = null!;
    [Parameter] public Action? OnClose { get; set; }

    private object? _target;
    private readonly Dictionary<string, string> _f = [];
    private string _loaded = "";
    private string? _error;

    private LayoutPlan Plan => Session.Plan;

    private string Kind => _target switch
    {
        SceneryItem { IsPower: true } p => PowerSupply.TypeName(PowerSupply.Type(p)),
        SceneryItem s => SceneryItem.KindName(s.Kind),
        Feeder => Lang.T("Gleisanschluss"),
        Isolation => Lang.T("Trennstelle"),
        Signal => "Signal",
        Detector => Lang.T("Rückmelder"),
        PlacedPiece => Lang.T("Gleis"),
        IReadOnlyList<PlacedPiece> many => Lang.F($"{many.Count} Gleise"),
        _ => Lang.T("Plan"),
    };

    protected override void OnParametersSet()
    {
        var sel = Session.SelectedPieces;
        var key = $"{Version}|{Session.SelectedObject}|{string.Join(",", sel.Select(p => p.Id))}|{Plan.GetHashCode()}";
        if (key == _loaded) return;
        _loaded = key;
        _error = null;
        _target = Session.SelectedObject is { } obj && Session.FindObject(obj) is { } o ? o
            : sel.Count == 1 ? sel[0]
            : sel.Count > 1 ? sel
            : null;
        Load();
    }

    private static string N(double v, int decimals = 0) => Fmt.Num(v, decimals).Replace(Lang.IsEnglish ? "," : ".", "");

    /// <summary>Felder aus dem Modell füllen.</summary>
    private void Load()
    {
        _f.Clear();
        switch (_target)
        {
            case SceneryItem s:
                _f["name"] = s.Name;
                _f["height"] = N(s.Height, s.IsModel ? 1 : 0);
                _f["width"] = N(s.Width, s.IsModel ? 1 : 0);
                _f["depth"] = N(s.Depth, s.IsModel ? 1 : 0);
                _f["color"] = s.Color ?? "";
                _f["rotation"] = N(s.Rotation, 1);
                _f["variant"] = s.Variant.ToString();
                if (s.IsBeam) _f["length"] = N(BeamLayout.Length(s), 0);
                if (s.IsWire) { _f["depth"] = N(WireLayout.Section(s, Plan.Gauge), 2); _f["color"] = WireLayout.ColorOf(s, Electrics.Current(Plan)); }
                if (s.IsPower) { _f["color"] = PowerSupply.DistributorColor(s); _f["maddr"] = s.Address?.ToString() ?? ""; }
                if (s.IsPlate) { _f["x"] = N(s.X, 1); _f["y"] = N(s.Y, 1); _f["thick"] = N(PlateLayout.Thickness(s), 0); }
                break;
            case Detector det:
                _f["name"] = det.Name;
                _f["type"] = det.Type.ToString();
                _f["address"] = det.Address?.ToString() ?? "";
                break;
            case Feeder f:
                _f["circuit"] = f.Circuit;
                break;
            case Signal g:
                _f["name"] = g.Name;
                _f["type"] = g.Type.ToString();
                _f["system"] = g.System.ToString();
                _f["address"] = g.Address?.ToString() ?? "";
                break;
            case IReadOnlyList<PlacedPiece>:
                _f["mheight"] = Session.SelectionHeight is { } mh ? N(mh, 1) : "";
                break;
            case PlacedPiece p:
                _f["x"] = N(p.X, 1);
                _f["y"] = N(p.Y, 1);
                _f["rotation"] = N(p.Rotation, 1);
                _f["height"] = N(p.Height, 1);
                _f["grade"] = N(p.EffectiveGrade * 100, 2);
                _f["address"] = p.Address?.ToString() ?? "";
                _f["name"] = p.Name;
                break;
            case null:
                _f["name"] = Plan.Name;
                _f["shape"] = Plan.BoardShape.ToString();
                _f["w"] = N(Plan.BoardWidth);
                _f["h"] = N(Plan.BoardHeight);
                _f["depth"] = N(BoardGeometry.Depth(Plan.BoardShape, Plan.BoardWidth, Plan.BoardHeight, Plan.BoardDepth, Plan.BoardTurn));
                _f["turn"] = Plan.BoardTurn.ToString();
                var full = Plan.BoardTurn % 2 == 0 ? Plan.BoardHeight : Plan.BoardWidth;
                var d0 = BoardGeometry.Depth(Plan.BoardShape, Plan.BoardWidth, Plan.BoardHeight, Plan.BoardDepth, Plan.BoardTurn);
                _f["legL"] = N(BoardGeometry.Leg(Plan.BoardLegLeft, d0, full));
                _f["legR"] = N(BoardGeometry.Leg(Plan.BoardLegRight, d0, full));
                _f["vehicle"] = N(Plan.EffectiveVehicleLength);
                _f["train"] = Plan.TrainLength > 0 ? N(Plan.TrainLength) : "";
                break;
        }
    }

    private string F(string key) => _f.GetValueOrDefault(key, "");

    private void Set(string key, ChangeEventArgs e, Action apply)
    {
        _f[key] = e.Value?.ToString() ?? "";
        _error = null;
        apply();
    }

    private bool Read(string key, string name, double min, double max, List<string> errors, out double value)
    {
        value = Fmt.Parse(F(key)) ?? double.NaN;
        if (double.IsNaN(value)) { errors.Add(Lang.F($"{name}: bitte eine Zahl eingeben.")); return false; }
        if (value < min || value > max) { errors.Add(Lang.F($"{name}: zwischen {Fmt.Num(min)} und {Fmt.Num(max)}.")); return false; }
        return true;
    }

    private bool Fail(List<string> errors)
    {
        if (errors.Count == 0) return false;
        _error = string.Join(" ", errors);
        return true;
    }

    private static readonly string[] BoardTurns = [Lang.T("Grundstellung"), Lang.T("90° gedreht"), Lang.T("180° gedreht"), Lang.T("270° gedreht")];

    // ---------- Plan ----------

    private void ApplyPlan()
    {
        var plan = Plan;
        var errors = new List<string>();
        Read("w", Lang.T("Breite"), 50, 50000, errors, out var bw);
        Read("h", Lang.T("Tiefe"), 50, 50000, errors, out var bh);
        var newShape = Enum.TryParse<BoardShape>(F("shape"), out var sh) ? sh : plan.BoardShape;
        var bd = plan.BoardDepth;
        if (BoardGeometry.HasLegs(newShape)) Read("depth", Lang.T("Schenkeltiefe"), 50, 50000, errors, out bd);
        double l1 = 0, l2 = 0;
        if (newShape == BoardShape.U)
        {
            Read("legL", Lang.T("Linker Schenkel"), 50, 50000, errors, out l1);
            Read("legR", Lang.T("Rechter Schenkel"), 50, 50000, errors, out l2);
        }
        Read("vehicle", Lang.T("Fahrzeuglänge"), 20, 5000, errors, out var vl);
        double train = 0;
        if (F("train").Trim().Length > 0) Read("train", Lang.T("Zuglänge"), 0, 100000, errors, out train);
        if (Fail(errors)) return;
        if (Math.Abs(train - plan.TrainLength) > 0.01) Session.Edit(() => plan.TrainLength = train);
        var n = F("name").Trim();
        var t = int.TryParse(F("turn"), out var tt) ? tt : plan.BoardTurn;
        var full = t % 2 == 0 ? bh : bw;
        l1 = l1 >= full ? 0 : l1;
        l2 = l2 >= full ? 0 : l2;
        vl = Math.Abs(vl - VehicleDefaults.Length(plan.Gauge)) < 0.5 ? 0 : vl;
        // Modulanlage: Maße kommen aus den Modulen; beim Umstellen wird die bisherige Platte zu Modulen
        if (newShape == BoardShape.Module)
        {
            if (plan.BoardShape != BoardShape.Module) Session.Edit(() => ModuleLayout.ConvertToModules(plan));
            if (vl != plan.VehicleLength || (n.Length > 0 && n != plan.Name))
                Session.Edit(() => { if (n.Length > 0) plan.Name = n; plan.VehicleLength = vl; });
            return;
        }
        if (vl != plan.VehicleLength || (n.Length > 0 && n != plan.Name) || bw != plan.BoardWidth || bh != plan.BoardHeight || newShape != plan.BoardShape || bd != plan.BoardDepth || t != plan.BoardTurn
            || l1 != plan.BoardLegLeft || l2 != plan.BoardLegRight)
            Session.Edit(() =>
            {
                if (n.Length > 0) plan.Name = n;
                plan.BoardWidth = bw;
                plan.BoardHeight = bh;
                if (plan.BoardShape != newShape) plan.BoardLegs.Clear();
                plan.BoardShape = newShape;
                plan.BoardTurn = t;
                plan.BoardDepth = BoardGeometry.Depth(newShape, bw, bh, bd, t);
                plan.BoardLegLeft = l1;
                plan.BoardLegRight = l2;
                plan.Modules.Clear();
                plan.VehicleLength = vl;
            });
    }

    private RenderFragment PlanForm() => __builder =>
    {
        var plan = Plan;
        var stats = plan.Statistics(Session.Connections);
        var gauge = plan.Gauge;
        var shape = Enum.TryParse<BoardShape>(F("shape"), out var sh) ? sh : plan.BoardShape;
        <label class="field-label">@Lang.T("Planname")</label>
        <input class="input" value="@F("name")" @onchange="@(e => Set("name", e, ApplyPlan))" />
        <div class="section">@Lang.T("Anlagenplatte")</div>
        <label class="field-label">@Lang.T("Form")</label>
        <select class="input" value="@F("shape")" @onchange="@(e => Set("shape", e, ApplyPlan))">
            @foreach (var s in BoardGeometry.All)
            {
                <option value="@s">@BoardGeometry.Name(s)</option>
            }
        </select>
        @if (shape == BoardShape.Module)
        {
            <div class="tip-box">@BoardGeometry.Describe(plan). @Lang.T("Module anhängen, verschieben oder einen gespeicherten Plan ansetzen: Gelände › Module…")</div>
        }
        else
        {
            <div class="cols">
                <div><label class="field-label">@Lang.T("Breite außen (mm)")</label><input class="input" inputmode="decimal" value="@F("w")" @onchange="@(e => Set("w", e, ApplyPlan))" /></div>
                <div><label class="field-label">@Lang.T("Tiefe außen (mm)")</label><input class="input" inputmode="decimal" value="@F("h")" @onchange="@(e => Set("h", e, ApplyPlan))" /></div>
            </div>
        }
        @if (BoardGeometry.HasLegs(shape))
        {
            <div class="cols">
                <div><label class="field-label">@Lang.T("Schenkeltiefe (mm)")</label><input class="input" inputmode="decimal" value="@F("depth")" @onchange="@(e => Set("depth", e, ApplyPlan))" /></div>
                <div>
                    <label class="field-label">@Lang.T("Ausrichtung")</label>
                    <select class="input" value="@F("turn")" @onchange="@(e => Set("turn", e, ApplyPlan))">
                        @for (var i = 0; i < BoardTurns.Length; i++)
                        {
                            <option value="@i">@BoardTurns[i]</option>
                        }
                    </select>
                </div>
            </div>
        }
        @if (shape == BoardShape.U)
        {
            <div class="cols">
                <div><label class="field-label">@Lang.T("Linker Schenkel lang (mm)")</label><input class="input" inputmode="decimal" value="@F("legL")" @onchange="@(e => Set("legL", e, ApplyPlan))" /></div>
                <div><label class="field-label">@Lang.T("Rechter Schenkel lang (mm)")</label><input class="input" inputmode="decimal" value="@F("legR")" @onchange="@(e => Set("legR", e, ApplyPlan))" /></div>
            </div>
        }
        @if (BoardGeometry.HasLegs(shape) && shape == plan.BoardShape)
        {
            <div class="button-row">
                <button class="btn" title="@Lang.T("Tiefe und Länge jedes Schenkels einzeln einstellen")" @onclick="@(() => Run("legs"))">@((MarkupString)Icons.Svg("Resize", 16)) @Lang.T("Schenkel einzeln…")</button>
            </div>
        }
        <div class="section">@Lang.T("Planprüfung")</div>
        <div class="cols">
            <div><label class="field-label">@Lang.T("Längstes Fahrzeug (mm)")</label><input class="input" inputmode="decimal" value="@F("vehicle")" @onchange="@(e => Set("vehicle", e, ApplyPlan))" /></div>
            <div><label class="field-label" title="@Lang.T("Für die Nutzlänge der Gleise; leer = nicht prüfen")">@Lang.T("Längster Zug (mm)")</label><input class="input" inputmode="decimal" placeholder="–" value="@F("train")" @onchange="@(e => Set("train", e, ApplyPlan))" /></div>
        </div>
        <div class="section">@Lang.T("Übersicht")</div>
        <dl class="rows">
            <dt>@Lang.T("Spur")</dt><dd>@gauge.Id · @gauge.Scale · @Fmt.Num(gauge.TrackWidth) mm</dd>
            <dt>@Lang.T("Gleisstücke")</dt><dd>@stats.Pieces</dd>
            <dt>@Lang.T("Weichen und Kreuzungen")</dt><dd>@stats.Switches</dd>
            <dt>@Lang.T("Gleislänge")</dt><dd>@Fmt.Num(stats.TrackLengthMm / 1000, 2) m</dd>
            <dt>@Lang.T("Kleinster Radius")</dt><dd>@(stats.SmallestRadius is { } r ? $"{Fmt.Num(r)} mm" : "–")</dd>
            <dt>@Lang.T("Größte Steigung")</dt><dd class="@(stats.MaxGrade * 100 > PlanCheck.WarnGradePercent ? "danger" : "")">@(stats.MaxGrade > 0 ? $"{Fmt.Num(stats.MaxGrade * 100, 1)} %" : Lang.T("eben"))</dd>
            <dt>@Lang.T("Höchster Punkt")</dt><dd>@Fmt.Num(stats.MaxHeight, 0) mm</dd>
            <dt>@Lang.T("Gelände / Elektrik")</dt><dd>@Lang.F($"{plan.Scenery.Count} Obj. · {plan.Feeders.Count} Gleisanschl. · {plan.Signals.Count} Sig.")@(plan.Detectors.Count > 0 ? Lang.F($" · {plan.Detectors.Count} RM") : "")</dd>
            <dt>@Lang.T("Offene Gleisenden")</dt><dd class="@(stats.OpenEnds > 0 ? "open" : "ok")">@stats.OpenEnds</dd>
        </dl>
        <div class="button-row">
            <button class="btn" @onclick="@(() => Run("bom"))">@((MarkupString)Icons.Svg("List", 16)) @Lang.T("Stückliste")</button>
            <button class="btn" @onclick="@(() => Run("check"))">@((MarkupString)Icons.Svg("Shield", 16)) @Lang.T("Planprüfung")</button>
        </div>
        <div class="tip-box">@Lang.T("So geht’s: Klicke ein orangefarbenes Gleisende an und dann ein Gleis in der Bibliothek – es wird dort angesetzt. Gewählte Gleise lassen sich mit der Maus (oder dem Finger) verschieben und rasten an freien Enden ein.")</div>
    };

    // ---------- Gleis ----------

    private void ApplyPiece()
    {
        if (_target is not PlacedPiece p) return;
        var errors = new List<string>();
        Read("x", "X", -100000, 100000, errors, out var vx);
        Read("y", "Y", -100000, 100000, errors, out var vy);
        Read("rotation", Lang.T("Drehung"), -100000, 100000, errors, out var vr);
        Read("height", Lang.T("Höhe"), -500, 3000, errors, out var vh);
        Read("grade", Lang.T("Steigung"), -30, 30, errors, out var vg);
        double va = 0;
        if (p.Def.Drives > 0 && F("address").Trim().Length > 0) Read("address", Lang.T("Adresse"), 0, 2048, errors, out va);
        if (Fail(errors)) return;
        int? addr = p.Def.Drives == 0 ? p.Address : va >= 1 ? (int)Math.Round(va) : null;
        var name = p.Def.Drives == 0 ? p.Name : F("name").Trim();
        var changed = name != p.Name || Math.Abs(vx - p.X) > 1e-6 || Math.Abs(vy - p.Y) > 1e-6 || Math.Abs(Angles.Normalize(vr) - p.Rotation) > 1e-6
                      || Math.Abs(vh - p.Height) > 1e-6 || Math.Abs(vg / 100 - p.EffectiveGrade) > 1e-9 || addr != p.Address;
        if (changed)
            Session.Edit(() =>
            {
                p.X = vx; p.Y = vy; p.Rotation = Angles.Normalize(vr);
                p.Height = vh;
                if (Math.Abs(vg / 100 - p.EffectiveGrade) > 1e-9) p.Grade = vg / 100;
                p.Address = addr;
                p.Name = name;
            });
    }

    private void SetTunnel(PlacedPiece p, bool on) => Session.Edit(() => p.Tunnel = on);

    private RenderFragment PieceForm(PlacedPiece p) => __builder =>
    {
        var d = p.Def;
        var leftHanded = !d.RightHand != p.Flipped;
        var heights = p.ConnectorHeights();
        var conns = Session.Connections.Of(p.Id).ToList();
        var linked = conns.Count(cn => !cn.IsOpen);
        <div class="title">@d.Name</div>
        <div class="secondary">@d.SystemName · @d.Number</div>
        @if (!d.Verified)
        {
            <div class="warn-box">@Lang.T("Geometrie vorläufig – vor dem Bau mit dem Herstellerkatalog prüfen.")</div>
        }
        <dl class="rows">
            @switch (d.Kind)
            {
                case PieceKind.Curve:
                    <dt>@Lang.T("Radius")</dt><dd>@Fmt.Num(d.Radius) mm</dd>
                    <dt>@Lang.T("Winkel")</dt><dd>@Fmt.Num(d.Angle)°</dd>
                    <dt>@Lang.T("Bogenlänge")</dt><dd>@Fmt.Num(d.TrackLength) mm</dd>
                    <dt>@Lang.T("Richtung")</dt><dd>@(leftHanded ? Lang.T("links") : Lang.T("rechts"))</dd>
                    break;
                case PieceKind.Switch when !d.IsSimpleSwitch:
                    <dt>@Lang.T("Maße")</dt><dd>@d.Spec</dd>
                    <dt>@Lang.T("Stränge")</dt><dd>@d.RouteCount</dd>
                    <dt>@Lang.T("Antriebe")</dt><dd>@d.Drives</dd>
                    break;
                case PieceKind.Switch:
                    <dt>@Lang.T("Länge")</dt><dd>@Fmt.Num(d.Length) mm</dd>
                    <dt>@Lang.T("Abzweig")</dt><dd>R @Fmt.Num(d.Radius) · @Fmt.Num(d.Angle)°</dd>
                    <dt>@Lang.T("Richtung")</dt><dd>@(leftHanded ? Lang.T("links") : Lang.T("rechts"))</dd>
                    break;
                case PieceKind.Crossing:
                    <dt>@Lang.T("Länge")</dt><dd>@Fmt.Num(d.Length) mm</dd>
                    <dt>@Lang.T("Kreuzungswinkel")</dt><dd>@Fmt.Num(d.Angle)°</dd>
                    break;
                case PieceKind.Turntable or PieceKind.TransferTable:
                    <dt>@Lang.T("Maße")</dt><dd>@d.Spec</dd>
                    <dt>@Lang.T("Anschlüsse")</dt><dd>@d.RouteCount</dd>
                    break;
                default:
                    <dt>@Lang.T("Länge")</dt><dd>@Fmt.Num(d.Length) mm</dd>
                    break;
            }
        </dl>
        <div class="section">@Lang.T("Position")</div>
        <div class="cols three">
            <div><label class="field-label">X (mm)</label><input class="input" inputmode="decimal" value="@F("x")" @onchange="@(e => Set("x", e, ApplyPiece))" /></div>
            <div><label class="field-label">Y (mm)</label><input class="input" inputmode="decimal" value="@F("y")" @onchange="@(e => Set("y", e, ApplyPiece))" /></div>
            <div><label class="field-label">@Lang.T("Drehung (°)")</label><input class="input" inputmode="decimal" value="@F("rotation")" @onchange="@(e => Set("rotation", e, ApplyPiece))" /></div>
        </div>
        <div class="section">@Lang.T("Höhe")</div>
        <div class="cols">
            <div><label class="field-label">@Lang.T("Höhe Anfang (mm)")</label><input class="input" inputmode="decimal" value="@F("height")" @onchange="@(e => Set("height", e, ApplyPiece))" /></div>
            <div><label class="field-label">@Lang.T("Steigung (%)")</label><input class="input" inputmode="decimal" value="@F("grade")" @onchange="@(e => Set("grade", e, ApplyPiece))" /></div>
        </div>
        @if (heights.Count > 1)
        {
            <dl class="rows"><dt>@Lang.T("Höhe am Ende")</dt><dd>@Fmt.Num(heights[1], 1) mm</dd></dl>
        }
        <label class="check"><input type="checkbox" checked="@p.Tunnel" @onchange="e => SetTunnel(p, e.Value is true)" /> @Lang.T("liegt im Tunnel")</label>
        <label class="check"><input type="checkbox" checked="@p.Locked" @onchange="e => Session.Edit(() => p.Locked = e.Value is true)" /> @Lang.T("gesperrt (nicht verschieben, drehen oder löschen)")</label>
        @if (UsableLength.For(Plan, p.Id, Session.Connections) is { } run)
        {
            <dl class="rows"><dt>@Lang.T("Nutzlänge")</dt><dd class="@(Plan.TrainLength > 0 && !run.Closed && run.Length < Plan.TrainLength ? "danger" : "")">@UsableLength.Describe(Plan, run)</dd></dl>
        }
        @if (p.Group > 0)
        {
            <dl class="rows"><dt>@Lang.T("Gruppe")</dt><dd>@Lang.F($"{Plan.Pieces.Count(x => x.Group == p.Group)} Gleise")</dd></dl>
        }
        @if (d.Drives > 0)
        {
            <div class="section">@Lang.T("Digital")</div>
            <label class="field-label">@Lang.T("Bezeichnung (z. B. W1)")</label>
            <input class="input" maxlength="40" value="@F("name")" @onchange="@(e => Set("name", e, ApplyPiece))" />
            <label class="field-label">@Lang.T("Adresse (leer = keine)")</label>
            <input class="input" inputmode="numeric" value="@F("address")" @onchange="@(e => Set("address", e, ApplyPiece))" />
        }
        <dl class="rows">
            <dt>@Lang.T("Verbindungen")</dt><dd class="@(linked == conns.Count ? "ok" : "open")">@Lang.F($"{linked} von {conns.Count} verbunden")</dd>
        </dl>
        <div class="section">@Lang.T("Elektrik")</div>
        <div class="secondary small">@Session.ConnectionSummary(p.Id)</div>
        <div class="button-row"><button class="btn" @onclick="@(() => Run("connections"))">@((MarkupString)Icons.Svg("Connector", 16)) @Lang.T("Anschlüsse…")</button></div>
        <div class="button-row wrap">
            <button class="btn" @onclick="@(() => Run("rotR"))">@((MarkupString)Icons.Svg("RotateRight", 16)) @Lang.T("Drehen")</button>
            @if (d.CanFlip)
            {
                <button class="btn" @onclick="@(() => Run("flip"))">@((MarkupString)Icons.Svg("Mirror", 16)) @Lang.T("Spiegeln")</button>
            }
            @if (conns.Count > 1)
            {
                <button class="btn" @onclick="@(() => Run("swap"))">@((MarkupString)Icons.Svg("Swap", 16)) @Lang.T("Anschluss")</button>
            }
            <button class="btn" @onclick="@(() => Run("delete"))">@((MarkupString)Icons.Svg("Delete", 16)) @Lang.T("Löschen")</button>
        </div>
        @if (SwitchInsert.CanReplace(p) && SwitchInsert.Switches(Plan, Session.CurrentSystem.Id) is { Count: > 0 } switches)
        {
            var key = switches.Any(x => x.Key == _insertKey) ? _insertKey! : switches[0].Key;
            <div class="section">@Lang.T("Weiche einsetzen")</div>
            <div class="secondary small">@Lang.T("Ersetzt dieses Gleis durch eine Weiche – Höhe, Steigung und Ebene bleiben, eine Lücke schließt ein Flexgleis. Auch in der Gleiswendel; in engen Bögen eine Bogenweiche wählen.")</div>
            <select class="input" value="@key" @onchange="@(e => _insertKey = e.Value as string)">
                @foreach (var w in switches)
                {
                    <option value="@w.Key">@($"{w.Number} · {w.Name}{(w.SystemId == Session.CurrentSystem.Id ? "" : " (" + w.SystemName + ")")}")</option>
                }
            </select>
            <label class="check"><input type="checkbox" checked="@_insertReverse" @onchange="@(e => _insertReverse = e.Value is true)" /> @Lang.T("in Gegenrichtung (Weichenspitze am anderen Ende)")</label>
            <label class="check"><input type="checkbox" checked="@_insertOther" @onchange="@(e => _insertOther = e.Value is true)" /> @Lang.T("Abzweig auf die andere Seite")</label>
            <div class="button-row"><button class="btn accent" @onclick="@(() => Session.InsertSwitch(key, _insertReverse, _insertOther))">@Lang.T("Weiche einsetzen")</button></div>
        }
    };

    private string? _insertKey;
    private bool _insertReverse, _insertOther;

    private RenderFragment MultiForm(IReadOnlyList<PlacedPiece> sel) => __builder =>
    {
        <dl class="rows">
            <dt>@Lang.T("Gleisstücke")</dt><dd>@sel.Count</dd>
            <dt>@Lang.T("Gleislänge")</dt><dd>@Fmt.Num(sel.Sum(p => p.Def.TrackLength) / 1000, 2) m</dd>
            <dt>@Lang.T("Höhe")</dt><dd>@HeightRange(sel)</dd>
        </dl>
        <div class="cols">
            <div>
                <label class="field-label">@Lang.T("Höhe aller gewählten Gleise (mm)")</label>
                <input class="input" inputmode="decimal" placeholder="@Lang.T("unterschiedlich")" value="@F("mheight")" @onchange="@(e => Set("mheight", e, ApplyMultiHeight))" />
            </div>
        </div>
        <div class="secondary small">@Lang.T("Legt alle gewählten Gleise waagrecht auf diese Schienenoberkante. Für eine Rampe „Steigung…“ verwenden.")</div>
        <div class="grid-buttons">
            <button class="btn" @onclick="@(() => Run("rotL"))">@Lang.T("15° links")</button>
            <button class="btn" @onclick="@(() => Run("rotR"))">@Lang.T("15° rechts")</button>
            <button class="btn" @onclick="@(() => Run("duplicate"))">@Lang.T("Duplizieren")</button>
            <button class="btn" @onclick="@(() => Run("delete"))">@Lang.T("Löschen")</button>
            <button class="btn" @onclick="@(() => Run("gradient"))">@Lang.T("Steigung…")</button>
            <button class="btn" @onclick="@(() => Run("tunnel"))">@(sel.All(p => p.Tunnel) ? Lang.T("Tunnel aufheben") : Lang.T("Als Tunnel"))</button>
            <button class="btn" @onclick="@(() => Run("lock"))">@(sel.All(p => p.Locked) ? Lang.T("Entsperren") : Lang.T("Sperren"))</button>
            <button class="btn" @onclick="@(() => Run(sel.All(p => p.Group > 0 && p.Group == sel[0].Group) ? "ungroup" : "group"))">@(sel.All(p => p.Group > 0 && p.Group == sel[0].Group) ? Lang.T("Gruppe auflösen") : Lang.T("Gruppieren"))</button>
            <button class="btn" @onclick="@(() => Run("parallel"))">@Lang.T("Parallelgleis…")</button>
            <button class="btn" @onclick="@(() => Run("profile"))">@Lang.T("Höhenprofil")</button>
        </div>
        @if (sel.Any(p => p.Locked))
        {
            <div class="warn-box">@Lang.F($"{sel.Count(p => p.Locked)} der gewählten Gleise sind gesperrt.")</div>
        }
        <div class="tip-box">@Lang.T("Ziehe die Auswahl an ein freies Gleisende – die ganze Gruppe rastet dort ein.")</div>
    };

    private static string HeightRange(IReadOnlyList<PlacedPiece> sel)
    {
        var all = sel.SelectMany(p => p.ConnectorHeights()).ToList();
        var (lo, hi) = (all.Min(), all.Max());
        return Math.Abs(hi - lo) < 0.05 ? $"{Fmt.Num(lo, 1)} mm" : $"{Fmt.Num(lo, 1)} – {Fmt.Num(hi, 1)} mm";
    }

    private void ApplyMultiHeight()
    {
        if (F("mheight").Trim().Length == 0) return;
        var errors = new List<string>();
        Read("mheight", Lang.T("Höhe"), -500, 5000, errors, out var z);
        if (Fail(errors)) return;
        Session.SetSelectionHeight(z);
    }

    // ---------- Objekte ----------

    private void ApplyScenery()
    {
        if (_target is not SceneryItem s) return;
        var errors = new List<string>();
        var apply = new List<Action>();
        void Num(string key, string name, double min, double max, Action<double> set)
        {
            if (Read(key, name, min, max, errors, out var v)) apply.Add(() => set(v));
        }
        switch (s.Kind)
        {
            case SceneryKind.Label:
                Num("height", Lang.T("Schrifthöhe"), 2, 500, v => s.Height = v);
                Num("rotation", Lang.T("Drehung"), -360, 360, v => s.Rotation = Angles.Normalize(v));
                break;
            case SceneryKind.Dimension when s.Points.Count == 2:
                Num("width", Lang.T("Abstand"), -5000, 5000, v => s.Width = v);
                Num("height", Lang.T("Schrifthöhe"), 2, 500, v => s.Height = v);
                break;
            case SceneryKind.Beam when s.Points.Count == 2:
                Num("width", Lang.T("Breite"), BeamLayout.MinSection, BeamLayout.MaxWidth, v => s.Width = v);
                Num("depth", Lang.T("Höhe der Latte"), BeamLayout.MinSection, BeamLayout.MaxDepth, v => s.Depth = v);
                Num("height", Lang.T("Oberkante"), BeamLayout.MinTop, BeamLayout.MaxTop, v => s.Height = v);
                Num("length", Lang.T("Länge"), BeamLayout.MinLength, 20000, v => PlanSession.SetBeamLength(s, v));
                break;
            case SceneryKind.Wire:
                Num("depth", Lang.T("Querschnitt"), 0.04, 10, v => s.Depth = v);
                var wireColor = F("color");
                apply.Add(() => s.Color = ModelBody.ParseColor(wireColor) is { } wc ? ModelBody.ToHex(wc) : s.Color);
                break;
            case SceneryKind.Plate:
                Num("x", Lang.T("Links"), -20000, 20000, v => s.X = v);
                Num("y", Lang.T("Oben"), -20000, 20000, v => s.Y = v);
                Num("width", Lang.T("Breite"), PlateLayout.MinSize, PlateLayout.MaxSize, v => s.Width = v);
                Num("depth", Lang.T("Tiefe"), PlateLayout.MinSize, PlateLayout.MaxSize, v => s.Depth = v);
                Num("thick", Lang.T("Stärke"), PlateLayout.MinThickness, PlateLayout.MaxThickness, v => s.Variant = (int)Math.Round(v));
                Num("height", Lang.T("Oberkante"), BeamLayout.MinTop, BeamLayout.MaxTop, v => s.Height = v);
                break;
            case SceneryKind.Terrain:
                Num("height", Lang.T("Höhe"), -500, 3000, v => s.Height = v);
                break;
            case SceneryKind.Water:
                Num("height", Lang.T("Tiefe"), 0, 200, v => s.Height = v);
                break;
            case SceneryKind.Building when s.IsModel:
                if (s.Points.Count < 2)
                {
                    Num("width", Lang.T("Länge"), 0.5, 20000, v => s.Width = v);
                    Num("rotation", Lang.T("Drehung"), -360, 360, v => s.Rotation = Angles.Normalize(v));
                }
                Num("depth", Lang.T("Tiefe"), 0.5, 5000, v => s.Depth = v);
                Num("height", Lang.T("Höhe"), 0.5, 2000, v => s.Height = v);
                var color = F("color");
                apply.Add(() => s.Color = ModelBody.ParseColor(color) is { } c ? ModelBody.ToHex(c) : null);
                break;
            case SceneryKind.Building:
                Num("width", Lang.T("Breite"), 5, 5000, v => s.Width = v);
                Num("depth", Lang.T("Tiefe"), 5, 5000, v => s.Depth = v);
                Num("height", Lang.T("Höhe"), 5, 2000, v => s.Height = v);
                Num("rotation", Lang.T("Drehung"), -360, 360, v => s.Rotation = Angles.Normalize(v));
                break;
            case SceneryKind.Tree:
                Num("width", Lang.T("Durchmesser"), 3, 1000, v => { s.Width = v; s.Depth = v; });
                Num("height", Lang.T("Höhe"), 5, 2000, v => s.Height = v);
                break;
            case SceneryKind.Room:
                Num("width", Lang.T("Wandstärke"), 0, 1000, v => s.Width = v);
                break;
            case SceneryKind.Obstacle:
                Num("width", Lang.T("Breite"), 5, 20000, v => s.Width = v);
                Num("depth", Lang.T("Tiefe"), 5, 20000, v => s.Depth = v);
                Num("height", Lang.T("Höhe"), 0, 5000, v => s.Height = v);
                Num("rotation", Lang.T("Drehung"), -360, 360, v => s.Rotation = Angles.Normalize(v));
                if (int.TryParse(F("variant"), out var variant) && Enum.IsDefined((ObstacleType)variant)) apply.Add(() => s.Variant = variant);
                break;
            case SceneryKind.Power:
                Num("rotation", Lang.T("Drehung"), -360, 360, v => s.Rotation = Angles.Normalize(v));
                if (PowerSupply.Type(s) != PowerSourceType.Baustein && int.TryParse(F("variant"), out var ptype) && Enum.IsDefined((PowerSourceType)ptype) && (PowerSourceType)ptype != PowerSourceType.Baustein)
                    apply.Add(() => PowerSupply.ApplyType(s, (PowerSourceType)ptype, Plan.Gauge, Session.DistributorColor));
                if (PowerSupply.Type(s) == PowerSourceType.Baustein && Decoders.ModelOf(s) is { Addresses: > 0 })
                {
                    double ma = 0;
                    if (F("maddr").Trim().Length > 0) Read("maddr", Lang.T("Startadresse"), 1, 4096, errors, out ma);
                    int? maddr = ma >= 1 ? (int)Math.Round(ma) : null;
                    apply.Add(() => s.Address = maddr);
                }
                if (PowerSupply.DistributorColors.Any(c => c.Hex == F("color"))) { var dcol = F("color"); apply.Add(() => { if (PowerSupply.Type(s) == PowerSourceType.Verteiler) s.Color = dcol; }); }
                break;
        }
        if (Fail(errors)) return;
        var n = F("name").Trim();
        if (s.IsPower && n != s.Name && PowerSupply.Items(Plan).Any(x => x.Id != s.Id && x.Name == n))
        {
            Fail([Lang.F($"Es gibt schon eine Stromquelle „{n}“.")]);
            return;
        }
        Session.Edit(() =>
        {
            // Gleisanschlüsse hängen über den Namen an der Quelle und wandern beim Umbenennen mit
            if (s.IsPower && n.Length > 0 && n != s.Name)
                foreach (var fd in Plan.Feeders.Where(x => x.Circuit == s.Name)) fd.Circuit = n;
            if (n.Length > 0) s.Name = n;
            foreach (var a in apply) a();
        });
    }

    private RenderFragment NumField(string label, string key, Action apply) => __builder =>
    {
        <div><label class="field-label">@label</label><input class="input" inputmode="decimal" value="@F(key)" @onchange="e => Set(key, e, apply)" /></div>
    };

    private RenderFragment SceneryForm(SceneryItem s) => __builder =>
    {
        <label class="field-label">@(s.Kind == SceneryKind.Label ? "Text" : Lang.T("Name"))</label>
        <input class="input" value="@F("name")" @onchange="@(e => Set("name", e, ApplyScenery))" />
        @switch (s.Kind)
        {
            case SceneryKind.Label:
                <div class="cols">@NumField(Lang.T("Schrifthöhe (mm)"), "height", ApplyScenery)@NumField(Lang.T("Drehung (°)"), "rotation", ApplyScenery)</div>
                break;
            case SceneryKind.Dimension when s.Points.Count == 2:
                <div class="cols">@NumField(Lang.T("Abstand (mm)"), "width", ApplyScenery)@NumField(Lang.T("Schrifthöhe (mm)"), "height", ApplyScenery)</div>
                <dl class="rows"><dt>@Lang.T("Länge")</dt><dd>@Fmt.Num(Annotation.Dimension(s, s.Height).Length, 1) mm</dd></dl>
                break;
            case SceneryKind.Beam when s.Points.Count == 2:
                <div class="cols">@NumField(Lang.T("Breite (mm)"), "width", ApplyScenery)@NumField(Lang.T("Höhe der Latte (mm)"), "depth", ApplyScenery)</div>
                <div class="cols">@NumField(Lang.T("Länge (mm)"), "length", ApplyScenery)@NumField(Lang.T("Oberkante (mm)"), "height", ApplyScenery)</div>
                <dl class="rows"><dt>@Lang.T("Winkel")</dt><dd>@Fmt.Num(BeamLayout.Angle(s), 1)°</dd></dl>
                <div class="tip-box">@Lang.T("Oberkante über der Plattenoberkante: negativ = unter der Platte. Mit Unterbau steht die Leiste in Zuschnitt und Materialliste.")</div>
                break;
            case SceneryKind.Wire:
                var current = Electrics.Current(Plan);
                var wireHex = WireLayout.ColorOf(s, current);
                <label class="field-label">@Lang.T("Verwendung")</label>
                <select class="input" value="@((int)WireLayout.Use(s))" @onchange="@(e => { if (int.TryParse(e.Value as string, out var u) && Enum.IsDefined((WireUse)u)) Session.SetWireUse(s.Id, (WireUse)u); })">
                    @foreach (var u in Enum.GetValues<WireUse>())
                    {
                        <option value="@((int)u)">@WireLayout.UseName(u)</option>
                    }
                </select>
                <div class="cols">
                    <div>
                        <label class="field-label">@Lang.T("Aderfarbe")</label>
                        <select class="input" value="@wireHex" @onchange="@(e => Set("color", e, ApplyScenery))">
                            @foreach (var c in WireLayout.Colors)
                            {
                                <option value="@c.Hex">@Lang.T(c.Name)</option>
                            }
                            @if (!WireLayout.Colors.Any(c => string.Equals(c.Hex, wireHex, StringComparison.OrdinalIgnoreCase)))
                            {
                                <option value="@wireHex">@wireHex</option>
                            }
                        </select>
                    </div>
                    @NumField(Lang.T("Querschnitt (mm²)"), "depth", ApplyScenery)
                </div>
                <dl class="rows">
                    <dt>@Lang.T("Länge")</dt><dd>@Fmt.Num(WireLayout.Length(s) / 1000, 2) m</dd>
                    <dt>@Lang.T("Mit Zugabe")</dt><dd>@Fmt.Num(WireLayout.Length(s) * (1 + WireLayout.Reserve) / 1000, 2) m</dd>
                    <dt>@Lang.T("Anfang")</dt><dd>@(WireLayout.EndAnchor(Plan, s, false)?.Text ?? Lang.T("frei"))</dd>
                    <dt>@Lang.T("Ende")</dt><dd>@(WireLayout.EndAnchor(Plan, s, true)?.Text ?? Lang.T("frei"))</dd>
                    <dt>@Lang.T("Punkte")</dt><dd>@s.Points.Count</dd>
                </dl>
                <div class="tip-box">@Electrics.CurrentHint(Plan)</div>
                break;
            case SceneryKind.Power when PowerSupply.Type(s) == PowerSourceType.Baustein:
                var dm = Decoders.ModelOf(s);
                <div class="title">@(dm is null ? s.Model : $"{dm.Maker} {dm.Id}")</div>
                <div class="secondary">@dm?.Name</div>
                @if (dm is { Addresses: > 0 })
                {
                    <label class="field-label">@(dm.Role == ModuleRole.Melden ? Lang.T("Erster Rückmeldekontakt") : Lang.T("Startadresse"))</label>
                    <input class="input" inputmode="numeric" value="@F("maddr")" @onchange="@(e => Set("maddr", e, ApplyScenery))" />
                }
                <div class="cols">@NumField(Lang.T("Drehung (°)"), "rotation", ApplyScenery)</div>
                <dl class="rows">
                    @if (dm is not null)
                    {
                        <dt>@(dm.Role == ModuleRole.Melden ? Lang.T("Melder-Eingänge") : Lang.T("Ausgänge"))</dt><dd>@dm.Outputs</dd>
                        @if (Decoders.Range(s) is { } mr)
                        {
                            <dt>@(dm.Role == ModuleRole.Melden ? Lang.T("Kontakte") : Lang.T("Adressen"))</dt><dd>@($"{mr.First}–{mr.Last}")</dd>
                        }
                        <dt>@Lang.T("Bus")</dt><dd>@dm.Bus</dd>
                    }
                    <dt>@Lang.T("Kabel")</dt><dd>@Decoders.Ports(s).SelectMany(c => WireLayout.WiresAt(Plan, c)).DistinctBy(w => w.Id).Count()</dd>
                </dl>
                @if (dm is { Addresses: > 0 })
                {
                    var assigned = Decoders.Assigned(Plan, s);
                    <div class="section">@(dm.Role == ModuleRole.Melden ? Lang.T("Angeschlossene Rückmelder") : Lang.T("Angeschlossene Weichen und Signale"))</div>
                    @if (assigned.Count == 0)
                    {
                        <div class="secondary small">@(dm.Role == ModuleRole.Melden ? Lang.T("Noch kein Rückmelder mit einem Kontakt in diesem Bereich.") : Lang.T("Noch keine Weiche und kein Signal mit einer Adresse in diesem Bereich (Elektrik › Adressen)."))</div>
                    }
                    <dl class="rows">
                        @foreach (var a in assigned)
                        {
                            <dt>@(dm.Role == ModuleRole.Melden ? Lang.F($"Melder {a.Port}") : Lang.F($"Ausgang {a.Port}"))</dt><dd>@($"{a.Label} ({a.Address})")</dd>
                        }
                    </dl>
                }
                <div class="tip-box">@dm?.Description @Lang.T("Kabel rasten an den gelben Klemmen unten ein.")</div>
                break;
            case SceneryKind.Power:
                var ptype = PowerSupply.Type(s);
                var attached = PowerSupply.FeedersOf(Plan, s).ToList();
                <label class="field-label">@Lang.T("Art")</label>
                <select class="input" value="@F("variant")" @onchange="@(e => Set("variant", e, ApplyScenery))">
                    @foreach (var t in Enum.GetValues<PowerSourceType>().Where(t => t != PowerSourceType.Baustein))
                    {
                        <option value="@((int)t)">@PowerSupply.TypeName(t)</option>
                    }
                </select>
                @if (ptype == PowerSourceType.Verteiler)
                {
                    <label class="field-label">@Lang.T("Farbe")</label>
                    <select class="input" value="@F("color")" @onchange="@(e => Set("color", e, ApplyScenery))">
                        @foreach (var c in PowerSupply.DistributorColors)
                        {
                            <option value="@c.Hex">@Lang.T(c.Name)</option>
                        }
                    </select>
                }
                <div class="cols">@NumField(Lang.T("Drehung (°)"), "rotation", ApplyScenery)</div>
                <dl class="rows">
                    @if (ptype == PowerSourceType.Verteiler)
                    {
                        <dt>@Lang.T("Klemmen")</dt><dd>@PowerSupply.Clamps</dd>
                        <dt>@Lang.T("Kabel")</dt><dd>@PowerSupply.ClampPoints(s).SelectMany(c => WireLayout.WiresAt(Plan, c)).DistinctBy(w => w.Id).Count()</dd>
                    }
                    else
                    {
                        <dt>@Lang.T("Betrieb")</dt><dd>@PowerSupply.ModeName(Plan.Operation)</dd>
                    }
                    @if (Decoders.ModelOf(s) is { } pm)
                    {
                        <dt>@Lang.T("Gerät")</dt><dd>@($"{pm.Maker} {pm.Title}")</dd>
                    }
                    @if (PowerSupply.GroundTerminal(s) is { } gt)
                    {
                        var grounded = WireLayout.WiresAt(Plan, gt).Any();
                        <dt>@Lang.T("Masse (0)")</dt><dd class="@(grounded ? "" : "error-text")">@(grounded ? Lang.T("angeschlossen") : Lang.T("fehlt"))</dd>
                    }
                    @if (PowerSupply.FeedsTrack(ptype))
                    {
                        <dt>@Lang.T("Gleisanschlüsse")</dt><dd>@attached.Count</dd>
                        var sections = Electrics.Sections(Plan, Session.Connections).Where(x => x.Feeders.Any(fd => fd.Circuit == s.Name)).ToList();
                        <dt>@Lang.T("Stromabschnitte")</dt><dd>@(sections.Count == 0 ? "–" : string.Join(", ", sections.Select(x => x.Number)))</dd>
                        <dt>@Lang.T("Gleislänge")</dt><dd>@Fmt.Num(sections.Sum(x => x.LengthMm) / 1000, 2) m</dd>
                    }
                </dl>
                @if (PowerSupply.FeedsTrack(ptype) && !PowerSupply.Fits(ptype, Plan.Operation))
                {
                    <div class="error-box">@(Plan.Operation == PowerMode.Analog ? Lang.T("Passt nicht zum Analogbetrieb.") : Lang.T("Passt nicht zum Digitalbetrieb."))</div>
                }
                <div class="tip-box">@PowerSupply.Description(ptype) @(ptype == PowerSourceType.Verteiler ? "" : PowerSupply.HasGround(ptype)
                    ? Lang.T("Die rote Linie führt vom Bahnstrom (B) zu den Gleisanschlüssen. Die Masse (0) daneben mit einem braunen Kabel zum Gleis oder zu einem Masse-Verteiler legen.")
                    : Lang.T("Gleisanschlüsse hängen über den Namen daran (gestrichelte Linie); Kabel rasten an der Klemme unten ein."))</div>
                break;
            case SceneryKind.Plate:
                <div class="cols">@NumField(Lang.T("Links (mm)"), "x", ApplyScenery)@NumField(Lang.T("Oben (mm)"), "y", ApplyScenery)</div>
                <div class="cols">@NumField(Lang.T("Breite (mm)"), "width", ApplyScenery)@NumField(Lang.T("Tiefe (mm)"), "depth", ApplyScenery)</div>
                <div class="cols">@NumField(Lang.T("Stärke (mm)"), "thick", ApplyScenery)@NumField(Lang.T("Oberkante (mm)"), "height", ApplyScenery)</div>
                <dl class="rows"><dt>@Lang.T("Fläche")</dt><dd>@Fmt.Num(s.Width * s.Depth / 1e6, 2) m²</dd></dl>
                <div class="button-row"><button class="btn" title="@Lang.T("Legt die Platte wieder genau über die gezeichneten Leisten bzw. den Rahmen.")" @onclick="@(() => Session.FitPlate(s))">@((MarkupString)Icons.Svg("Resize", 16)) @Lang.T("An Rahmen anpassen")</button></div>
                <div class="tip-box">@Lang.T("Links und Oben: linke obere Ecke im Plan. Oberkante über der Plattenoberkante des Plans (0 = Gleisebene). Mit Unterbau steht die Platte in der Materialliste.")</div>
                break;
            case SceneryKind.Terrain:
                <div class="cols">@NumField(Lang.T("Höhe (mm)"), "height", ApplyScenery)</div>
                <dl class="rows">
                    <dt>@Lang.T("Eckpunkte")</dt><dd>@s.Points.Count</dd>
                    <dt>@Lang.T("Fläche")</dt><dd>@Fmt.Num(Math.Abs(Geometry2D.SignedArea(s.Points)) / 1e6, 2) m²</dd>
                </dl>
                break;
            case SceneryKind.Water:
                <div class="cols">@NumField(Lang.T("Tiefe (mm)"), "height", ApplyScenery)</div>
                <dl class="rows"><dt>@Lang.T("Fläche")</dt><dd>@Fmt.Num(Math.Abs(Geometry2D.SignedArea(s.Points)) / 1e6, 2) m²</dd></dl>
                break;
            case SceneryKind.Building when ModelLibrary.Of(Session.Plan, s) is { } model:
                var (heightLabel, trackHeight) = ModelPlacement.HeightInfo(Session.Plan, model, s);
                if (s.Points.Count >= 2)
                {
                    <div class="cols">@NumField(Lang.T("Tiefe (mm)"), "depth", ApplyScenery)@NumField(heightLabel, "height", ApplyScenery)</div>
                    <dl class="rows"><dt>@Lang.T("Länge entlang des Gleises")</dt><dd>@Fmt.Num(PlacedModel.PathLength(s.Points), 0) mm</dd></dl>
                }
                else
                {
                    <div class="cols">@NumField(Lang.T("Länge (mm)"), "width", ApplyScenery)@NumField(Lang.T("Tiefe (mm)"), "depth", ApplyScenery)</div>
                    <div class="cols">@NumField(heightLabel, "height", ApplyScenery)@NumField(Lang.T("Drehung (°)"), "rotation", ApplyScenery)</div>
                }
                @if (trackHeight is not null)
                {
                    <dl class="rows"><dt>@Lang.T("Gleishöhe")</dt><dd>@trackHeight</dd></dl>
                }
                <label class="field-label">@Lang.F($"Hauptfarbe ({ModelBody.MaterialName(model.EffectiveMainMaterial)})")</label>
                <select class="input" value="@F("color")" @onchange="@(e => Set("color", e, ApplyScenery))">
                    @foreach (var (cname, hex) in ModelLibrary.MainColors)
                    {
                        <option value="@(hex ?? "")">@cname</option>
                    }
                    @if (!string.IsNullOrEmpty(s.Color) && !ModelLibrary.MainColors.Any(c => string.Equals(c.Hex, s.Color, StringComparison.OrdinalIgnoreCase)))
                    {
                        <option value="@s.Color">@s.Color</option>
                    }
                </select>
                <dl class="rows">
                    <dt>@Lang.T("Modell")</dt><dd>@model.Name</dd>
                    <dt>@Lang.T("Vorbild")</dt><dd>@Lang.F($"{Fmt.Num(model.Size.W, 1)} × {Fmt.Num(model.Size.D, 1)} × {Fmt.Num(model.Size.H, 1)} m")</dd>
                    <dt>@Lang.T("Maßstab")</dt><dd>@Session.Plan.Gauge.Scale</dd>
                </dl>
                <div class="button-row"><button class="btn" @onclick="@(() => Session.ResetModelSize(s.Id))">@((MarkupString)Icons.Svg("Resize", 16)) @Lang.T("Originalgröße")</button>
                    <button class="btn" title="@(model.IsBuiltin ? Lang.T("Pro: öffnet eine Kopie des Grundmodells im Modell-Editor; dieses Objekt bekommt danach die eigene Fassung.") : Lang.T("Pro: öffnet das Modell im Modell-Editor; Änderungen gelten für alle Objekte mit diesem Modell."))" @onclick="@(() => Run("modelEditSelected"))">@((MarkupString)Icons.Svg("Palette", 16)) @Lang.T("Modell bearbeiten")</button>
                    @if (model.Snap == ModelSnap.Neben)
                    {
                        <button class="btn" title="@Lang.T("Setzt das Modell auf die andere Seite des Gleises.")" @onclick="@(() => Session.FlipModelSide(s.Id))">@((MarkupString)Icons.Svg("Mirror", 16)) @Lang.T("Seite wechseln")</button>
                        <button class="btn" title="@Lang.T("Setzt dasselbe Modell zusätzlich auf die andere Seite des Gleises.")" @onclick="@(() => Session.AddModelOtherSide(s.Id))">@((MarkupString)Icons.Svg("Copy", 16)) @Lang.T("Beidseitig")</button>
                    }</div>
                @if (!string.IsNullOrWhiteSpace(model.Description))
                {
                    <div class="tip-box">@model.Description</div>
                }
                break;
            case SceneryKind.Building:
                <div class="cols">@NumField(Lang.T("Breite (mm)"), "width", ApplyScenery)@NumField(Lang.T("Tiefe (mm)"), "depth", ApplyScenery)</div>
                <div class="cols">@NumField(Lang.T("Höhe (mm)"), "height", ApplyScenery)@NumField(Lang.T("Drehung (°)"), "rotation", ApplyScenery)</div>
                break;
            case SceneryKind.Tree:
                <div class="cols">@NumField(Lang.T("Durchmesser (mm)"), "width", ApplyScenery)@NumField(Lang.T("Höhe (mm)"), "height", ApplyScenery)</div>
                break;
            case SceneryKind.Room:
                <div class="cols">@NumField(Lang.T("Wandstärke (mm)"), "width", ApplyScenery)</div>
                <dl class="rows">
                    <dt>@Lang.T("Eckpunkte")</dt><dd>@s.Points.Count</dd>
                    <dt>@Lang.T("Grundfläche")</dt><dd>@Fmt.Num(Math.Abs(Geometry2D.SignedArea(s.Points)) / 1e6, 2) m²</dd>
                </dl>
                break;
            case SceneryKind.Obstacle:
                <label class="field-label">@Lang.T("Art")</label>
                <select class="input" value="@F("variant")" @onchange="@(e => Set("variant", e, ApplyScenery))">
                    @foreach (var t in Enum.GetValues<ObstacleType>())
                    {
                        <option value="@((int)t)">@SceneryItem.ObstacleName(t)</option>
                    }
                </select>
                <div class="cols">@NumField(Lang.T("Breite (mm)"), "width", ApplyScenery)@NumField(Lang.T("Tiefe (mm)"), "depth", ApplyScenery)</div>
                <div class="cols">@NumField(Lang.T("Höhe (mm)"), "height", ApplyScenery)@NumField(Lang.T("Drehung (°)"), "rotation", ApplyScenery)</div>
                @if (s.Obstacle == ObstacleType.Tuer)
                {
                    <div class="tip-box">@Lang.T("Die Tür ist oben links angeschlagen und schlägt nach unten auf; die Tiefe ist der Schwenkbereich. Mit der Drehung (90°, 180°, 270°) an die Wand anpassen.")</div>
                }
                break;
        }
        <div class="button-row"><button class="btn" @onclick="@(() => Run("delete"))">@((MarkupString)Icons.Svg("Delete", 16)) @Lang.T("Löschen")</button></div>
        <div class="tip-box">@Lang.T("Ein gewähltes Objekt lässt sich mit der Maus (oder dem Finger) und mit den Pfeiltasten verschieben (1 mm, mit Umschalt 10 mm).")</div>
    };

    private void ApplyFeeder()
    {
        if (_target is not Feeder f) return;
        var t = F("circuit").Trim();
        if (t == "+") t = Session.NewCircuitName();
        if (t.Length > 0 && t != f.Circuit) Session.SetFeederCircuit(f.Id, t);
    }

    private RenderFragment FeederForm(Feeder f) => __builder =>
    {
        var circuits = Session.CircuitNames.Append(f.Circuit).Distinct().ToList();
        var section = Electrics.Sections(Plan, Session.Connections).FirstOrDefault(x => x.PieceIds.Contains(f.PieceId));
        var source = PowerSupply.SourceOf(Plan, f);
        <label class="field-label">@(Plan.Operation == PowerMode.Analog ? Lang.T("Hängt an (Trafo)") : Lang.T("Hängt an (Zentrale / Booster)"))</label>
        <select class="input" value="@f.Circuit" @onchange="@(e => Set("circuit", e, ApplyFeeder))">
            @foreach (var c in circuits)
            {
                <option value="@c">@c</option>
            }
            <option value="+">@(Plan.Operation == PowerMode.Analog ? Lang.F($"+ weiterer Trafo ({Session.NewCircuitName()})") : Lang.F($"+ neuer Booster ({Session.NewCircuitName()})"))</option>
        </select>
        @if (source is null)
        {
            <div class="error-box">@Lang.F($"Für „{f.Circuit}“ steht noch keine Zentrale bzw. kein Trafo im Plan.")</div>
        }
        <dl class="rows">
            <dt>@Lang.T("Gleis")</dt><dd>@Plan.Find(f.PieceId)?.Def.Number (Nr. @f.PieceId)</dd>
            <dt>@Lang.T("Stromabschnitt")</dt><dd>@(section is null ? "–" : $"{section.Number} · {Fmt.Num(section.LengthMm / 1000, 2)} m")</dd>
            <dt>@Lang.T("Stromart")</dt><dd>@Electrics.CurrentName(Electrics.Current(Plan))</dd>
        </dl>
        @if (Electrics.Current(Plan) == CurrentKind.Gleichstrom)
        {
            <label class="check"><input type="checkbox" checked="@f.Reversed" @onchange="@(_ => Session.ToggleFeederPolarity(f.Id))" /> @Lang.T("Polung getauscht (Plus und Minus vertauscht)")</label>
        }
        <div class="button-row"><button class="btn" @onclick="@(() => Run("delete"))">@((MarkupString)Icons.Svg("Delete", 16)) @Lang.T("Löschen")</button></div>
    };

    private RenderFragment IsolationForm(Isolation i) => __builder =>
    {
        <dl class="rows">
            <dt>@Lang.T("Gleis")</dt><dd>@Plan.Find(i.PieceId)?.Def.Number (Nr. @i.PieceId)</dd>
            <dt>@Lang.T("Gleisende")</dt><dd>@i.Index</dd>
            <dt>@Lang.T("Ausführung")</dt><dd>@(Electrics.IsThreeRail(Plan) ? Lang.T("Mittelleiter getrennt") : Lang.T("beide Schienen isoliert"))</dd>
        </dl>
        <div class="button-row"><button class="btn" @onclick="@(() => Run("delete"))">@((MarkupString)Icons.Svg("Delete", 16)) @Lang.T("Löschen")</button></div>
    };

    private void ApplyDetector()
    {
        if (_target is not Detector det) return;
        var errors = new List<string>();
        double a = 0;
        if (F("address").Trim().Length > 0) Read("address", Lang.T("Kontakt"), 0, 4096, errors, out a);
        if (Fail(errors)) return;
        var t = Enum.TryParse<DetectorType>(F("type"), out var tt) ? tt : det.Type;
        var n = F("name").Trim();
        int? addr = a >= 1 ? (int)Math.Round(a) : null;
        if (n != det.Name || t != det.Type || addr != det.Address) Session.Edit(() => { det.Name = n; det.Type = t; det.Address = addr; });
    }

    private RenderFragment DetectorForm(Detector det) => __builder =>
    {
        <label class="field-label">@Lang.T("Name")</label>
        <input class="input" value="@F("name")" @onchange="@(e => Set("name", e, ApplyDetector))" />
        <label class="field-label">@Lang.T("Art")</label>
        <select class="input" value="@F("type")" @onchange="@(e => Set("type", e, ApplyDetector))">
            @foreach (var t in Enum.GetValues<DetectorType>())
            {
                <option value="@t">@Detector.TypeName(t)</option>
            }
        </select>
        <label class="field-label">@Lang.T("Kontakt am Rückmeldemodul (leer = keiner)")</label>
        <input class="input" inputmode="numeric" value="@F("address")" @onchange="@(e => Set("address", e, ApplyDetector))" />
        <dl class="rows">
            @if (det.Address is { } a)
            {
                <dt>@Lang.T("Modul / Eingang")</dt><dd>@Lang.F($"{(a - 1) / Detector.InputsPerModule + 1} / {(a - 1) % Detector.InputsPerModule + 1}")</dd>
            }
            <dt>@Lang.T("Gleis")</dt><dd>@Plan.Find(det.PieceId)?.Def.Number (Nr. @det.PieceId)</dd>
            @if (UsableLength.For(Plan, det.PieceId, Session.Connections) is { } run)
            {
                <dt>@Lang.T("Meldeabschnitt")</dt><dd>@Fmt.Num(run.Length, 0) mm</dd>
            }
        </dl>
        <div class="button-row"><button class="btn" @onclick="@(() => Run("delete"))">@((MarkupString)Icons.Svg("Delete", 16)) @Lang.T("Löschen")</button></div>
    };

    private void ApplySignal()
    {
        if (_target is not Signal g) return;
        var errors = new List<string>();
        double a = 0;
        if (F("address").Trim().Length > 0) Read("address", Lang.T("Adresse"), 0, 2048, errors, out a);
        if (Fail(errors)) return;
        var t = Enum.TryParse<SignalType>(F("type"), out var tt) ? tt : g.Type;
        var sy = Enum.TryParse<SignalSystem>(F("system"), out var ss) ? ss : g.System;
        var n = F("name").Trim();
        int? addr = a >= 1 ? (int)Math.Round(a) : null;
        if (n != g.Name || t != g.Type || sy != g.System || addr != g.Address) Session.Edit(() => { g.Name = n; g.Type = t; g.System = sy; g.Address = addr; });
    }

    private RenderFragment SignalForm(Signal g) => __builder =>
    {
        var face = SignalFace.For(g);
        <label class="field-label">@Lang.T("Name")</label>
        <input class="input" value="@F("name")" @onchange="@(e => Set("name", e, ApplySignal))" />
        <label class="field-label">@Lang.T("Art")</label>
        <select class="input" value="@F("type")" @onchange="@(e => Set("type", e, ApplySignal))">
            @foreach (var t in Enum.GetValues<SignalType>())
            {
                <option value="@t">@Signal.TypeName(t)</option>
            }
        </select>
        <label class="field-label">@Lang.T("Signalsystem")</label>
        <select class="input" value="@F("system")" @onchange="@(e => Set("system", e, ApplySignal))">
            @foreach (var sy in Enum.GetValues<SignalSystem>())
            {
                <option value="@sy">@Signal.SystemName(sy)</option>
            }
        </select>
        <div class="signal-row">
            <span class="signal-pic">@((MarkupString)Pictures.Signal(g.Type, system: g.System))</span>
            <span class="secondary">@face.Aspect. @face.Description</span>
        </div>
        <label class="field-label">@Lang.T("Adresse (leer = keine)")</label>
        <input class="input" inputmode="numeric" value="@F("address")" @onchange="@(e => Set("address", e, ApplySignal))" />
        <dl class="rows">
            <dt>@Lang.T("Belegt Adressen")</dt><dd>@g.AddressCount</dd>
            <dt>@Lang.T("Gleis")</dt><dd>@Lang.F($"{Plan.Find(g.PieceId)?.Def.Number} (Nr. {g.PieceId}), Ende {g.Index}")</dd>
        </dl>
        <div class="button-row"><button class="btn" @onclick="@(() => Run("delete"))">@((MarkupString)Icons.Svg("Delete", 16)) @Lang.T("Löschen")</button></div>
    };
}
