<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>TrackMaster.Web</RootNamespace>
    <AssemblyName>TrackMaster.Web</AssemblyName>
    <!-- Zeichenbefehle gehen ohne Kopie als Speicheransicht an JavaScript -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Deutsche und englische Zahlenschreibweise unabhängig von der Browsersprache -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    <!-- Plan- und Lizenzdateien werden per Reflexion gelesen; Kern und Lizenz werden nicht gekürzt -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- Ohne Service Worker: ein neues Paket auf dem Server gilt sofort -->
    <ServiceWorkerAssetsManifest></ServiceWorkerAssetsManifest>
    <!-- Keine Debug-Symbole im Paket für den Webserver -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.*" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TrackMaster.Core\TrackMaster.Core.csproj" />
    <ProjectReference Include="..\TrackMaster.Licensing\TrackMaster.Licensing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <TrimmerRootAssembly Include="TrackMaster.Core" />
    <TrimmerRootAssembly Include="TrackMaster.Licensing" />
  </ItemGroup>
</Project>
